---
import { Image } from 'astro:assets'
import mindsetIcon from '@/assets/okrs/figure1.png'
import growthIcon from '@/assets/okrs/figure2.png'
import { getLang, useTranslations } from '@/i18n/utils'

const lang = getLang(Astro.url)
const t = useTranslations(lang, 'valuable')
---

<section id="why-oakrs" class="relative overflow-hidden bg-gradient-to-b from-white via-mist-100 to-mist-200 pt-16 pb-0">
  <div class="mx-auto max-w-[1512px] px-6 lg:px-16">
    <h2 id="valuable-headline" class="max-w-[666px] font-heading text-3xl font-bold text-dark sm:text-[48px] sm:leading-[1.3]">
      {t.headlineStart} <span class="text-primary">{t.headlineAccent}</span> {t.headlineEnd}
    </h2>

    <div class="mt-8 flex justify-end pb-20 -mr-6 lg:-mr-16">
      <div id="valuable-pill" class="w-full max-w-[900px] rounded-l-[120px] rounded-r-none bg-white/60 py-8 pr-6 pl-20 shadow-sm lg:pr-16">
        <div class="flex flex-col gap-6">
          <div class="valuable-row flex items-center gap-6">
            <Image src={mindsetIcon} alt="" class="h-16 w-16 shrink-0" />
            <p class="font-body text-dark/80">
              {t.row1} <strong class="font-bold">{t.row1Strong}</strong>.
            </p>
          </div>
          <div class="valuable-row flex items-center gap-6">
            <Image src={growthIcon} alt="" class="h-16 w-16 shrink-0" />
            <p class="font-body text-dark/80">
              {t.row2Start} <strong class="font-bold text-primary">{t.row2Accent}</strong> {t.row2Middle}
              <strong class="font-bold">{t.row2Strong}</strong>.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
import { registerMotion, revealClip, splitHeadline, staggerGrid } from '@/lib/motion'

registerMotion(() => {
  const headline = document.getElementById('valuable-headline')
  const pill = document.getElementById('valuable-pill')
  const rows = document.querySelectorAll('#valuable-pill .valuable-row')

  if (headline) splitHeadline(headline, { by: 'lines' })
  if (pill) revealClip(pill, { direction: 'right' })
  staggerGrid(rows, { variant: 'organic' })
})
</script>
