---
import { Icon } from 'astro-icon/components'
import { getImage, Image } from 'astro:assets'
import growthPoster from '@/assets/video/growth-planning-cover-editorial.png'
import growthVideo from '@/assets/video/Growth_Planning_Brainstorming_1080p_final.mp4?url'
import stanleyLogo from '@/assets/clientes/customer-stanley.webp'
import grinLogo from '@/assets/roast/roast-gris.webp'
import { newProjectLogos } from '@/data/new-projects'

const poster = await getImage({ src: growthPoster, width: 1280, format: 'webp', quality: 85 })
const clients = [
  { logo: newProjectLogos.nordic, name: 'Nordic International School' },
  { logo: newProjectLogos.senati, name: 'SENATI' },
  { logo: newProjectLogos.pastipan, name: 'Pastipan' },
  { logo: grinLogo, name: 'Grin', full: true },
  { logo: stanleyLogo, name: 'Stanley Black & Decker' },
]
---

<section id="roas" class="bg-dark text-white">
  <div class="mx-auto max-w-[1512px] px-6 py-20 lg:px-24 lg:py-24">
    <!-- Bloque superior: texto + video -->
    <div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-16">
      <div>
        <h2 class="font-heading text-3xl font-bold leading-tight sm:text-4xl">
          Growth Planning: una estrategia para crecer
        </h2>
        <p class="mt-8 font-heading text-xl font-bold">
          Define tus prioridades y conviértelas en un plan de acción para tu negocio.
        </p>
        <a
          href="/soluciones/growth-planning"
          class="mt-8 inline-block rounded-[10px] bg-primary px-8 py-3 font-heading text-sm font-bold text-white transition-colors hover:bg-primary-600"
        >
          EXPLORAR GROWTH PLANNING
        </a>
      </div>

      <!-- Video con facade -->
      <div
        id="roas-video"
        class="group relative aspect-video w-full overflow-hidden rounded-3xl shadow-lg"
      >
        <video
          src={growthVideo}
          poster={poster.src}
          controls
          playsinline
          preload="none"
          aria-label="Growth Planning: una estrategia para crecer — Brainstorming"
          class="h-full w-full object-contain"
        >
          Tu navegador no permite reproducir este video.
          <a href={growthVideo}>Ver video de Growth Planning</a>
        </video>
          <button
            type="button"
            hidden
            aria-label="Reproducir video de Growth Planning"
            class="absolute inset-0 flex items-center justify-center bg-black/10 text-white/90 transition-colors hover:bg-black/20 focus-visible:outline-2 focus-visible:outline-offset-[-4px] focus-visible:outline-white"
          >
            <Icon name="play" class="h-20 w-20 drop-shadow-lg transition-transform group-hover:scale-110" />
          </button>
      </div>
    </div>

    <!-- Clientes -->
    <div
      id="roas-grid"
      class="mt-16 grid grid-cols-2 gap-x-6 gap-y-10 sm:grid-cols-3 lg:grid-cols-5"
    >
      {
        clients.map(r => (
          <div class="roas-item mx-auto flex aspect-square w-full max-w-[220px] items-center justify-center overflow-hidden rounded-full bg-[#f8f8fc]">
            <Image
              src={r.logo}
              alt={r.name}
              widths={[160, 220]}
              sizes="220px"
              quality={80}
              loading="lazy"
              class:list={['max-h-full w-full object-contain', r.full ? 'p-0' : 'p-6']}
            />

          </div>
        ))
      }
    </div>
  </div>
</section>



<script>
document.addEventListener('astro:page-load', () => {
  const holder = document.getElementById('roas-video')
  const player = holder?.querySelector('video')
  const play = holder?.querySelector('button')
  if (!player || !play || play.dataset.initialized)
    return
  play.dataset.initialized = 'true'
  player.controls = false
  play.hidden = false
  play.addEventListener('click', async () => {
    player.controls = true
    play.hidden = true
    try {
      await player.play()
      player.focus()
    }
    catch {
      player.controls = false
      play.hidden = false
    }
  })
})
</script>

<script>
import { registerMotion, revealCards, splitHeadline } from '@/lib/motion'

registerMotion(() => {
  const headline = document.querySelector<HTMLElement>('#roas h2')
  if (headline)
    splitHeadline(headline, { by: 'lines' })

  revealCards(document.querySelectorAll('#roas-grid .roas-item'), {
    trigger: document.getElementById('roas-grid'),
    intensity: 1.15,
    stagger: 0.1,
  })
})
</script>
