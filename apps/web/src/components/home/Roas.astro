---
import { Icon } from 'astro-icon/components'
import { getImage, Image } from 'astro:assets'
import stanleyLogo from '@/assets/clientes/customer-stanley.webp'
import grinLogo from '@/assets/roast/roast-gris.webp'
import growthPoster from '@/assets/video/growth-planning-cover-editorial.png'
import growthVideo from '@/assets/video/Growth_Planning_Brainstorming_1080p_final.mp4?url'
import { newProjectLogos } from '@/data/new-projects'

const poster = await getImage({ src: growthPoster, width: 1280, format: 'webp', quality: 85 })
const clients = [
  { logo: newProjectLogos.nordic, name: 'Nordic International School' },
  { logo: newProjectLogos.senati, name: 'SENATI' },
  { logo: newProjectLogos.pastipan, name: 'Pastipan' },
  { logo: grinLogo, name: 'Grin', full: true },
  { logo: stanleyLogo, name: 'Stanley Black & Decker' },
]
---

<section id="roas" class="bg-dark text-white">
  <div class="mx-auto max-w-[1512px] px-6 py-20 lg:px-24 lg:py-24">
    <!-- Bloque superior: texto + video -->
    <div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-16">
      <div>
        <h2 class="font-heading text-3xl font-bold leading-tight sm:text-4xl">
          Growth Planning: una estrategia para crecer
        </h2>
        <p class="roas-lead mt-8 font-heading text-xl font-bold">
          Define tus prioridades y conviértelas en un plan de acción para tu negocio.
        </p>
        <a
          href="/soluciones/growth-planning"
          class="roas-cta mt-8 inline-block rounded-[10px] bg-primary px-8 py-3 font-heading text-sm font-bold text-white transition-colors hover:bg-primary-600"
        >
          EXPLORAR GROWTH PLANNING
        </a>
      </div>

      <!-- Video con facade -->
      <div
        id="roas-video"
        class="group relative aspect-video w-full overflow-hidden rounded-3xl shadow-lg"
      >
        <video
          src={growthVideo}
          poster={poster.src}
          controls
          playsinline
          preload="none"
          aria-label="Growth Planning: una estrategia para crecer — Brainstorming"
          class="h-full w-full object-contain"
        >
          Tu navegador no permite reproducir este video.
          <a href={growthVideo}>Ver video de Growth Planning</a>
        </video>
          <button
            type="button"
            hidden
            aria-label="Reproducir video de Growth Planning"
            class="absolute inset-0 flex items-center justify-center bg-black/10 text-white/90 transition-colors hover:bg-black/20 focus-visible:outline-2 focus-visible:outline-offset-[-4px] focus-visible:outline-white"
          >
            <Icon name="play" class="h-20 w-20 drop-shadow-lg transition-transform group-hover:scale-110" />
          </button>
      </div>
    </div>

    <!-- Clientes -->
    <div
      id="roas-grid"
      class="mt-16 grid grid-cols-2 gap-x-6 gap-y-10 sm:grid-cols-3 lg:grid-cols-5"
    >
      {
        clients.map(r => (
          <div class="roas-item mx-auto flex aspect-square w-full max-w-[220px] items-center justify-center overflow-hidden rounded-full bg-[#f8f8fc]">
            <Image
              src={r.logo}
              alt={r.name}
              widths={[160, 220]}
              sizes="220px"
              quality={80}
              loading="lazy"
              class:list={['max-h-full w-full object-contain', r.full ? 'p-0' : 'p-6']}
            />

          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* Hover de los logos: un halo claro alrededor del círculo y el logo crece
     apenas. La elevación la hace GSAP (el círculo también anima su entrada). */
  .roas-item { transition: box-shadow 400ms ease-out; }
  .roas-item :global(img) { transition: transform 500ms cubic-bezier(.16,1,.3,1); }
  @media (hover: hover) and (pointer: fine) {
    .roas-item:hover { box-shadow: 0 0 0 8px rgb(255 255 255 / .08), 0 24px 48px -20px rgb(0 0 0 / .6); }
    .roas-item:hover :global(img) { transform: scale(1.06); }
  }
  @media (prefers-reduced-motion: reduce) {
    .roas-item, .roas-item :global(img) { transition: none; }
  }
</style>

<script>
document.addEventListener('astro:page-load', () => {
  const holder = document.getElementById('roas-video')
  const player = holder?.querySelector('video')
  const play = holder?.querySelector('button')
  if (!player || !play || play.dataset.initialized)
    return
  play.dataset.initialized = 'true'
  player.controls = false
  play.hidden = false
  play.addEventListener('click', async () => {
    player.controls = true
    play.hidden = true
    try {
      await player.play()
      player.focus()
    }
    catch {
      player.controls = false
      play.hidden = false
    }
  })
})
</script>

<script>
import { hoverLift, registerMotion, revealSequence, revealWindow, splitHeadline } from '@/lib/motion'
import { ease, tempo } from '@/lib/motion/config'
import { ensureGsap } from '@/lib/motion/gsap-client'

registerMotion(() => {
  const { gsap } = ensureGsap()
  const section = document.getElementById('roas')
  if (!section)
    return
  const media = gsap.matchMedia()
  const items = Array.from(section.querySelectorAll<HTMLElement>('.roas-item'))

  media.add('(prefers-reduced-motion: no-preference)', () => {
    const headline = section.querySelector<HTMLElement>('h2')
    if (headline)
      splitHeadline(headline, { by: 'lines' })

    // Titular → bajada → CTA: llegan cuando el titular ya se leyó. El CTA solo
    // con opacidad: tiene transition global de transform (feedback al presionar).
    const lead = section.querySelector('.roas-lead')
    const cta = section.querySelector('.roas-cta')
    if (lead && cta) {
      gsap.set(lead, { autoAlpha: 0, y: 16 })
      gsap.set(cta, { autoAlpha: 0 })
      gsap.timeline({ delay: 0.3 * tempo, scrollTrigger: { trigger: headline ?? section, start: 'top 85%', once: true } })
        .to(lead, { autoAlpha: 1, y: 0, duration: 0.8 * tempo, ease: ease.out, clearProps: 'opacity,visibility,transform' })
        .to(cta, { autoAlpha: 1, duration: 0.6 * tempo, ease: ease.out, clearProps: 'opacity,visibility' }, 0.15 * tempo)
    }

    // El video se abre como una ventana y la imagen se asienta dentro.
    const video = document.getElementById('roas-video')
    if (video)
      revealWindow(video, { direction: 'up', zoom: 1.08, mediaSelector: 'video' })

    // Logos: el círculo aparece y después su logo, en cascada.
    revealSequence(items, [
      { select: item => item, from: { autoAlpha: 0, scale: 0.9, y: 16 }, duration: 0.9 },
      { select: item => item.querySelector('img'), from: { autoAlpha: 0 }, at: 0.2, duration: 0.6 },
    ], { trigger: section.querySelector('#roas-grid'), stagger: 0.08 })
  })

  media.add('(hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)', () => {
    const cleanups = items.map(item => hoverLift(item, item, { y: -6 }))
    return () => cleanups.forEach(cleanup => cleanup())
  })
})
</script>
