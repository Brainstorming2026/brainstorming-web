---
import { Image } from 'astro:assets'
import { Icon } from 'astro-icon/components'
import campaign1 from '@/assets/projects/aruma/campaign.png'
import campaign2 from '@/assets/projects/aruma/campaign2.png'

const posts = [campaign1, campaign2]
---

<section class="bg-white pt-16 lg:pt-20">
  <div class="mx-auto grid max-w-[1512px] gap-8 px-6 lg:grid-cols-2 lg:items-start lg:px-24">
    <div>
      <div class="flex items-center gap-2 font-heading text-lg font-bold text-dark">
        <Icon name="expert-iman" class="h-7 w-7 text-dark-300" />
        <span>Inbound Marketing</span>
      </div>
      <h2 class="mt-4 max-w-[380px] font-heading text-3xl font-bold leading-tight text-dark sm:text-6xl">
        Campaña de Inbound Marketing para atraer clientes
      </h2>
    </div>
    <p class="text-[14px] leading-6 text-dark-500 lg:mt-1">
      Enfocamos la campaña en potenciar las emociones positivas de los usuarios respecto a su
      belleza personal y resaltando la diversión que acompaña el sentirte hermosa. Realizamos un
      registro audiovisual de productos y generamos acciones BTL. Manejamos sus redes sociales
      (Facebook e Instagram), diseñamos y publicamos los contenidos, invirtiendo tácticamente en
      pauta digital.
    </p>
  </div>

  <Icon
    name="aruma-up"
    class="block w-full h-auto md:h-[160px] -mb-px mt-16 text-[#7f1757]"
  />
</section>

<section class="bg-[#7f1757] pb-16 pt-8">
  <div class="mx-auto max-w-[1500px] px-6 lg:px-24">
    <div class="grid items-center gap-8 sm:grid-cols-2">
      {
        posts.map((post, i) => (
          <Image
            src={post}
            alt={`Publicación de campaña Aruma ${i + 1}`}
            class="mx-auto h-auto w-full max-w-[500px]"
            widths={[640, 1280]}
            sizes="(min-width: 640px) 640px, 90vw"
            loading="lazy"
          />
        ))
      }
    </div>
  </div>
</section>
