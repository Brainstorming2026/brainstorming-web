---
import { Image } from 'astro:assets'
import { Icon } from 'astro-icon/components'
import brandingBg from '@/assets/projects/latin-american/branding-bg.png'
import colorsImg from '@/assets/projects/latin-american/colors.png'
import identityImg from '@/assets/projects/latin-american/identity.png'
import renovationImg from '@/assets/projects/latin-american/renovation.png'

const lineas = [
  'Renovación de su Manual',
  'de Identidad de Marca y',
  'creación de Presentaciones',
  'de Alto Impacto',
]
---

<section id="branding-intro" class="relative overflow-hidden bg-dark py-16 lg:py-20">
  <Image
    id="branding-bg"
    src={brandingBg}
    alt=""
    class="pointer-events-none absolute inset-0 h-full w-full object-cover"
    loading="lazy"
    widths={[758, 1512]}
    sizes="100vw"
  />
  <div class="relative z-10 mx-auto max-w-[1512px] px-6 lg:px-24">
    <div class="grid gap-12 lg:grid-cols-2 lg:items-center">
      <div>
        <div id="branding-label" class="flex items-center gap-2 font-heading text-lg font-bold text-white">
          <Icon name="expert-huella" class="h-6 w-6 text-white/70" />
          <span>Branding</span>
        </div>

        <h2 id="branding-heading" class="mt-4 font-heading text-3xl font-bold leading-tight text-white sm:text-6xl">
          {
            lineas.map(linea => (
              <span class="heading-line relative block py-1 pl-4">
                {linea}
              </span>
            ))
          }
        </h2>
      </div>

      <div id="branding-hero-img-wrap" class="mx-auto h-auto w-full max-w-[560px] overflow-hidden">
        <Image
          src={renovationImg}
          alt="Presentaciones de Alto Impacto de Latin American Outdoors"
          class="branding-hero-img h-auto w-full"
          widths={[560, 1120]}
          sizes="(min-width: 1024px) 560px, 90vw"
          loading="lazy"
        />
      </div>
    </div>
  </div>
</section>

<div class="relative h-10 overflow-hidden sm:h-14 lg:h-20" aria-hidden="true">
  <Icon name="branding-up" class="absolute inset-x-0 top-0 h-auto w-full select-none" />
</div>

<section id="branding-detail" class="bg-white mb-16 lg:mb-20">
  <div class="mx-auto max-w-[1512px] px-6 lg:px-24">
    <div class="grid gap-10 lg:grid-cols-[1fr_auto_auto] lg:items-center">
      <p id="branding-desc" class="max-w-[440px] text-[14px] leading-6 text-dark-500">
        La empresa necesitaba reinventar su identidad y concepto de marca de la manera más
        adecuada para ganar más mercado y vender a más clientes. Con una paleta de colores más
        moderna y un estilo visual más sintetizado, potenciamos su identidad gráfica sin perder la
        esencia de marca. Sus presentaciones de alto impacto, esenciales en el negocio,
        necesitaban esa actualización.
      </p>

      <div id="branding-identity-wrap" class="h-auto w-full max-w-[570px] overflow-hidden">
        <Image
          src={identityImg}
          alt="Iconografía de elementos publicitarios de Latin American Outdoors"
          class="branding-identity-img h-auto w-full"
          loading="lazy"
        />
      </div>

      <Image
        id="branding-colors-img"
        src={colorsImg}
        alt="Paleta de colores de Latin American Outdoors"
        class="relative z-10 mx-auto h-auto w-auto max-h-[600px] lg:-mt-40"
        loading="lazy"
      />
    </div>
  </div>
</section>

<script>
import { ensureGsap, registerMotion, revealClip } from '@/lib/motion'
import { ease } from '@/lib/motion/config'
import { prefersReducedMotion } from '@/lib/motion/reduced-motion'

registerMotion(() => {
  const bg = document.getElementById('branding-bg')
  const label = document.getElementById('branding-label')
  const lines = document.querySelectorAll('#branding-heading .heading-line')
  const heroImgWrap = document.getElementById('branding-hero-img-wrap')
  const heroImg = document.querySelector<HTMLElement>('.branding-hero-img')
  const desc = document.getElementById('branding-desc')
  const identityWrap = document.getElementById('branding-identity-wrap')
  const colorsImg = document.getElementById('branding-colors-img')

  const { gsap } = ensureGsap()

  if (prefersReducedMotion()) {
    gsap.fromTo([label, ...lines, desc].filter(Boolean), { opacity: 0 }, { opacity: 1, duration: 0.4, stagger: 0.06 })
    return
  }

  if (bg) gsap.fromTo(bg, { scale: 1 }, { scale: 1.06, duration: 10, ease: 'none' })
  if (label) gsap.fromTo(label, { opacity: 0, y: 10 }, { opacity: 1, y: 0, duration: 0.5, ease: ease.out })
  if (lines.length > 0) {
    gsap.set(lines, { opacity: 0, y: '100%' })
    gsap.to(lines, { opacity: 1, y: '0%', duration: 1.0, ease: ease.out, stagger: 0.12, delay: 0.2 })
  }
  if (heroImgWrap) revealClip(heroImgWrap, { direction: 'up' })
  if (heroImg) gsap.fromTo(heroImg, { scale: 1.12 }, { scale: 1, duration: 1.5, ease: 'power2.out', scrollTrigger: { trigger: heroImgWrap, start: 'top 85%' } })

  if (desc) {
    gsap.set(desc, { opacity: 0, y: 16 })
    gsap.to(desc, { opacity: 1, y: 0, duration: 1.0, ease: ease.out, scrollTrigger: { trigger: '#branding-detail', start: 'top 85%' } })
  }
  if (identityWrap) revealClip(identityWrap, { direction: 'up' })
  // Imagen con margen negativo (se superpone a la anterior): scale+fade, un
  // clip-path acá cortaría feo el solape.
  if (colorsImg) {
    gsap.set(colorsImg, { opacity: 0, scale: 0.9 })
    gsap.to(colorsImg, { opacity: 1, scale: 1, duration: 0.8, ease: ease.out, delay: 0.2, scrollTrigger: { trigger: '#branding-detail', start: 'top 85%' } })
  }
})
</script>
