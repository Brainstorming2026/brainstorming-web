---
import { Image } from 'astro:assets'
import { growthStages } from '@/data/growth-planning'
---

<section id="proceso-growth" class="relative overflow-hidden bg-[#f3f5f7] py-16 sm:py-20 lg:py-24">

  <div class="relative mx-auto max-w-[1240px] px-5 sm:px-6 lg:px-12">
    <header class="max-w-[790px]">
      <p class="text-[11px] font-bold uppercase tracking-[0.22em] text-primary sm:text-xs">El proceso · 7 etapas</p>
      <h2 data-process-title class="mt-4 font-heading text-[clamp(2.15rem,8.5vw,3.5rem)] font-bold leading-[1.04] tracking-[-0.04em] text-dark">
        Primero entender.<br />Después, decidir.
      </h2>
      <p class="mt-5 max-w-[680px] text-base leading-7 text-dark-500 sm:text-lg">Siete etapas para mirar tu negocio desde dentro y desde fuera. Cada conversación y cada análisis alimentan una decisión.</p>
    </header>

    <div class="mx-auto mt-10 grid max-w-[880px] grid-cols-2 overflow-hidden rounded-2xl border border-[#ded8e8] bg-white shadow-[0_14px_38px_rgba(59,39,92,0.05)] sm:mt-12 sm:grid-cols-4">
      {[
        ['00–01', 'Entender'],
        ['02–03', 'Investigar'],
        ['04–05', 'Decidir'],
        ['06', 'Ejecutar'],
      ].map(([range, label], index) => (
        <div class:list={[
          'border-[#ebe7f0] px-3 py-4 text-center sm:px-4',
          index < 2 ? 'border-b' : '',
          index % 2 === 0 ? 'border-r' : '',
          'sm:border-b-0 sm:border-r',
          index === 3 ? 'sm:border-r-0' : '',
        ]}
        >
          <span class="block text-[10px] font-bold tracking-[0.18em] text-primary">{range}</span>
          <span class="mt-1 block text-sm font-semibold text-dark">{label}</span>
        </div>
      ))}
    </div>

    <ol data-growth-process class="process-sequence">
      {growthStages.map((stage, index) => (
        <li
          id={`growth-stage-${stage.number}`}
          data-stage-card={stage.number}
          class="scroll-mt-28"
        >
          <article class="process-chapter">
            <div class="chapter-photo">
              <Image
                src={stage.image}
                alt={`Etapa ${stage.number}: ${stage.title}`}
                class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.025]"
                widths={[480, 720, 960, 1280]}
                sizes={index === growthStages.length - 1 ? '(max-width: 767px) calc(100vw - 40px), 44vw' : '(max-width: 767px) calc(100vw - 40px), 48vw'}
                loading="lazy"
                quality={90}
              />
            </div>

            <div class="chapter-copy">
              <p class="chapter-label"><span>Etapa {stage.number}</span> {stage.shortLabel}</p>
              <h3 class="relative mt-2 max-w-[520px] font-heading text-[22px] font-bold leading-[1.2] text-dark sm:text-[26px]">{stage.title}</h3>
              <p class="relative mt-4 max-w-[700px] text-[15px] leading-7 text-dark-500 sm:text-base">{stage.description}</p>
            </div>
          </article>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .process-sequence { display: grid; gap: 48px; margin-top: 56px; }
  .process-chapter { display: grid; gap: 24px; align-items: center; }
  .chapter-photo { aspect-ratio: 16/10; overflow: hidden; border-radius: 6px; }
  .chapter-label { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; color: #6742ac; font-size: 11px; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; }
  .chapter-label span { padding: 5px 9px; border: 1px solid #c9c5d2; border-radius: 3px; color: #525260; }
  .chapter-copy h3 { margin-top: 18px; }
  @media (min-width: 768px) {
    .process-sequence { gap: 64px; }
    .process-chapter { grid-template-columns: 1fr 1fr; gap: 7%; }
    .process-sequence > li:nth-child(even) .chapter-photo { order: 2; }
  }
</style>

<script>
import { ensureGsap, prefersReducedMotion, registerMotion, splitHeadline } from '@/lib/motion'

registerMotion(() => {
  const section = document.querySelector<HTMLElement>('[data-growth-process]')
  const title = document.querySelector<HTMLElement>('[data-process-title]')
  if (title)
    splitHeadline(title, { by: 'lines' })
  if (!section || prefersReducedMotion())
    return

  const cards = Array.from(section.querySelectorAll<HTMLElement>('[data-stage-card]'))
  const { ScrollTrigger, gsap } = ensureGsap()
  ScrollTrigger.batch(cards, {
    start: 'top 88%',
    once: true,
    onEnter: batch => gsap.fromTo(batch, { y: 22, opacity: 0 }, { y: 0, opacity: 1, duration: 0.52, stagger: 0.06, ease: 'power2.out' }),
  })
})
</script>
