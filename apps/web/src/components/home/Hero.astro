---
import { Icon } from 'astro-icon/components'
import { getImage } from 'astro:assets'
import heroPoster from '@/assets/video/smart-selling-cover-editorial-v2.png'
import heroVideo from '@/assets/video/Smart_Selling_Brainstorming_1080p_final.mp4?url'
import { homeContent } from '@/data/transversal-content'

const poster = await getImage({ src: heroPoster, width: 1280, format: 'webp', quality: 85 })
---

<section id="hero" class="bg-white">
  <div
    class="mx-auto grid max-w-[1512px] items-center gap-10 px-6 pb-16 pt-6 lg:grid-cols-2 lg:gap-16 lg:px-24 lg:pb-0 lg:pt-[72px]"
  >
    <!-- Titular -->
    <!-- data-speed solo lo lee ScrollSmoother (desktop): el texto avanza algo
         más rápido que el scroll y el video se queda atrás → profundidad. -->
    <div class="min-w-0" data-speed="1.06">
      <h1
        id="hero-headline"
        data-animate
        class="font-heading text-[clamp(2rem,3.4vw,3.25rem)] font-bold leading-[1.1] tracking-[-0.035em] text-ink"
      >
        {homeContent.hero.title}
      </h1>
      <p id="hero-subtitle" class="mt-7 max-w-[60ch] text-base leading-relaxed text-gray-body sm:text-lg">
        {homeContent.hero.subtitle}
      </p>
    </div>

    <div
      id="hero-video"
      data-animate="circle"
      data-speed="0.9"
      class="group relative aspect-video w-full overflow-hidden rounded-3xl bg-dark shadow-lg"
    >
      <video
        src={heroVideo}
        poster={poster.src}
        playsinline
        preload="none"
        aria-label="Smart Selling: crecimiento comercial y automatización — Brainstorming"
        class="h-full w-full object-contain"
      >
        Tu navegador no permite reproducir este video.
        <a href={heroVideo}>Ver video de Smart Selling</a>
      </video>
      <!-- Play propio, igual al del video de ROAS. Los controles nativos se
           activan recién al reproducir, para que no asome la barra sobre el póster. -->
      <button
        type="button"
        id="hero-video-play"
        aria-label="Reproducir video de Smart Selling"
        class="absolute inset-0 flex items-center justify-center bg-black/10 text-white/90 transition-colors hover:bg-black/20"
      >
        <span class="hero-play-ring relative flex items-center justify-center rounded-full">
          <Icon name="play" class="h-20 w-20 drop-shadow-lg transition-transform group-hover:scale-110" />
        </span>
      </button>
    </div>
  </div>
</section>

<style>
  /* El play "respira": un anillo que se expande y se desvanece invita a darle
     clic sin mover el botón. Se detiene al pasar el mouse (ya tiene tu atención). */
  .hero-play-ring::after {
    content: '';
    position: absolute;
    inset: 4px;
    border-radius: inherit;
    border: 2px solid rgb(255 255 255 / .7);
    animation: hero-play-ring 2.6s cubic-bezier(.16,1,.3,1) infinite;
    pointer-events: none;
  }
  #hero-video-play:hover .hero-play-ring::after { animation-play-state: paused; opacity: 0; }
  @keyframes hero-play-ring {
    0% { transform: scale(.9); opacity: .8; }
    70%, 100% { transform: scale(1.45); opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-play-ring::after { animation: none; opacity: 0; }
  }
</style>

<script>
import { prefersReducedMotion, registerMotion, revealCircle, splitHeadline } from '@/lib/motion'
import { ease, tempo } from '@/lib/motion/config'
import { ensureGsap } from '@/lib/motion/gsap-client'

registerMotion(() => {
  const headline = document.getElementById('hero-headline')
  const subtitle = document.getElementById('hero-subtitle')
  const video = document.getElementById('hero-video')
  if (headline)
    splitHeadline(headline, { by: 'words', scrollTrigger: false })
  // El subtítulo llega cuando el titular ya casi terminó: primero la promesa,
  // después el detalle. Pre-oculto con gsap.set() para que no parpadee.
  if (subtitle && !prefersReducedMotion()) {
    const { gsap } = ensureGsap()
    gsap.set(subtitle, { autoAlpha: 0, y: 16 })
    gsap.to(subtitle, { autoAlpha: 1, y: 0, duration: 0.9 * tempo, delay: 0.55 * tempo, ease: ease.out, clearProps: 'opacity,visibility,transform' })
  }
  if (video)
    revealCircle(video, { delay: 0.3 })

  const player = video?.querySelector('video')
  const play = document.getElementById('hero-video-play')
  play?.addEventListener('click', () => {
    if (!player)
      return
    player.controls = true
    play.remove()
    void player.play()
  }, { once: true })
})
</script>
