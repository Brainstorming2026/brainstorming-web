---
import type { ProjectImageSlot } from '@/data/new-projects'
import { Image } from 'astro:assets'
import AitSystem from './AitSystem.astro'
import EtnaScope from './EtnaScope.astro'
import FuturaOperations from './FuturaOperations.astro'
import NordicJourney from './NordicJourney.astro'
import PastipanCampaign from './PastipanCampaign.astro'
import PastipanCover from './PastipanCover.astro'
import ProjectEvidence from './ProjectEvidence.astro'

interface Props {
  asset: ProjectImageSlot
  priority?: boolean
  sizes?: string
}
const { asset, priority = false, sizes = '(min-width: 1440px) 640px, (min-width: 768px) 45vw, 90vw' } = Astro.props
---

<figure class:list={['case-asset', { 'case-asset--evidence': asset.visual }]} data-asset-id={asset.id} style={{ '--asset-ratio': asset.ratio }}>
  {asset.src
? (
    <div class="case-asset-image" data-study-image>
      <Image src={asset.src} alt={asset.alt} widths={[480, 800, 1200, 1600].filter(width => width < asset.src!.width).concat(asset.src.width)} sizes={sizes} loading={priority ? 'eager' : 'lazy'} fetchpriority={priority ? 'high' : 'auto'} />
    </div>
  )
: asset.visual === 'nordic-journey'
? <NordicJourney />
: asset.visual === 'ait-system'
? <AitSystem />
: asset.visual === 'futura-workspace'
? <FuturaOperations />
: asset.visual === 'pastipan-campaign'
? <PastipanCampaign />
: asset.visual === 'pastipan-cover'
? <PastipanCover />
: asset.visual === 'etna-scope'
? <EtnaScope />
: asset.visual
? <ProjectEvidence visual={asset.visual} alt={asset.alt} />
: null}
  <figcaption>{asset.title}</figcaption>
</figure>

<style>
  .case-asset { min-width: 0; margin: 0; }
  .case-asset--evidence { grid-column: 1 / -1; }
  .case-asset-image { overflow: hidden; border-radius: 12px; background: var(--study-surface); }
  .case-asset-image img { display: block; width: 100%; height: auto; }
  figcaption { margin-top: 12px; color: var(--color-dark); font-size: 12px; font-weight: 600; line-height: 1.5; }
</style>
