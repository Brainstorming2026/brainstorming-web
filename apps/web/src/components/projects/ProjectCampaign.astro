---
import type { ProyectoCampania } from '@/data/proyectosDetalle'
import { Icon } from 'astro-icon/components'
import { Image } from 'astro:assets'
import ProjectVideo from './ProjectVideo.astro'

interface Props {
  campania: ProyectoCampania
}

const { campania } = Astro.props
const extraVideos = campania.videos?.slice(1) ?? []
---

<section id="campaign-intro" class="bg-white pt-16 lg:pt-20">
  <div class="mx-auto grid max-w-[1512px] mb-10 gap-8 px-6 lg:grid-cols-2 lg:items-start lg:px-24">
    <div class="campaign-block">
      <div class="flex items-center gap-2 font-heading text-sm font-bold text-dark">
        <Icon name="expert-iman" class="h-6 w-6 text-dark-300" />
        <span>Inbound Marketing</span>
      </div>

      <h2 class="mt-4 max-w-[380px] font-heading text-3xl font-bold leading-tight text-dark sm:text-5xl">
        {campania.heading}
      </h2>
    </div>

    <div class="campaign-block flex flex-col lg:h-full lg:justify-end">
      <p class="text-[14px] leading-6 text-dark-500">
        {campania.parrafo}
      </p>
    </div>
  </div>

  {
    campania.waveIcon && (
      <Icon
        name={campania.waveIcon}
        class="block w-full h-full xl:scale-140 xl:mb-6"
        style={{ color: campania.colorFondo }}
      />
    )
  }
</section>

{
  extraVideos.length > 0 && (
    <section id="campaign-videos" class="scroll-mt-20 py-16 lg:py-20" style={{ backgroundColor: campania.colorFondo }}>
      <div class:list={['mx-auto grid max-w-[1190px] gap-8 px-6 lg:px-0', extraVideos.length > 1 && 'md:grid-cols-2']}>
        {extraVideos.map(video => (
          <figure class="campaign-video">
            <div class="campaign-video-frame"><ProjectVideo youtubeId={video.youtubeId} title={video.title} poster={video.poster} /></div>
            <figcaption class="mt-4 flex flex-wrap items-center justify-between gap-3 text-sm font-semibold text-dark">
              <span>{video.title}</span>
              <a href={`https://www.youtube.com/watch?v=${video.youtubeId}`} target="_blank" rel="noopener noreferrer" class="underline underline-offset-4">Ver en YouTube</a>
            </figcaption>
          </figure>
        ))}
      </div>
    </section>
  )
}

{
  campania.imagenes.length > 0 && (
    <section
      id="campaign-gallery"
      class:list={[extraVideos.length ? 'bg-white py-16 lg:py-20' : undefined]}
      style={extraVideos.length ? undefined : { backgroundColor: campania.colorFondo }}
    >
      <div class="mx-auto max-w-[1512px] px-6 lg:px-24">
        <div class="flex flex-wrap items-center justify-center gap-8">
          {
            campania.imagenes.map(img => (
              <Image
                src={img.src}
                alt={img.alt}
                class="gallery-img h-auto w-full"
                style={{ maxWidth: `${img.maxWidth ?? 420}px` }}
                widths={[img.maxWidth ?? 420, (img.maxWidth ?? 420) * 2]}
                sizes={`(min-width: 640px) ${img.maxWidth ?? 420}px, 90vw`}
                loading="lazy"
              />
            ))
          }
        </div>
      </div>
    </section>
  )
}

<script>
import { ensureGsap, registerMotion, revealCircle, staggerGrid } from '@/lib/motion'
import { prefersReducedMotion } from '@/lib/motion/reduced-motion'

registerMotion(() => {
  const intro = document.querySelectorAll('#campaign-intro .campaign-block')
  const videos = document.querySelectorAll<HTMLElement>('.campaign-video-frame')
  const galleryImgs = document.querySelectorAll('#campaign-gallery .gallery-img')

  if (intro.length > 0) {
    const { gsap } = ensureGsap()
    if (prefersReducedMotion()) {
      gsap.fromTo(intro, { opacity: 0 }, { opacity: 1, duration: 0.4, stagger: 0.08 })
    }
    else {
      gsap.set(intro, { opacity: 0, y: 20 })
      gsap.to(intro, { opacity: 1, y: 0, duration: 1.0, ease: 'power2.out', stagger: 0.15, scrollTrigger: { trigger: '#campaign-intro', start: 'top 85%' } })
    }
  }

  videos.forEach(video => revealCircle(video, { scrollTrigger: true }))
  staggerGrid(galleryImgs, { variant: 'organic' })
})
</script>
