---
import type { NewProject } from '@/data/new-projects'
import { Image } from 'astro:assets'
import futuraCrm from '@/assets/projects/new/futura-wealth/crm-anonymized.png'
import nordicAdmissions from '@/assets/projects/new/nordic/admissions.png'
import nordicLevels from '@/assets/projects/new/nordic/education-levels.png'
import senatiPhoto from '@/assets/projects/new/senati/technical-training-concept.png'
import { newProjectLogos } from '@/data/new-projects'

interface Props { project: NewProject, compact?: boolean }
const { project, compact = false } = Astro.props
const logo = newProjectLogos[project.slug]
---

<div class:list={['project-cover', `cover-${project.slug}`, { 'project-cover--compact': compact }]}>
  {project.slug === 'nordic' && (
<div class="cover-scene nordic-scene">
    <div class="nordic-brand"><Image src={logo} alt="Nordic International School" loading="lazy" /></div>
    <div class="nordic-orbit"></div>
    <div class="nordic-browser"><div class="nordic-browser-bar"><span>● ● ●</span><span>Una educación que conecta.</span></div><Image src={nordicAdmissions} alt="Campaña de admisiones de Nordic con una familia del colegio." widths={[480, 800]} sizes="(min-width: 768px) 40vw, 85vw" loading="lazy" /></div>
    <div class="nordic-levels"><Image src={nordicLevels} alt="Alumnos de los niveles inicial, primaria y secundaria de Nordic." widths={[320, 640]} sizes="(min-width: 768px) 24vw, 55vw" loading="lazy" /></div>
    <div class="nordic-note"><span>De la primera visita</span><strong>a su próximo<br />gran comienzo.</strong><i></i><small>Estrategia + Admisiones</small></div>
  </div>
)}
  {project.slug === 'ait-capital' && (
<div class="cover-scene ait-scene">
    <div class="ait-heading"><Image src={logo} alt="AIT Capital" loading="lazy" /><span>Inteligencia comercial</span></div>
    <div class="ait-board">
      <div class="board-top"><span>AIT / Desempeño comercial</span><i></i></div>
      <p>Más oportunidades.<br /><strong>Más cierres.</strong></p>
      <div class="chart" role="img" aria-label="Cierres mensuales: junio 2024, 1; octubre, 2; noviembre, 5; diciembre, 11.">
        {[{ month: 'Jun', value: 1 }, { month: 'Oct', value: 2 }, { month: 'Nov', value: 5 }, { month: 'Dic', value: 11 }].map(item => <div class="bar-column"><span>{item.value}</span><div style={`height:${item.value * 6 + 8}%`}></div><small>{item.month}</small></div>)}
      </div>
      <div class="board-bottom">Evolución de cierres · 2024</div>
    </div>
    <div class="ait-note"><span>El proceso conectado</span><strong>Prospección <b>→</b> Reunión <b>→</b> Seguimiento</strong><div><i></i> CRM + Automatización + IA</div></div>
  </div>
)}

  {project.slug === 'futura-wealth' && (
<div class="cover-scene futura-scene">
    <Image class="futura-logo" src={logo} alt="Futura Wealth Management" loading="lazy" />
    <div class="futura-line"></div>
    <div class="crm-screen"><div class="screen-bar"><span>● ● ●</span><span>Futura / Gestión comercial</span></div><Image src={futuraCrm} alt="CRM de Futura con prospectos anonimizados, estados y seguimiento de reuniones." widths={[640, 1000]} sizes="(min-width: 768px) 42vw, 90vw" loading="lazy" /></div>
    <div class="futura-card"><span>Una operación conectada</span><strong>Cada relación,<br />un siguiente paso.</strong><div>Prospección <b>·</b> Nutrición <b>·</b> Seguimiento</div></div>
  </div>
)}

  {project.slug === 'senati' && (
<div class="cover-scene senati-scene">
    <Image class="senati-photo" src={senatiPhoto} alt="Escena conceptual de estudiantes adultos en un taller de formación técnica." widths={[640, 1000]} sizes="(min-width: 768px) 45vw, 90vw" loading="lazy" />
    <div class="senati-brand"><Image src={logo} alt="SENATI" loading="lazy" /></div>
    <div class="senati-route"><span>Del interés a la matrícula</span><strong>Conectar con<br />su próximo paso.</strong><div class="route-steps"><span>Captación</span><b>→</b><span>Seguimiento</span><b>→</b><span>Matrícula</span></div><small>Visualización conceptual del recorrido</small></div>
  </div>
)}

  {project.slug === 'etna' && (
<div class="cover-scene etna-scene">
    <div class="etna-back"><span>IDENTIDAD<br />EN MOVIMIENTO.</span><div class="energy-lines"><i></i><i></i><i></i></div></div>
    <div class="etna-sheet"><span class="sheet-caption">MARCA / IDENTIDAD VISUAL</span><Image src={logo} alt="ETNA, energía que te conecta" loading="lazy" /><div class="etna-rule"></div><div class="etna-swatches"><i></i><i></i><i></i></div><span class="sheet-footer">Energía que se reconoce.</span></div>
    <span class="etna-caption">Estudio conceptual de presentación</span>
  </div>
)}
</div>

<style>
  .project-cover { position: relative; isolation: isolate; container-type: inline-size; width: 100%; height: 100%; min-height: 340px; overflow: hidden; aspect-ratio: 1.65; font-family: var(--font-heading); }
  .cover-scene { position: absolute; inset: 0; overflow: hidden; }
  .project-cover--compact { min-height: 0; height: auto; aspect-ratio: 1.3; }
  .nordic-scene { background: #e5edf2; color: #345f88; }
  .nordic-brand { position: absolute; left: 7%; top: 7%; width: 36%; }
  .nordic-brand img { width: 100%; height: auto; mix-blend-mode: multiply; }
  .nordic-orbit { position: absolute; width: 76%; aspect-ratio: 1; right: -27%; top: -30%; border: 1px solid #829fba70; border-radius: 50%; box-shadow: 0 0 0 4cqw #829fba0d, 0 0 0 8cqw #829fba0a; }
  .nordic-browser { position: absolute; width: 84%; left: 12%; top: 25%; border: .7cqw solid white; border-radius: 1.2cqw; overflow: hidden; background: white; transform: rotate(-6deg); box-shadow: 0 3cqw 5cqw #29476429; }
  .nordic-browser-bar { display: flex; gap: 5cqw; padding: .8cqw 1cqw 1.3cqw; color: #71869a; font-size: 1.15cqw; }
  .nordic-browser-bar > span:first-child { letter-spacing: .25cqw; color: #c2cedb; }
  .nordic-browser img { display: block; width: 100%; height: auto; }
  .nordic-levels { position: absolute; left: 4%; bottom: 6%; width: 58%; padding: 1.1%; background: #fff; transform: rotate(5deg); box-shadow: 0 2cqw 4cqw #29476433; }
  .nordic-levels img { display: block; width: 100%; height: auto; }
  .nordic-note { position: absolute; right: 5%; bottom: 7%; width: 33%; padding: 3.5%; background: #345f88; color: white; box-shadow: 0 2cqw 4cqw #29476422; }
  .nordic-note > span { font-size: 1.3cqw; color: #d7e5f1; }
  .nordic-note strong { display: block; margin-top: 1.2cqw; font-size: 2.7cqw; font-weight: 500; line-height: 1.12; letter-spacing: -.03em; }
  .nordic-note i { display: block; width: 5cqw; height: .4cqw; background: #d394a2; margin-block: 2cqw; }
  .nordic-note small { font-size: 1.1cqw; color: #d7e5f1; }
  .ait-scene { background: #e8ebf3; color: #101556; }
  .ait-heading { position: absolute; top: 7%; left: 7%; right: 7%; display: flex; align-items: center; justify-content: space-between; }
  .ait-heading img { width: 27%; height: auto; mix-blend-mode: multiply; }
  .ait-heading > span { font-size: 1.5cqw; letter-spacing: .12em; text-transform: uppercase; }
  .ait-board { position: absolute; top: 25%; left: 17%; width: 70%; height: 70%; background: #fff; padding: 4% 5%; border-radius: 1.4cqw; transform: rotate(-5deg); box-shadow: 0 3cqw 6cqw #10155626; }
  .board-top { display: flex; justify-content: space-between; font-size: 1.3cqw; color: #626982; }
  .board-top i { width: 1cqw; height: 1cqw; border-radius: 50%; background: #ff7900; }
  .ait-board p { margin-top: 4%; font-size: 3cqw; line-height: 1.12; letter-spacing: -.04em; }
  .ait-board p strong { font-weight: 600; }
  .chart { display: flex; align-items: end; justify-content: space-around; height: 53%; margin-top: 3%; border-bottom: 1px solid #dce0eb; background: repeating-linear-gradient(to top, transparent 0, transparent 24%, #eef0f5 24%, #eef0f5 25%); }
  .bar-column { display: flex; flex-direction: column; align-items: center; justify-content: end; width: 15%; height: 100%; position: relative; }
  .bar-column > div { width: 100%; background: #101556; border-radius: .5cqw .5cqw 0 0; }
  .bar-column:last-child > div { background: #ff7900; }
  .bar-column > span { font-size: 1.8cqw; margin-bottom: .7cqw; }
  .bar-column small { position: absolute; top: 100%; margin-top: .6cqw; font-size: 1.3cqw; color: #626982; }
  .board-bottom { margin-top: 3cqw; font-size: 1.2cqw; color: #626982; }
  .ait-note { position: absolute; left: 5%; bottom: 7%; width: 69%; padding: 3% 4%; background: #101556; color: #fff; border-radius: .8cqw; box-shadow: 0 2cqw 4cqw #10155633; transform: rotate(2deg); }
  .ait-note > span { display: block; font-size: 1.35cqw; color: #b8c0de; margin-bottom: 1.5cqw; }
  .ait-note strong { font-size: 1.8cqw; font-weight: 500; }
  .ait-note b { color: #ff7900; padding-inline: .7cqw; }
  .ait-note > div { margin-top: 1.5cqw; font-size: 1.25cqw; color: #c7cce0; }
  .ait-note i { display: inline-block; width: .65cqw; height: .65cqw; margin-right: .7cqw; background: #ff7900; border-radius: 50%; }
  .futura-scene { background: #193341; color: #fff; }
  .futura-logo { position: absolute; width: 34%; height: auto; left: 7%; top: 8%; }
  .futura-line { position: absolute; width: 55%; height: 130%; border: 1px solid #bc9e5c40; border-radius: 50%; right: -15%; top: -20%; transform: rotate(30deg); }
  .crm-screen { position: absolute; width: 88%; left: 20%; top: 29%; padding: 1%; background: #334956; border-radius: 1.4cqw; transform: rotate(-7deg); box-shadow: 0 3cqw 5cqw #0005; }
  .screen-bar { display: flex; gap: 4cqw; align-items: center; padding: .8cqw 1cqw 1.5cqw; font-size: 1.1cqw; color: #dae1e5; }
  .screen-bar > span:first-child { color: #b5c1c8; letter-spacing: .3cqw; }
  .crm-screen img { display: block; width: 100%; height: auto; border-radius: .6cqw; }
  .futura-card { position: absolute; left: 6%; bottom: 7%; width: 51%; padding: 4%; background: #f0e8d9; color: #193341; transform: rotate(3deg); box-shadow: 0 2cqw 4cqw #0003; }
  .futura-card > span { font-size: 1.3cqw; text-transform: uppercase; letter-spacing: .08em; }
  .futura-card strong { display: block; margin-block: 2cqw; font-size: 3.2cqw; font-weight: 500; line-height: 1.1; letter-spacing: -.035em; }
  .futura-card > div { border-top: 1px solid #19334133; padding-top: 1.5cqw; font-size: 1.15cqw; }
  .futura-card b { padding-inline: .5cqw; color: #805615; }
  .senati-scene { background: #dce9f5; }
  .senati-photo { position: absolute; inset: 0 0 0 auto; width: 83%; height: 100%; object-fit: cover; object-position: 58% center; }
  .senati-brand { position: absolute; top: 7%; left: 6%; width: 26%; padding: 2.5%; background: #fff; box-shadow: 0 1cqw 3cqw #08266418; }
  .senati-brand img { width: 100%; height: auto; }
  .senati-route { position: absolute; bottom: 7%; left: 6%; width: 67%; background: #073cab; color: #fff; padding: 4.5%; box-shadow: 0 2cqw 4cqw #03246c40; }
  .senati-route > span { font-size: 1.35cqw; text-transform: uppercase; letter-spacing: .08em; color: #c4dafb; }
  .senati-route strong { display: block; margin-top: 2cqw; font-size: 4.2cqw; line-height: 1.05; letter-spacing: -.035em; font-weight: 500; }
  .route-steps { display: flex; justify-content: space-between; align-items: center; margin-top: 3cqw; padding-top: 2cqw; border-top: 1px solid #ffffff45; font-size: 1.4cqw; }
  .route-steps b { color: #8bd7ff; }
  .senati-route small { display: block; margin-top: 1.5cqw; color: #c4dafb; font-size: 1.1cqw; }
  .etna-scene { background: #dce7ed; color: #07578b; }
  .etna-back { position: absolute; left: 41%; top: -10%; width: 61%; height: 115%; background: #07578b; transform: rotate(12deg); padding: 14% 8%; color: #fff; box-shadow: 0 3cqw 6cqw #12394f30; }
  .etna-back > span { font-size: 3.8cqw; line-height: 1.05; font-weight: 700; letter-spacing: -.03em; }
  .energy-lines { position: absolute; bottom: 14%; right: 10%; display: flex; gap: 2cqw; transform: skew(-20deg); }
  .energy-lines i { display: block; width: 4cqw; height: 24cqw; background: #ffffff20; }
  .etna-sheet { position: absolute; left: 8%; top: 18%; width: 62%; height: 66%; padding: 5%; background: #fff; transform: rotate(-8deg); box-shadow: 0 3cqw 5cqw #15394f30; display: flex; flex-direction: column; justify-content: space-between; }
  .sheet-caption { font-size: 1.2cqw; letter-spacing: .13em; color: #687b86; }
  .etna-sheet img { width: 96%; height: auto; margin-block: 3cqw; }
  .etna-rule { height: 1px; background: #dce7ed; }
  .etna-swatches { display: flex; height: 4cqw; margin-top: 2cqw; }
  .etna-swatches i { flex: 1; background: #07578b; }
  .etna-swatches i:nth-child(2) { background: #12394f; }
  .etna-swatches i:nth-child(3) { background: #dce7ed; }
  .sheet-footer { margin-top: 1.5cqw; font-size: 1.5cqw; }
  .etna-caption { position: absolute; bottom: 4%; left: 7%; font-size: 1.3cqw; color: #244b62; }
  @media (max-width: 767px) { .project-cover { min-height: 0; height: auto; aspect-ratio: 1.3; } }
</style>
