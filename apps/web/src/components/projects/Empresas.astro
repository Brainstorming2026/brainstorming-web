---
import { Image } from 'astro:assets'

import { clienteLogos as logos } from '@/assets/clientes'
import curva from '@/icons/proyecto-curva.svg'
---

<section class="relative bg-gradient-to-b from-primary to-navy">
  <img
    src={curva.src}
    alt=""
    class="absolute top-0 left-0 block h-[120px] w-full object-cover object-top"
    aria-hidden="true"
  />
  <div class="mx-auto max-w-[1512px] px-6 pt-28 pb-16 lg:px-24">
    <h2 id="empresas-headline" class="text-center font-heading text-[35px] font-bold text-white">
      Empresas
    </h2>
    <div
      id="empresas-grid"
      class="mt-14 grid grid-cols-3 items-center gap-x-8 gap-y-8 sm:grid-cols-5 lg:grid-cols-9"
    >
      {
        logos.map(logo => (
          <div class="empresa-logo flex h-16 items-center justify-center">
            <Image
              src={logo.image}
              alt={logo.name}
              loading="eager"
              class:list={['max-h-30 w-full max-w-full object-contain', logo.className]}
            />
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
import { registerMotion, splitHeadline, staggerGrid } from '@/lib/motion'

registerMotion(() => {
  const headline = document.getElementById('empresas-headline')
  const logos = document.querySelectorAll('#empresas-grid .empresa-logo')
  if (headline)
    splitHeadline(headline, { by: 'words' })
  staggerGrid(logos, { variant: 'wipe' })
})
</script>
