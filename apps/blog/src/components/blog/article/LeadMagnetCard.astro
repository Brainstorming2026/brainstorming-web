---
import type { ArticleLeadMagnet } from '@/data/articles'
import SmartImage from '@/components/common/SmartImage.astro'

interface Props {
  leadMagnet: ArticleLeadMagnet
}

const { leadMagnet } = Astro.props
const external = leadMagnet.ctaHref.startsWith('http')
---

<div class="flex items-center gap-6 rounded-3xl bg-art-soft p-6 sm:p-8">
  <div class="min-w-0 flex-1">
    <p class="font-body text-xs font-bold tracking-wider text-art-strong uppercase">{leadMagnet.eyebrow}</p>
    <p class="mt-2 font-heading text-lg leading-snug font-bold text-dark sm:text-xl">{leadMagnet.title}</p>
    <a
      href={leadMagnet.ctaHref}
      target={external ? '_blank' : undefined}
      rel={external ? 'noopener noreferrer' : undefined}
      class="mt-5 inline-flex min-h-12 items-center rounded-xl bg-art px-6 font-heading text-base font-bold text-white transition-colors hover:bg-art-strong"
    >
      {leadMagnet.ctaLabel}
    </a>
  </div>
  {leadMagnet.image && (
    <div class="hidden aspect-square w-32 shrink-0 overflow-hidden rounded-2xl bg-white sm:block">
      <SmartImage src={leadMagnet.image} alt="" class="h-full w-full object-cover" widths={[160, 320]} sizes="128px" loading="lazy" />
    </div>
  )}
</div>
