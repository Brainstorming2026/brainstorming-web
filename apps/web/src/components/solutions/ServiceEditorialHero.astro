---
import type { ImageMetadata } from 'astro'
import { Icon } from 'astro-icon/components'
import { Image } from 'astro:assets'
import ServiceHeroStory from './ServiceHeroStory.astro'

interface Props {
  service: 'growth' | 'innovation' | 'marketing' | 'sales'
  eyebrow: string
  title: string
  accent: string
  statement: string
  description: string
  image: ImageMetadata
  imageAlt: string
  cta: string
  href: string
  processHref: string
  caption: string
  facts: { label: string, value: string }[]
}

const { service, eyebrow, title, accent, statement, description, image, imageAlt, cta, href, processHref, caption, facts } = Astro.props
const external = href.startsWith('https://')
---

<section data-editorial-hero={service} class="editorial-hero service-container bg-white font-body text-dark" aria-labelledby={`${service}-title`}>
  <div data-hero-enter class="hero-eyebrow flex items-center gap-3 text-[10px] font-semibold uppercase tracking-[0.13em] text-gray-body">
    <span aria-hidden="true" class="h-0.5 w-6 shrink-0 bg-primary"></span>
    {eyebrow}
  </div>
  <div class="hero-heading">
    <h1 id={`${service}-title`} data-hero-title class="font-heading">
      {title} <span class="text-primary">{accent}</span>
    </h1>
    <div data-hero-enter class="hero-aside">
      <p class="hero-statement">{statement}</p>
      <p class="hero-description">{description}</p>
      <div class="mt-6 flex flex-col items-start gap-2">
        <a href={href} target={external ? '_blank' : undefined} rel={external ? 'noopener noreferrer' : undefined} class="hero-cta group inline-flex min-h-13 items-center justify-center gap-5 rounded-[7px] bg-primary px-5 py-3.5 text-[13px] font-medium text-white transition-colors hover:bg-primary-600">
          {cta}
          <Icon name="automation/arrow-right" class="size-[18px] shrink-0 transition-transform motion-safe:group-hover:translate-x-1" />
        </a>
        <a href={processHref} class="hero-process group inline-flex min-h-11 items-center gap-2 text-xs text-dark underline decoration-dark/30 underline-offset-4 hover:text-primary">
          Explorar el proceso
          <Icon name="automation/arrow-down" class="size-3.5 transition-transform motion-safe:group-hover:translate-y-0.5" />
        </a>
      </div>
    </div>
  </div>

  <figure>
    <div data-hero-stage class="hero-stage">
      <div class="hero-photo-frame">
        <!-- Widths must match the Vercel imagesConfig.sizes allowlist. -->
        <Image src={image} alt={imageAlt} data-hero-photo class="hero-photo" widths={[480, 720, 960, 1280, 1600, 1920, 2560]} sizes="(max-width: 767px) calc(100vw - 40px), (max-width: 1050px) 100vw, (max-width: 1416px) 100vw, 1400px" loading="eager" fetchpriority="high" quality={90} />
      </div>
      <div class="hero-story-position">
        <ServiceHeroStory service={service} />
      </div>
    </div>
    <figcaption class="hero-caption flex flex-wrap items-center justify-between gap-x-6 gap-y-2 pt-4 text-[10px] text-gray-body">
      <span class="uppercase tracking-[0.1em]">{caption}</span>
      <span>Brainstorming / {service === 'innovation' ? 'Collective Intelligence' : 'De la estrategia a la acción'}</span>
    </figcaption>
  </figure>

  <dl class="hero-facts grid grid-cols-1 gap-5 border-y border-primary/15 py-6 sm:grid-cols-3 sm:gap-8">
    {facts.map(({ label, value }) => (
      <div data-hero-fact>
        <dt class="text-[10px] font-medium uppercase tracking-[0.12em] text-gray-body">{label}</dt>
        <dd class="mt-2 text-[17px] font-medium tracking-[-0.025em] sm:text-xl">{value}</dd>
      </div>
    ))}
  </dl>
</section>

<style>
  .editorial-hero { padding-block: 45px 0; }
  .hero-heading { display: grid; grid-template-columns: minmax(0, 1fr) 290px; align-items: end; gap: 64px; padding-block: 30px 45px; }
  .hero-heading h1 { align-self: start; max-width: 950px; font-size: clamp(44px, 5.9vw, 86px); font-weight: 500; line-height: 1.02; letter-spacing: -.063em; text-wrap: balance; }
  .hero-aside { padding-bottom: 4px; }
  .editorial-hero .hero-statement { color: var(--color-dark); font-size: 25px; line-height: 1.3; letter-spacing: -.035em; }
  .editorial-hero .hero-description { margin-top: 13px; color: var(--color-gray-body); font-size: 13px; line-height: 1.7; }
  .hero-stage { position: relative; perspective: 1200px; }
  .hero-photo-frame { height: clamp(400px, 37vw, 520px); overflow: hidden; border-radius: 8px; background: var(--color-primary-50); }
  .hero-photo { width: 100%; height: 100%; object-fit: cover; object-position: center 51%; }
  .hero-story-position { position: absolute; right: 30px; bottom: 28px; width: 340px; perspective: 900px; }
  .hero-facts { margin-top: 30px; }
  .hero-facts > div + div { border-left: 1px solid var(--color-primary-100); padding-left: 28px; }
  .editorial-hero a:focus-visible { outline: 3px solid var(--color-primary); outline-offset: 5px; }
  @media (min-width: 1600px) { .hero-heading { grid-template-columns: minmax(0, 1fr) 300px; } }
  @media (max-width: 1050px) {
    .hero-heading { gap: 35px; grid-template-columns: minmax(0, 1fr) 255px; }
    .hero-heading h1 { font-size: clamp(44px, 6.2vw, 65px); }
    .hero-story-position { right: 22px; bottom: 22px; width: 315px; }
  }
  @media (max-width: 767px) {
    .editorial-hero { padding-top: 30px; }
    .hero-heading { grid-template-columns: 1fr; gap: 24px; padding-block: 23px 30px; }
    .hero-heading h1 { font-size: clamp(43px, 9.2vw, 64px); }
    .editorial-hero .hero-statement { font-size: 23px; }
    .editorial-hero .hero-description { max-width: 480px; font-size: 14px; }
    .hero-aside > div { flex-direction: row; flex-wrap: wrap; align-items: center; gap: 8px 20px; margin-top: 20px; }
    .hero-photo-frame { height: 310px; }
    .hero-story-position { position: relative; inset: auto; width: calc(100% - 24px); margin: -50px auto 0; }
    .hero-caption { font-size: 9px; }
  }
  @media (max-width: 639px) {
    .hero-facts > div + div { border-left: 0; border-top: 1px solid var(--color-primary-100); padding: 16px 0 0; }
  }
</style>

<script>
  import '@/scripts/solutions/editorial-hero'
</script>
