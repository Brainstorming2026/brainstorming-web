---
import { Image } from 'astro:assets'
import { Icon } from 'astro-icon/components'
import { categoriaIcons, categoriaLabels, type Proyecto } from '@/data/proyectos'
import type { ProyectoDetalle } from '@/data/proyectosDetalle'

interface Props {
  proyecto: Proyecto
  detalle: ProyectoDetalle
}

const { proyecto, detalle } = Astro.props
---

<section class="relative overflow-hidden bg-white min-h-[600px] lg:min-h-[702px] flex items-center">
  <Image
    src={detalle.heroBg}
    alt=""
    class="pointer-events-none absolute inset-0 h-full w-full object-cover"
    loading="eager"
    widths={[758, 1512]}
    sizes="100vw"
  />
  <div class="relative z-10 mx-auto grid w-full max-w-[1512px] gap-12 px-6 py-16 lg:grid-cols-2 lg:items-center lg:px-24">
    <div class="text-center">
      <div class="flex flex-col gap-3">
        {
          proyecto.categorias.map(cat => (
            <Icon name={categoriaIcons[cat]} class="h-8 w-8 text-dark-300" />
          ))
        }
      </div>

      <Image src={detalle.logo} alt={proyecto.nombre} class="mx-auto mt-6 h-auto w-40" />

      <p class="mt-6 font-heading text-[15px] font-bold text-dark">
        {proyecto.categorias.map(c => categoriaLabels[c]).join(' / ')}
      </p>
      <p class="mx-auto mt-4 max-w-[440px] text-[14px] leading-6 text-dark-500">
        {detalle.descripcion}
      </p>
    </div>

    <div class="relative">
      <Image
        src={detalle.heroImg}
        alt={detalle.heroImgAlt}
        class="relative z-10 mx-auto h-auto w-full max-w-[800px]"
        widths={[800, 1200]}
        sizes="(min-width: 1024px) 600px, 80vw"
        loading="eager"
      />
    </div>
  </div>
</section>
