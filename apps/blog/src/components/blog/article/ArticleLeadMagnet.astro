---
import type { ArticleLeadMagnet } from '@/data/articles'
import LeadMagnetCard from '@/components/blog/article/LeadMagnetCard.astro'

interface Props {
  leadMagnet: ArticleLeadMagnet
}

const { leadMagnet } = Astro.props
---

<section class="mx-auto max-w-[720px] px-5 pt-12 sm:px-6 lg:px-0">
  <div id="article-lead-magnet">
    <LeadMagnetCard leadMagnet={leadMagnet} />
  </div>
</section>

<script>
import { fadeUp, registerMotion } from '@/lib/motion'

registerMotion(() => {
  fadeUp(document.querySelectorAll('#article-lead-magnet'))
})
</script>
