---
import { Icon } from 'astro-icon/components'
import { TURNSTILE_SITE_KEY } from 'astro:env/client'
import { categories } from '@/data/posts'
---

<div id="subscribe-overlay" class="fixed inset-0 z-[60] hidden items-center justify-center bg-ink/60 px-4">
  <div id="subscribe-modal" class="relative w-full max-w-[880px] rounded-[16px] bg-mist-100 p-8 shadow-xl sm:p-10">
    <button
      type="button"
      id="subscribe-close"
      aria-label="Cerrar"
      class="absolute right-5 top-5 flex h-8 w-8 items-center justify-center rounded-full text-dark/60 transition-colors hover:text-dark"
    >
      <Icon name="close" class="h-4 w-4" />
    </button>

    <div class="grid gap-8 sm:grid-cols-2 sm:gap-10">
      <div>
        <h2 class="font-heading text-2xl font-bold leading-tight text-dark sm:text-3xl">SUSCRÍBETE A NUESTRO BRAINSTORMING BLOG</h2>
        <p class="mt-3 max-w-xs font-body text-sm text-dark/70">
          ¡Empieza a añadir valor a tu marca! Sigue nuestras publicaciones y descubre contenidos y recursos gratuitos para optimizar tus estrategias de negocio.
        </p>
      </div>

      <form id="subscribe-modal-form" class="flex flex-col gap-4">
        <div id="subscribe-modal-fields" class="flex flex-col gap-4">
          <fieldset>
            <legend class="font-body text-sm font-bold text-dark">¿Cuáles son tus temas de interés?</legend>
            <div class="mt-2 flex flex-wrap gap-x-6 gap-y-2">
              {categories.map(category => (
                <label class="flex items-center gap-2 font-body text-sm text-dark/80">
                  <input type="checkbox" name="topics" value={category.label} class="h-4 w-4 accent-primary" />
                  {category.label}
                </label>
              ))}
            </div>
          </fieldset>

          <label class="flex flex-col gap-1">
            <span class="font-heading text-sm font-bold text-dark">Dirección de correo electrónico</span>
            <div class="mt-1 flex flex-col gap-2 sm:flex-row">
              <input
                type="email"
                name="email"
                required
                class="w-full min-w-0 rounded-[10px] border border-dark-300 bg-white px-4 py-3 font-body text-sm text-dark placeholder:text-dark-400 focus:border-primary focus:outline-none"
              />
              <button
                type="submit"
                id="subscribe-modal-submit"
                class="shrink-0 rounded-[10px] bg-primary px-6 py-3 font-heading text-sm font-bold text-white transition-colors hover:bg-primary-600 disabled:cursor-not-allowed disabled:opacity-60"
              >
                Suscribirme
              </button>
            </div>
          </label>

          {TURNSTILE_SITE_KEY && (
            <div class="cf-turnstile" data-sitekey={TURNSTILE_SITE_KEY} data-size="flexible" />
          )}

          <p id="subscribe-modal-error" class="hidden font-body text-xs font-semibold text-accent-500"></p>

          <p class="font-body text-xs leading-relaxed text-dark/50">
            En Brainstorming cuidamos tu privacidad. Queremos que sepas que utilizaremos la información proporcionada únicamente para ponernos en contacto contigo y enviarte contenidos de productos, servicios y recursos de interés para ti. Si ya no deseas recibir estas comunicaciones, puedes darte de baja en cualquier momento. Obtén más información acerca de la protección de tus datos en nuestra <a href="https://brainstorming.la/politica-de-privacidad" target="_blank" rel="noopener noreferrer" class="underline hover:text-primary">Política de Privacidad</a>.
          </p>

          <label class="hidden" aria-hidden="true">
            <input type="text" name="website" tabindex="-1" autocomplete="off" />
          </label>
        </div>

        <div id="subscribe-modal-success" class="hidden flex-col items-center gap-3 py-6 text-center">
          <div class="flex h-14 w-14 items-center justify-center rounded-full bg-green-500">
            <svg viewBox="0 0 24 24" fill="none" class="h-7 w-7">
              <path d="M5 13l4 4L19 7" stroke="#fff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </div>
          <p class="font-heading text-base font-bold text-dark">¡Listo!</p>
          <p class="font-body text-sm text-dark/70">Revisa tu correo, te acabamos de escribir.</p>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
declare global {
  interface Window {
    turnstile?: { reset: (widget?: string | HTMLElement) => void }
  }
}

const overlay = document.querySelector<HTMLDivElement>('#subscribe-overlay')
const closeBtn = document.querySelector<HTMLButtonElement>('#subscribe-close')
const form = document.querySelector<HTMLFormElement>('#subscribe-modal-form')
const fields = document.querySelector<HTMLDivElement>('#subscribe-modal-fields')
const successPanel = document.querySelector<HTMLDivElement>('#subscribe-modal-success')
const errorText = document.querySelector<HTMLParagraphElement>('#subscribe-modal-error')
const submitBtn = document.querySelector<HTMLButtonElement>('#subscribe-modal-submit')
const originalLabel = submitBtn?.textContent ?? 'Suscribirme'

function openModal() {
  overlay?.classList.remove('hidden')
  overlay?.classList.add('flex')
}

function resetModal() {
  fields?.classList.remove('hidden')
  successPanel?.classList.add('hidden')
  successPanel?.classList.remove('flex')
  errorText?.classList.add('hidden')
  form?.reset()
}

function closeModal() {
  overlay?.classList.add('hidden')
  overlay?.classList.remove('flex')
  resetModal()
}

document.querySelectorAll<HTMLButtonElement>('[data-open-subscribe-modal]').forEach((btn) => {
  btn.addEventListener('click', openModal)
})

closeBtn?.addEventListener('click', closeModal)
overlay?.addEventListener('click', (event) => {
  if (event.target === overlay)
    closeModal()
})
document.addEventListener('keydown', (event) => {
  if (event.key === 'Escape')
    closeModal()
})

form?.addEventListener('submit', async (event) => {
  event.preventDefault()
  if (!form.checkValidity()) {
    form.reportValidity()
    return
  }
  if (!submitBtn)
    return

  const data = new FormData(form)
  const topics = data.getAll('topics').map(String)
  const turnstileToken = data.get('cf-turnstile-response')

  errorText?.classList.add('hidden')
  submitBtn.disabled = true
  submitBtn.textContent = 'Enviando...'

  try {
    const res = await fetch('/api/subscribe', {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({
        email: data.get('email'),
        topics: topics.length > 0 ? topics : undefined,
        website: data.get('website'),
        turnstileToken,
        source: 'Modal',
      }),
    })

    if (res.ok) {
      fields?.classList.add('hidden')
      successPanel?.classList.remove('hidden')
      successPanel?.classList.add('flex')
      setTimeout(closeModal, 2200)
    }
    else if (errorText) {
      errorText.textContent = 'No se pudo suscribir. Intenta de nuevo.'
      errorText.classList.remove('hidden')
    }
  }
  catch {
    if (errorText) {
      errorText.textContent = 'Revisa tu conexión e intenta de nuevo.'
      errorText.classList.remove('hidden')
    }
  }
  finally {
    submitBtn.disabled = false
    submitBtn.textContent = originalLabel
    window.turnstile?.reset()
  }
})
</script>
