---
import type { ImageMetadata } from 'astro'
import { Image } from 'astro:assets'

interface Props {
  /** Imagen importada (se conoce su tamaño) o URL del CMS (se infiere al construir). */
  src: ImageMetadata | string
  alt: string
  class?: string
  widths?: number[]
  sizes?: string
  loading?: 'eager' | 'lazy'
}

const { src, ...rest } = Astro.props
---

{typeof src === 'string' ? <Image src={src} inferSize {...rest} /> : <Image src={src} {...rest} />}
