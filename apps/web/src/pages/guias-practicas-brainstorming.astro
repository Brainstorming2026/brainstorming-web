---
import GuiaFilter from '@/components/guides/GuiaFilter.astro'
import GuiaHero from '@/components/guides/GuiaHero.astro'
import Layout from '@/layouts/Layout.astro'
import { getGuides } from '@/lib/guides'

export const prerender = true
const guides = await getGuides()
---

<Layout description="Descarga las guías prácticas de Brainstorming sobre marketing digital, branding, páginas web y ecommerce para tu empresa." title="Guías Prácticas — Brainstorming">
  <GuiaHero guides={guides} />
  <GuiaFilter guides={guides} />
</Layout>
