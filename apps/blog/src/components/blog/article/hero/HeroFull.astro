---
import type { Article } from '@/data/articles'
import SmartImage from '@/components/common/SmartImage.astro'
import { heroTitleClass } from '@/lib/hero-title'
import HeroBreadcrumb from './HeroBreadcrumb.astro'
import HeroByline from './HeroByline.astro'

interface Props {
  article: Article
}

const { article } = Astro.props
const titleClass = heroTitleClass(article.title)
---

<header class="relative isolate overflow-hidden bg-art-deep text-white">
  {article.heroImage && (
    <SmartImage
      src={article.heroImage}
      alt=""
      class="absolute inset-0 -z-20 h-full w-full object-cover"
      widths={[640, 960, 1440, 1920]}
      sizes="100vw"
      loading="eager"
    />
  )}
  <div class="absolute inset-0 -z-10 bg-art-deep/65" aria-hidden="true"></div>

  <div class="mx-auto flex min-h-[300px] max-w-[1140px] flex-col justify-between gap-8 px-5 pt-5 pb-7 sm:min-h-[330px] sm:px-6 lg:min-h-[350px] lg:px-16 lg:pb-9">
    <HeroBreadcrumb article={article} />
    <div>
      <p class="art-rise inline-flex rounded-full bg-art px-4 py-1.5 font-heading text-sm font-bold tracking-wide" style="--i: 1">{article.kicker || article.category}</p>
      <h1 class:list={['art-rise mt-4 max-w-[880px] font-heading leading-[1.1] font-extrabold tracking-tight', titleClass]} style="--i: 2">{article.title}</h1>
      <HeroByline article={article} class="art-rise mt-5" />
    </div>
  </div>
</header>
