---
interface Props {
  heading?: string
  whatsappText?: string
}

const {
  heading = '¿Quieres ser parte de nuestros proyectos?',
  whatsappText = 'Hola, me gustaría formar parte de sus proyectos',
} = Astro.props
---

<section class="bg-mist py-16 text-center">
  <div class="mx-auto max-w-[1512px] px-6 lg:px-24">
    <h2 class="font-heading text-[28px] font-bold text-ink sm:text-[35px]">
      {heading}
    </h2>
    <a
      href={`https://wa.me/51992528363?text=${encodeURIComponent(whatsappText)}`}
      target="_blank"
      rel="noopener noreferrer"
      class="mt-8 inline-block rounded-[10px] bg-primary px-8 py-3 font-heading text-sm font-bold text-white transition-colors hover:bg-primary-600"
    >
      CONVERSEMOS
    </a>
  </div>
</section>
