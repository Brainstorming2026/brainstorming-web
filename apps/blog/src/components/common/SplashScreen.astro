---
const SEEN_KEY = 'bs-splash-seen'
---

<script is:inline define:vars={{ SEEN_KEY }}>
  if (sessionStorage.getItem(SEEN_KEY)) {
    document.documentElement.classList.add('bs-splash-seen')
  }
</script>

<style>
  :global(html.bs-splash-seen) #splash-screen {
    display: none;
  }
</style>

<div
  id="splash-screen"
  class="fixed inset-0 z-[9999] overflow-hidden bg-white"
  transition:persist
>
  <img
    src="/Splash-Web.gif"
    alt=""
    aria-hidden="true"
    class="absolute inset-0 hidden h-full w-full object-cover md:block"
  />
  <img
    src="/GIF-B.gif"
    alt=""
    aria-hidden="true"
    class="absolute left-1/2 top-1/2 h-40 w-40 -translate-x-1/2 -translate-y-1/2 object-contain md:hidden"
  />
</div>

<script>
  import { ease } from '@/lib/motion/config'
  import { ensureGsap } from '@/lib/motion/gsap-client'
  import { prefersReducedMotion } from '@/lib/motion/reduced-motion'

  const SEEN_KEY = 'bs-splash-seen'
  /** Duración real de cada gif (81/71 frames @ 25fps) — el hold coincide con
   * el frame final en vez de cortar el loop a mitad de animación. */
  const HOLD_DESKTOP_MS = 3240
  const HOLD_MOBILE_MS = 2840
  const FADE_S = 0.6

  const splash = document.getElementById('splash-screen')
  if (splash && !sessionStorage.getItem(SEEN_KEY)) {
    document.body.style.overflow = 'hidden'
    const isDesktop = window.matchMedia('(min-width: 768px)').matches
    const holdMs = isDesktop ? HOLD_DESKTOP_MS : HOLD_MOBILE_MS

    const dismiss = () => {
      sessionStorage.setItem(SEEN_KEY, '1')
      document.body.style.overflow = ''
      splash.style.pointerEvents = 'none'
    }

    window.setTimeout(() => {
      if (prefersReducedMotion()) {
        splash.style.display = 'none'
        dismiss()
        return
      }
      const { gsap } = ensureGsap()
      gsap.set(splash, { transformOrigin: '50% 50%' })
      gsap.to(splash, {
        opacity: 0,
        scale: 1.04,
        duration: FADE_S,
        ease: ease.out,
        onComplete: () => {
          splash.style.display = 'none'
          dismiss()
        },
      })
    }, holdMs)
  } else if (splash) {
    splash.style.display = 'none'
  }
</script>
