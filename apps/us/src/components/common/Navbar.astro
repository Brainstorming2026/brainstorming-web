---
import { Image } from 'astro:assets'
import logo from '@/assets/brainstorming/logo-hd.png'
import LanguageSwitcher from '@/components/common/LanguageSwitcher.astro'
import { getLang, localizePath, useTranslations } from '@/i18n/utils'

interface Props {
  ctaHref?: string
}

const { ctaHref = '#contact' } = Astro.props
const lang = getLang(Astro.url)
const t = useTranslations(lang, 'navbar')
---

<header class="relative z-20 mx-auto grid w-full max-w-[1512px] grid-cols-[minmax(0,1fr)_auto] items-center gap-x-3 gap-y-3 px-4 py-4 sm:flex sm:justify-between sm:gap-6 sm:px-6 sm:py-6 lg:px-16">
  <a href={localizePath('/', lang)} class="min-w-0 shrink-0">
    <Image src={logo} alt="Brainstorming" class="h-auto w-full max-w-[150px] object-contain sm:h-8 sm:w-auto sm:max-w-none" widths={[150, 300, 600]} sizes="(min-width: 640px) 200px, 150px" />
  </a>

  <div class="contents sm:flex sm:shrink-0 sm:items-center sm:gap-3">
    <div class="justify-self-end">
      <LanguageSwitcher />
    </div>
    <a
      href={ctaHref}
      class="col-span-2 flex min-h-11 w-full shrink-0 items-center justify-center whitespace-nowrap rounded-lg bg-gold px-5 py-2.5 font-heading text-sm font-bold text-dark transition-transform hover:scale-[1.02] sm:w-auto sm:hover:scale-[1.03]"
    >
      {t.cta}
    </a>
  </div>
</header>
