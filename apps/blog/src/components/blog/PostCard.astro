---
import type { Post } from '@/data/posts'
import { Image } from 'astro:assets'

interface Props {
  post: Post
  showCategory?: boolean
}

const { post, showCategory = false } = Astro.props
---

<article class="flex flex-col overflow-hidden rounded-[10px] bg-mist-150">
  <a href={`/${post.slug}`} class="relative block aspect-[16/10] w-full overflow-hidden bg-mist-200">
    {post.image && (
      <Image
        src={post.image}
        alt=""
        class="h-full w-full object-cover"
        widths={[320, 480, 640]}
        sizes="(min-width: 1024px) 33vw, 90vw"
        loading="lazy"
      />
    )}
    {showCategory && (
      <span class="absolute left-3 top-3 rounded-[6px] bg-primary px-2.5 py-1 font-heading text-[11px] font-bold uppercase tracking-wide text-white">
        {post.category}
      </span>
    )}
  </a>
  <div class="flex flex-1 flex-col p-4">
    <a href={`/${post.slug}`} class="font-heading text-sm font-bold text-dark transition-colors hover:text-primary sm:text-base">
      {post.title}
    </a>
    <p class="mt-2 line-clamp-3 font-body text-sm text-dark/60">{post.excerpt}</p>
    <a href={`/${post.slug}`} class="mt-3 inline-block font-heading text-xs font-bold text-primary hover:underline">
      Leer Más &gt;&gt;
    </a>
  </div>
</article>
