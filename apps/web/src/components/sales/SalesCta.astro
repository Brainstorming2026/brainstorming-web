---
---

<section class="bg-white py-16 text-center">
  <div class="mx-auto max-w-[1512px] px-6 lg:px-24">
    <h2 id="sales-cta-headline" class="font-heading text-[28px] font-bold text-dark sm:text-[35px]">
      Convierte tu proceso comercial en un sistema predecible.
    </h2>
    <p class="mx-auto mt-4 max-w-[620px] text-[16px] leading-7 text-dark-500">
      Conversemos sobre el punto exacto donde hoy se están perdiendo tus oportunidades.
    </p>
    <div id="sales-cta-buttons" class="mt-8 flex flex-wrap items-center justify-center gap-4">
      <a
        href="https://wa.me/51992528363?text=Hola,%20me%20interesa%20Smart%20Selling"
        target="_blank"
        rel="noopener noreferrer"
        class="cta-btn inline-block rounded-[10px] bg-primary px-8 py-3 font-heading text-sm font-bold text-white transition-colors hover:bg-primary-600"
      >
        CONVERSEMOS
      </a>
      <a
        href="#casos-smart-selling"
        class="cta-btn inline-block rounded-[10px] border border-primary px-8 py-3 font-heading text-sm font-bold text-primary transition-colors hover:bg-primary/5"
      >
        VER RESULTADOS
      </a>
    </div>
  </div>
</section>

<script>
import { registerMotion, splitHeadline } from '@/lib/motion'
import { ensureGsap } from '@/lib/motion/gsap-client'
import { prefersReducedMotion } from '@/lib/motion/reduced-motion'

registerMotion(() => {
  const headline = document.getElementById('sales-cta-headline')
  const buttons = document.querySelectorAll('#sales-cta-buttons .cta-btn')
  if (headline)
    splitHeadline(headline, { by: 'words' })
  if (buttons.length === 0)
    return

  const { gsap } = ensureGsap()
  if (prefersReducedMotion()) {
    gsap.set(buttons, { clearProps: 'transform,opacity' })
    return
  }
  gsap.set(buttons, { scale: 0.9, opacity: 0 })
  gsap.to(buttons, { scale: 1, opacity: 1, duration: 0.5, ease: 'power3.out', clearProps: 'transform,opacity', stagger: 0.1, scrollTrigger: { trigger: '#sales-cta-buttons', start: 'top 90%' } })
})
</script>
