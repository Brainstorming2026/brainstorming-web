RESEND_API_KEY=
CORREO_TIPO=resend
CORREO_FROM=
CORREO_REPLY_TO=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Ambientes ────────────────────────────────────────────────────────────────
# Cada app lee .env.development (`astro dev`) y .env.production (build); en Vercel
# las variables del proyecto prevalecen. Puertos de desarrollo fijos en config/sites.mjs:
# web 4321 · us 4322 · blog 4323. Sin definir, `astro dev` apunta a localhost y el build
# a producción. Solo se definen para un entorno distinto (preview de Vercel, staging).
# WEB_URL=https://www.brainstorming.la
# US_URL=https://us.brainstorming.la
# BLOG_URL=https://blog.brainstorming.la
