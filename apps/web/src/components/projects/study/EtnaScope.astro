---
import { Image } from 'astro:assets'
import logo from '@/assets/projects/new/logos/etna.png'

interface Props { compact?: boolean }
const { compact = false } = Astro.props

const phases = [
  { number: '01', title: 'Investigar', detail: 'Categoría y competencia' },
  { number: '02', title: 'Definir', detail: 'Criterios de identidad' },
  { number: '03', title: 'Diferenciar', detail: 'Líneas de producto' },
]
---

<div class:list={['etna-scope', { 'etna-scope--compact': compact }]}>
  <header class="etna-scope__header">
    <Image src={logo} alt="ETNA" loading="eager" />
    <span>Marca / Arquitectura visual</span>
  </header>
  <div class="etna-scope__body">
    <div class="etna-scope__statement">
      <p>Mapa del proyecto</p>
      <strong>Una marca.<br /><span>Distintas líneas.</span></strong>
      <small>Un sistema de identidad pensado para expresar calidad y dar coherencia al conjunto.</small>
    </div>
    <ol class="etna-scope__phases" aria-label="Alcance del proyecto de branding">
      {phases.map(phase => <li><span>{phase.number}</span><div><strong>{phase.title}</strong><small>{phase.detail}</small></div></li>)}
    </ol>
  </div>
</div>

<style>
  .etna-scope { position: relative; overflow: hidden; padding: clamp(28px, 4.5vw, 64px); border-radius: 8px; background: radial-gradient(circle at 100% 0%, #12618a 0, transparent 36%), #073f5e; color: #fff; }
  .etna-scope__header { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 20px; padding-bottom: clamp(30px, 4vw, 52px); border-bottom: 1px solid rgb(218 239 249 / 24%); }
  .etna-scope__header img { width: clamp(116px, 13vw, 158px); height: auto; padding: 8px; border-radius: 4px; background: #fff; }
  .etna-scope__header > span, .etna-scope__statement > p { color: #cee6f2; font-size: 11px; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; }
  .etna-scope__body { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, .85fr); gap: clamp(32px, 7vw, 110px); align-items: end; padding-block: clamp(36px, 5vw, 76px); }
  .etna-scope__statement strong { display: block; margin-block: 22px 26px; font: 550 clamp(42px, 5.2vw, 76px)/1.01 var(--font-heading); letter-spacing: -.065em; }
  .etna-scope__statement strong span { color: #afd7e8; }
  .etna-scope__statement > small { display: block; max-width: 35ch; color: #d9eaf2; font-size: 16px; line-height: 1.65; }
  .etna-scope__phases { margin: 0; padding: 0; list-style: none; }
  .etna-scope__phases li { display: grid; grid-template-columns: 36px minmax(0, 1fr); gap: 16px; padding-block: 17px; border-top: 1px solid rgb(218 239 249 / 28%); }
  .etna-scope__phases li > span { padding-top: 3px; color: #afd7e8; font-size: 12px; font-variant-numeric: tabular-nums; }
  .etna-scope__phases strong { display: block; font: 550 22px/1.15 var(--font-heading); letter-spacing: -.025em; }
  .etna-scope__phases small { display: block; margin-top: 5px; color: #d9eaf2; font-size: 13px; line-height: 1.5; }
  .etna-scope--compact { display: grid; align-content: space-between; height: 100%; padding: 24px; border-radius: 0; }
  .etna-scope--compact .etna-scope__body { grid-template-columns: 1fr; padding: 0; }
  .etna-scope--compact .etna-scope__statement strong { margin: 0; font-size: 32px; }
  .etna-scope--compact .etna-scope__phases, .etna-scope--compact .etna-scope__statement > p, .etna-scope--compact .etna-scope__statement > small { display: none; }
  @media (max-width: 767px) {
    .etna-scope { padding: 28px 24px; }
    .etna-scope__header { padding-bottom: 28px; }
    .etna-scope__header > span { font-size: 10px; }
    .etna-scope__body { grid-template-columns: 1fr; gap: 32px; padding-block: 32px; }
    .etna-scope__statement strong { margin-block: 18px; font-size: clamp(36px, 10vw, 50px); }
    .etna-scope__statement > small { font-size: 15px; }
  }
</style>
