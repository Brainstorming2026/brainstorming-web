---
import SplashScreen from '@/components/common/SplashScreen.astro'
import WhatsAppButton from '@/components/common/WhatsAppButton.astro'
import { organization, ORGANIZATION_ID } from '@/data/organization'
import { getLang, localizePath, useTranslations } from '@/i18n/utils'
import '@/styles/global.css'

interface Props {
  title: string
  description?: string
  /** Error/utility pages: kept out of the index, without canonical or hreflang. */
  noindex?: boolean
}

const lang = getLang(Astro.url)
const meta = useTranslations(lang, 'meta')
const whatsapp = useTranslations(lang, 'whatsapp')
// Fallback is the localized home description, so no page ships stale copy.
const { title, description = meta.home.description, noindex = false } = Astro.props

const site = Astro.site!
const path = Astro.url.pathname.replace(/^\/es(?=\/|$)/, '') || '/'
const canonicalEn = new URL(localizePath(path, 'en'), site).href
const canonicalEs = new URL(localizePath(path, 'es'), site).href
const canonical = lang === 'es' ? canonicalEs : canonicalEn
const ogImage = new URL('/og/growth-planning-v2.jpg', site).href
const ogLocale = { en: 'en_US', es: 'es_PE' }

// Entity graph for search engines and AI answer engines: who offers what, where.
const organizationId = ORGANIZATION_ID
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    organization,
    {
      '@type': 'WebSite',
      '@id': `${site.href}#website`,
      'url': site.href,
      'name': 'Brainstorming — Growth Planning',
      'inLanguage': ['en', 'es'],
      'publisher': { '@id': organizationId },
    },
    {
      '@type': 'WebPage',
      '@id': `${canonical}#webpage`,
      'url': canonical,
      'name': title,
      'description': description,
      'inLanguage': lang,
      'isPartOf': { '@id': `${site.href}#website` },
      'about': { '@id': `${site.href}#growth-planning` },
    },
    {
      '@type': 'Service',
      '@id': `${site.href}#growth-planning`,
      'name': 'Growth Planning',
      'serviceType': meta.serviceType,
      'description': meta.home.description,
      'provider': { '@id': organizationId },
      'url': canonical,
    },
  ],
}
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Bold headings above the fold render in Nexa Black here: fetch it early to avoid a visible font swap. -->
    <link rel="preload" href="/fonts/Nexa-Black.woff2" as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
    {!noindex && (
      <>
        <link rel="canonical" href={canonical} />
        <link rel="alternate" hreflang="en" href={canonicalEn} />
        <link rel="alternate" hreflang="es" href={canonicalEs} />
        <link rel="alternate" hreflang="x-default" href={canonicalEn} />
      </>
    )}
    <link rel="icon" href="/favicon.ico?v=2" sizes="48x48" />
    <link rel="icon" type="image/png" href="/brainstorming-icon-file.png?v=2" />
    <link rel="apple-touch-icon" href="/brainstorming-icon-file.png?v=2" />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Brainstorming" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale[lang]} />
    <meta property="og:locale:alternate" content={ogLocale[lang === 'es' ? 'en' : 'es']} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={meta.ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={meta.ogImageAlt} />

    {!noindex && <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />}
  </head>
  <body class="font-body text-dark">
    <SplashScreen />
    <slot />
    <WhatsAppButton message={whatsapp.message} />
  </body>
</html>
