---
import type { Post } from '@/data/posts'
import PostCard from '@/components/blog/PostCard.astro'

interface Props {
  posts: Post[]
}

const { posts } = Astro.props
---

{posts.length > 0 && (
  <section class="mx-auto max-w-[1140px] px-6 pb-16 lg:px-16">
    <h2 class="font-heading text-xl font-bold text-dark">Creemos que también te puede interesar:</h2>
    <div class="mt-6 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {posts.map(post => <PostCard post={post} showCategory />)}
    </div>
  </section>
)}
