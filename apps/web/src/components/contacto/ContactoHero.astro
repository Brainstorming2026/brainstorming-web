---
import { Image } from 'astro:assets'
import conversation from '@/assets/growth-planning/contact-creative-conversation.png'
---

<section class="contact-hero" aria-labelledby="contact-heading">
  <div class="hero-inner">
    <div class="hero-copy">
      <p class="eyebrow">Brainstorming / Contacto</p>
      <h1 id="contact-heading">Las buenas ideas<br />empiezan <em>conversando.</em></h1>
      <p class="intro">Cuéntanos qué quieres lograr. Encontraremos juntos el siguiente paso para tu negocio.</p>
      <a class="hero-link" href="#contacto-form">Conversemos <span aria-hidden="true">↗</span></a>
    </div>
    <div class="hero-photo">
      <Image src={conversation} alt="Dos profesionales conversan sobre propuestas creativas en una mesa de trabajo." widths={[640, 960, 1536]} sizes="(min-width: 900px) 65vw, 100vw" format="webp" quality={85} loading="eager" fetchpriority="high" />
    </div>
  </div>
  <svg class="hero-curve" viewBox="0 0 1440 64" preserveAspectRatio="none" aria-hidden="true"><path d="M0 42C360 88 970 -26 1440 22V64H0Z" fill="white" /></svg>
</section>

<style>
  .contact-hero { position: relative; overflow: hidden; background: #e8ecf3; }
  .hero-inner { max-width: 1440px; margin: auto; position: relative; }
  .hero-copy { position: relative; z-index: 2; padding: 42px 24px 20px; }
  .eyebrow { color: #6742ac; font-size: 11px; font-weight: 700; letter-spacing: .17em; text-transform: uppercase; }
  h1 { margin: 20px 0; color: #26222c; font-size: clamp(36px, 5vw, 62px); font-weight: 650; line-height: 1.08; letter-spacing: -.045em; }
  h1 em { color: #713cce; font-family: Georgia, serif; font-weight: 400; }
  .intro { max-width: 370px; color: #525260; font-size: 16px; line-height: 1.7; }
  .hero-link { display: inline-flex; align-items: center; gap: 28px; min-height: 44px; margin-top: 18px; color: #40216c; font-size: 14px; font-weight: 600; border-bottom: 1px solid #9f8bbd; }
  .hero-link span { transition: transform .2s ease; }
  .hero-link:hover span { transform: translate(3px,-3px); }
  .hero-link:focus-visible { outline: 2px solid #713cce; outline-offset: 5px; }
  .hero-photo { height: 240px; overflow: hidden; }
  .hero-photo img { width: 100%; height: 100%; object-fit: cover; object-position: right 48%; }
  .hero-curve { position: absolute; z-index: 3; bottom: -1px; left: 0; width: 100%; height: 34px; pointer-events: none; }
  @media (min-width: 600px) and (max-width: 899px) { .hero-photo { height: 300px; } }
  @media (min-width: 900px) {
    .hero-inner { min-height: 450px; display: flex; align-items: center; }
    .hero-copy { width: 57%; padding: 58px 0 76px 6%; }
    .hero-photo { position: absolute; inset: 0 0 0 auto; width: 68%; height: 100%; }
    .hero-photo::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg,#e8ecf3 0%,transparent 35%); }
    .hero-curve { height: 48px; }
  }
  @media (prefers-reduced-motion: reduce) { .hero-link span { transition: none; } }
</style>
