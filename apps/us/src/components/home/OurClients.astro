---
import { Image } from 'astro:assets'
import { clientLogos } from '@/data/clients'
import { getLang, useTranslations } from '@/i18n/utils'

const lang = getLang(Astro.url)
const t = useTranslations(lang, 'clients')
---

<section class="relative bg-white py-16 lg:py-20" aria-labelledby="clients-headline">
  <div class="pointer-events-none absolute inset-x-0 top-0 h-20 bg-gradient-to-b from-mist-200 to-white lg:h-28" aria-hidden="true"></div>

  <div class="relative mx-auto max-w-9xl px-6 lg:px-16">
    <h2 id="clients-headline" class="text-center font-heading text-3xl font-normal text-dark sm:text-4xl">{t.headline}</h2>

    <!-- 24 logos: full rows at 3, 4 and 6 columns. Width scales down on phones (--logo-w is the sm+ size). -->
    <ul id="clients-grid" class="mx-auto mt-10 grid max-w-6xl list-none grid-cols-3 gap-x-4 gap-y-2 p-0 sm:mt-12 sm:grid-cols-4 sm:gap-x-8 lg:grid-cols-6" role="list">
      {
        clientLogos.map(client => (
          <li class="flex h-20 items-center justify-center sm:h-24 lg:h-28">
            <Image
              src={client.image}
              alt={client.name}
              widths={[client.width, client.width * 2]}
              sizes={`${client.width}px`}
              quality={85}
              loading="lazy"
              style={`--logo-w: ${client.width}px`}
              class="client-logo h-auto max-h-14 w-[calc(var(--logo-w)*0.72)] max-w-full object-contain sm:max-h-16 sm:w-(--logo-w)"
            />
          </li>
        ))
      }
    </ul>

    <p id="clients-tagline" class="mt-10 text-center font-heading text-lg font-bold text-balance text-navy sm:mt-12 sm:text-xl">
      {t.tagline}
    </p>
  </div>
</section>

<script>
import { ensureGsap, registerMotion, splitHeadline, staggerGrid } from '@/lib/motion'
import { prefersReducedMotion } from '@/lib/motion/reduced-motion'

registerMotion(() => {
  const headline = document.getElementById('clients-headline')
  const logos = document.querySelectorAll('#clients-grid .client-logo')
  const tagline = document.getElementById('clients-tagline')
  const { gsap } = ensureGsap()

  if (headline)
    splitHeadline(headline, { by: 'words' })
  staggerGrid(logos, { variant: 'wipe' })

  if (tagline) {
    if (prefersReducedMotion()) {
      gsap.fromTo(tagline, { opacity: 0 }, { opacity: 1, duration: 0.4 })
    }
    else {
      gsap.set(tagline, { opacity: 0, y: 12 })
      gsap.to(tagline, { opacity: 1, y: 0, duration: 0.7, ease: 'power2.out', scrollTrigger: { trigger: tagline, start: 'top 90%' } })
    }
  }
})
</script>
