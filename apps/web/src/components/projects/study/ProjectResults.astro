---
import type { NewProject } from '@/data/new-projects'
import { Image } from 'astro:assets'
import salesSource from '@/assets/projects/new/ait-capital/sales-source.webp'

interface Props { project: NewProject }
const { project } = Astro.props
const metrics = project.results.metrics
const leadIndex = project.slug === 'ait-capital' ? 2 : 0
const lead = metrics?.[leadIndex]
const supporting = metrics?.filter((_, index) => index !== leadIndex)
---

<section class="case-results study-container" id="resultados" aria-labelledby="case-results-title">
  <header class="result-heading"><p>El impacto del trabajo</p><h2 id="case-results-title">Lo que cambió.</h2></header>
  {lead && supporting
? (
    <div class="result-board">
      <div class="result-featured">
        <span class="result-label">{lead.label}</span>
        <strong>{lead.value}</strong>
        {lead.before && <p class="result-baseline">Desde <span>{lead.before}</span></p>}
        {lead.note && <p class="result-note">{lead.note}</p>}
        <div class="result-rule" aria-hidden="true"></div>
        <p class="result-context">{project.slug === 'ait-capital' ? 'Cuatro meses de evolución comercial.' : 'Volver a conectar con una base que ya había mostrado interés.'}</p>
      </div>
      <dl class="result-support">
        {supporting.map(metric => (
          <div><dt>{metric.label}</dt><dd><strong>{metric.value}</strong>{metric.before && <span>Antes: {metric.before}</span>}{metric.note && <small>{metric.note}</small>}</dd></div>
        ))}
      </dl>
      <p class="result-board-note">{project.slug === 'ait-capital' ? 'Facturación en soles. Evolución en cuatro meses; reuniones y cierres expresados por mes.' : 'Reactivación, conversión e ingresos son indicadores independientes del proyecto.'}</p>
    </div>
  )
: (
    <div class="result-outcomes"><p>{project.results.summary}</p><ol>{project.results.outcomes?.map((outcome, index) => <li><span>0{index + 1}</span><strong>{outcome}</strong></li>)}</ol></div>
  )}

  {project.slug === 'ait-capital' && (
    <details class="result-document">
      <summary><span>La evidencia del proyecto</span><strong>Explorar el gráfico original de ventas <span aria-hidden="true">↗</span></strong></summary>
      <div class="result-document-content">
        <div><h3>La progresión registrada.</h3><p>La presentación muestra cuatro registros de 2024: junio, octubre, noviembre y diciembre. El pie original atribuye la serie a las ventas de Rafael.</p><dl><div><dt>Junio</dt><dd>1</dd></div><div><dt>Octubre</dt><dd>2</dd></div><div><dt>Noviembre</dt><dd>5</dd></div><div><dt>Diciembre</dt><dd>11</dd></div></dl><small>Smart Selling 2026 · página 12</small></div>
        <Image src={salesSource} alt="Gráfico original de ventas de Rafael: junio 1, octubre 2, noviembre 5 y diciembre 11; incluye el desglose por producto." widths={[600, 1000, 1500]} sizes="(min-width: 900px) 620px, 90vw" loading="lazy" />
      </div>
    </details>
  )}
</section>

<style>
  .case-results { padding-block: clamp(56px, 7vw, 96px) 24px; }
  .result-heading { margin-bottom: 32px; }
  .result-heading > p { color: var(--study-muted); font-size: 11px; letter-spacing: .15em; text-transform: uppercase; }
  .result-heading h2 { margin-top: 16px; font: 600 clamp(34px, 4vw, 54px)/1.06 var(--font-heading); letter-spacing: -.045em; }
  .result-board { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: 0 clamp(32px, 7vw, 100px); padding: clamp(26px, 5vw, 64px); border-radius: 8px; background: var(--study-accent); color: #fff; }
  .result-featured { display: flex; flex-direction: column; align-items: flex-start; justify-content: center; min-width: 0; }
  .result-label { max-width: 30ch; font-size: 13px; color: #e1e8fb; line-height: 1.5; }
  .result-featured > strong { margin-top: 24px; font: 500 clamp(54px, 7.5vw, 104px)/1 var(--font-heading); letter-spacing: -.07em; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .result-baseline { margin-top: 20px; color: #e1e8fb; font-size: 14px; }
  .result-baseline span { color: #fff; font-weight: 600; }
  .result-note { margin-top: 12px; color: #e1e8fb; font-size: 13px; }
  .result-rule { width: 52px; height: 2px; margin-block: 30px 20px; background: #bfcaf5; }
  .result-context { max-width: 30ch; color: #e1e8fb; font-size: 16px; line-height: 1.55; }
  .result-support { display: grid; margin: 0; }
  .result-support > div { padding-block: 27px; border-top: 1px solid rgb(255 255 255 / 27%); }
  .result-support dt { font-size: 13px; line-height: 1.5; color: #e1e8fb; }
  .result-support dd { display: flex; flex-wrap: wrap; align-items: baseline; gap: 8px 22px; margin: 16px 0 0; }
  .result-support strong { font: 500 clamp(42px, 5vw, 68px)/1 var(--font-heading); letter-spacing: -.06em; }
  .result-support dd > span, .result-support small { font-size: 12px; color: #e1e8fb; }
  .result-board-note { grid-column: 1/-1; margin-top: 32px; padding-top: 18px; border-top: 1px solid rgb(255 255 255 / 27%); color: #e1e8fb; font-size: 11px; line-height: 1.6; }
  .result-outcomes { display: grid; grid-template-columns: 1fr 1.1fr; gap: clamp(30px, 6vw, 90px); }
  .result-outcomes > p { max-width: 44ch; color: var(--study-muted); font-size: 17px; line-height: 1.8; }
  .result-outcomes ol { margin: 0; padding: 0; list-style: none; }
  .result-outcomes li { display: grid; grid-template-columns: 28px 1fr; gap: 16px; padding-block: 24px; border-top: 1px solid var(--study-line); }
  .result-outcomes li span { padding-top: 5px; color: var(--study-accent); font-size: 10px; }
  .result-outcomes li strong { font: 500 clamp(21px, 2.5vw, 30px)/1.2 var(--font-heading); letter-spacing: -.025em; }
  .result-document { margin-top: 28px; border-bottom: 1px solid #daddec; }
  .result-document summary { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px; min-height: 60px; padding-block: 20px; cursor: pointer; list-style: none; }
  .result-document summary::-webkit-details-marker { display: none; }
  .result-document summary > span { color: #61657c; font-size: 12px; }
  .result-document summary strong { color: #151954; font-size: 13px; font-weight: 500; }
  .result-document summary:focus-visible { outline: 2px solid var(--study-accent); outline-offset: 4px; }
  .result-document-content { display: grid; grid-template-columns: .8fr 1.2fr; gap: 40px; align-items: center; padding-block: 30px; }
  .result-document-content h3 { margin-bottom: 20px; font: 500 30px/1.15 var(--font-heading); letter-spacing: -.03em; }
  .result-document-content p { color: #61657c; font-size: 14px; line-height: 1.8; }
  .result-document-content img { width: 100%; height: auto; border-radius: 6px; }
  .result-document-content dl { display: flex; flex-wrap: wrap; gap: 24px; margin-block: 24px; }
  .result-document-content dt { color: #61657c; font-size: 11px; }
  .result-document-content dd { margin: 8px 0 0; font-size: 26px; }
  .result-document-content small { color: #61657c; font-size: 10px; }
  @media(max-width: 767px) {
    .result-board, .result-outcomes, .result-document-content { grid-template-columns: 1fr; }
    .result-support { margin-top: 32px; }
    .result-featured > strong { font-size: clamp(48px, 12vw, 84px); }
  }
</style>
