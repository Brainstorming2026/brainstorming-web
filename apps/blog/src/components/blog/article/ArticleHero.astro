---
import type { Article } from '@/data/articles'
import HeroCentered from './hero/HeroCentered.astro'
import HeroFull from './hero/HeroFull.astro'
import HeroSplit from './hero/HeroSplit.astro'

interface Props {
  article: Article
}

const { article } = Astro.props
const style = article.heroStyle ?? 'full'
---

{/* Único lugar que conoce los estilos de portada: cada uno es un componente que recibe el mismo artículo. */}
{style === 'full' && <HeroFull article={article} />}
{style === 'split' && <HeroSplit article={article} />}
{style === 'centered' && <HeroCentered article={article} />}
