---
import { Icon } from 'astro-icon/components'
import { benefits } from '@/data/innovation-content'
---

<section class="in-benefits service-container" aria-labelledby="in-benefits-title"><div><span class="in-label">LO QUE QUEDA EN TU EMPRESA</span><h2 id="in-benefits-title" data-in-heading>Un nuevo negocio.<br /><span class="in-accent">Una nueva capacidad.</span></h2><p>El valor continúa después del lanzamiento.</p></div><ul>{benefits.map(item => <li><span class="in-benefit-icon"><Icon name={`automation/${item.icon}`} class="in-icon" /></span>{item.text}</li>)}</ul></section>
