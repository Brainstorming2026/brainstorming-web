---
import { getImage, Image } from 'astro:assets'
import heroBg from '@/assets/nosotros/nosotros-hero-desktop-hd.png'
import heroMobileBg from '@/assets/nosotros/nosotros-hero-mobile.png'

const heroMobileWebp = await getImage({
  src: heroMobileBg,
  width: 1080,
  height: 1920,
  format: 'webp',
  quality: 92,
})
---

<section
  class="relative h-[calc(100svh-5rem)] min-h-[620px] max-h-[900px] overflow-hidden bg-indigo lg:h-[calc(100vh-5rem)] lg:max-h-none"
>
  <picture>
    <source media="(max-width: 1023px)" srcset={heroMobileWebp.src} type="image/webp" />
    <Image
      id="about-hero-bg"
      src={heroBg}
      alt=""
      class="pointer-events-none absolute inset-0 h-full w-full object-cover object-center"
      loading="eager"
      fetchpriority="high"
    />
  </picture>
  <div
    class="relative z-10 mx-auto flex h-full max-w-[1512px] items-end px-6 pb-12 pt-24 sm:px-10 sm:pb-16 lg:items-center lg:justify-end lg:px-24 lg:py-0"
  >
    <div class="w-full max-w-[560px] lg:max-w-[480px]">
      <h1 id="about-hero-headline" class="font-heading text-[clamp(2.75rem,12vw,4rem)] font-bold leading-[0.98] text-white lg:text-[55px] lg:leading-tight">
        ¿Quiénes<br />Somos?
      </h1>
      <div id="about-hero-line" class="mt-5 h-[3px] w-12 bg-white"></div>
      <p id="about-hero-text" class="mt-5 max-w-[34rem] text-[16px] leading-[1.65] text-white sm:text-[18px] lg:mt-6 lg:max-w-none lg:text-[16px] lg:leading-relaxed lg:text-white/90">
        Somos una consultora de servicio completo en constante innovación, que
        diseña soluciones digitales centradas en el consumidor para optimizar
        pequeñas y grandes empresas.
      </p>
    </div>
  </div>
</section>

<script>
import { drawLine, ensureGsap, registerMotion, splitHeadline } from '@/lib/motion'

registerMotion(() => {
  const bg = document.getElementById('about-hero-bg')
  const headline = document.getElementById('about-hero-headline')
  const line = document.getElementById('about-hero-line')
  const text = document.getElementById('about-hero-text')
  const { gsap } = ensureGsap()

  // Oculto YA (no recién cuando termine el titular) — evita el flash de
  // contenido visible antes de animar.
  if (line) gsap.set(line, { scaleX: 0, transformOrigin: '0% 50%' })
  if (text) gsap.set(text, { opacity: 0, y: 10 })

  if (headline) splitHeadline(headline, { by: 'words', scrollTrigger: false, onComplete: () => {
    if (line) drawLine(line)
    if (text) gsap.to(text, { opacity: 1, y: 0, duration: 0.5 })
  } })

  if (bg) gsap.fromTo(bg, { scale: 1 }, { scale: 1.06, duration: 8, ease: 'none' })
})
</script>
