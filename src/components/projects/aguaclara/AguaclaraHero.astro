---
import { Image } from 'astro:assets'
import { Icon } from 'astro-icon/components'
import logoAguaclara from '@/assets/clientes/customer-aguaclara.webp'
import heroBg from '@/assets/projects/proyecto-aguaclara-bg.png'
import heroImg from '@/assets/projects/proyecto-aguaclara-herp.png'
import { categoriaLabels, proyectos } from '@/data/proyectos'

const proyecto = proyectos.find(p => p.slug === 'aguaclara')!

const iconMap = {
  'branding': 'expert-huella',
  'desarrollo-web': 'expert-window',
  'inbound-marketing': 'expert-iman',
  'inbound-sales': 'expert-money',
} as const
---

<section class="relative flex min-h-screen items-center overflow-hidden bg-white py-28 lg:py-32">
  <Image
    src={heroBg}
    alt=""
    class="pointer-events-none absolute inset-0 h-full w-full object-cover"
    loading="eager"
    widths={[758, 1512]}
    sizes="100vw"
  />
  <div class="relative z-10 mx-auto grid w-full max-w-[1512px] gap-12 px-6 lg:grid-cols-2 lg:items-center lg:px-24">
    <div>
      <div class="flex flex-col gap-3">
        {
          proyecto.categorias.map(cat => (
            <Icon name={iconMap[cat]} class="h-7 w-7 text-dark-300" />
          ))
        }
      </div>

      <Image src={logoAguaclara} alt="Aguaclara" class="mx-auto mt-8 h-auto w-44" />

      <p class="mt-8 font-heading text-[15px] font-bold text-dark">
        {proyecto.categorias.map(c => categoriaLabels[c]).join(' / ')}
      </p>
      <p class="mt-4 max-w-[440px] text-[14px] leading-6 text-dark-500">
        Aguaclara Swimwear es una empresa dedicada al diseño, fabricación y comercialización de
        prendas de baño de lujo para damas. Sus diseños se inspiran en raíces culturales y
        naturales amazónicas. Necesitaban atraer más clientes a su página web, la cual necesitaba
        una renovación completa.
      </p>
    </div>

    <div class="relative">
      <Image
        src={heroImg}
        alt="Publicaciones de Instagram de Aguaclara con descuentos promocionales"
        class="relative z-10 mx-auto h-auto w-full max-w-[420px]"
        widths={[420, 840]}
        sizes="(min-width: 1024px) 420px, 80vw"
        loading="eager"
      />
    </div>
  </div>
</section>
