---
import Layout from '@/layouts/Layout.astro'

export const prerender = true
---

<Layout title="Página no encontrada — Brainstorming Blog">
  <section class="mx-auto flex min-h-[50vh] max-w-[720px] flex-col items-center justify-center px-6 py-20 text-center">
    <p class="font-heading text-sm font-bold uppercase tracking-wide text-primary">404</p>
    <h1 class="mt-3 font-heading text-2xl font-bold text-dark sm:text-3xl">No encontramos este artículo</h1>
    <p class="mt-3 font-body text-sm text-dark/60">Puede que se haya movido o ya no esté disponible.</p>
    <a
      href="/"
      class="mt-6 inline-block rounded-[10px] bg-primary px-6 py-3 font-heading text-sm font-bold text-white transition-colors hover:bg-primary-600"
    >
      Volver al blog
    </a>
  </section>
</Layout>
