---
import type { Article } from '@/data/articles'
import { Image } from 'astro:assets'

interface Props {
  article: Article
}

const { article } = Astro.props
---

<header class="bg-mist-100">
  <div class="mx-auto max-w-[1140px] px-6 py-12 lg:px-16 lg:py-16">
    <div class="grid gap-8 lg:grid-cols-2 lg:items-center lg:gap-16">
      <div id="article-hero-text">
        <p class="font-heading text-sm font-bold text-primary">{article.kicker}</p>
        <h1 class="mt-3 font-heading text-3xl font-bold leading-[1.15] text-dark sm:text-4xl">
          {article.title}
        </h1>
      </div>

      <div id="article-hero-image" class="relative">
        <div class="absolute -inset-4 -z-10 rounded-[24px] bg-primary/90"></div>
        <Image
          src={article.heroImage}
          alt={article.title}
          class="w-full rounded-[16px] object-cover shadow-lg"
          widths={[480, 720, 960]}
          sizes="(min-width: 1024px) 520px, 90vw"
          loading="eager"
        />
      </div>
    </div>

    <p class="mt-10 font-heading text-sm font-bold uppercase tracking-wide text-primary">{article.readTime}</p>
    <div class="mt-4 flex max-w-[880px] flex-col gap-4">
      {article.intro.map(paragraph => (
        <p class="font-body text-[15px] leading-relaxed text-dark/80">{paragraph}</p>
      ))}
    </div>
  </div>
</header>

<script>
import { registerMotion, revealClip } from '@/lib/motion'

registerMotion(() => {
  const text = document.querySelector<HTMLElement>('#article-hero-text')
  const image = document.querySelector<HTMLElement>('#article-hero-image')
  if (text)
    revealClip(text, { direction: 'left', scrollTrigger: false })
  if (image)
    revealClip(image, { direction: 'right', scrollTrigger: false, parallax: true })
})
</script>
