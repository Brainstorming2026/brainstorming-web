---
import { aboutContent } from '@/data/transversal-content'

const { title, paragraphs, contrast } = aboutContent.introduction
const [consultancy, partnership] = paragraphs
---

<section class="about-intro" aria-labelledby="who-we-are-title">
  <div class="editorial-container">
    <h2 id="who-we-are-title" class="intro-label">{title}</h2>
    <div class="intro-layout">
      <p class="intro-statement" aria-label="Somos el socio estratégico">
        <span class="intro-mask" aria-hidden="true"><span>Somos el socio</span></span>
        <span class="intro-mask" aria-hidden="true"><span class="intro-accent">estratégico.</span></span>
      </p>
      <div class="intro-copy">
        <p>{consultancy}</p>

        <!-- El contraste del briefing §11.2. Cada negación se tacha al entrar
             en pantalla: primero se descarta lo que NO somos, y recién después
             aterriza la afirmación. La raya es decorativa; el texto se lee
             completo en cualquier caso. -->
        <ul class="intro-contrast" data-intro-contrast>
          {contrast.map(item => (
            <li>
              <span class="contrast-text">No somos {item}.</span>
              <span class="contrast-strike" aria-hidden="true"></span>
            </li>
          ))}
        </ul>

        <p class="intro-affirmation" data-intro-affirmation>{partnership}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .about-intro { padding-block: clamp(64px, 8vw, 120px); background: white; }
  .intro-label { font-size: 14px; font-weight: 500; color: var(--color-primary-700); margin-bottom: 36px; }
  .intro-layout { display: grid; grid-template-columns: 1.1fr 1fr; gap: clamp(40px, 7vw, 100px); }
  .intro-statement { font: 500 clamp(40px, 4.5vw, 68px)/1.08 var(--font-heading); letter-spacing: -.055em; }
  .intro-mask { display: block; overflow: hidden; padding-bottom: .12em; margin-bottom: -.12em; }
  .intro-mask > span { display: block; }
  .intro-accent { color: var(--color-primary); }
  .intro-copy { max-width: 58ch; font-size: clamp(17px, 1.35vw, 20px); line-height: 1.7; color: var(--color-gray-body); }
  .intro-copy > p + p { margin-top: 24px; }

  .intro-contrast { margin-top: 28px; display: flex; flex-direction: column; gap: 10px; }
  .intro-contrast li { position: relative; display: inline-block; width: fit-content; font-family: var(--font-heading); font-size: clamp(20px, 1.7vw, 26px); font-weight: 600; letter-spacing: -.03em; line-height: 1.25; color: #9aa0ac; }
  .contrast-strike { position: absolute; left: 0; top: 55%; width: 100%; height: 2px; transform: scaleX(0); transform-origin: 0 50%; background: var(--color-primary); }

  .intro-affirmation { margin-top: 30px; padding-top: 26px; border-top: 1px solid var(--color-mist-200); font-family: var(--font-heading); font-size: clamp(19px, 1.5vw, 24px); font-weight: 600; line-height: 1.45; letter-spacing: -.025em; color: var(--color-ink, #182744); }

  @media (max-width: 767px) {
    .intro-layout { grid-template-columns: 1fr; gap: 32px; }
    .intro-label { margin-bottom: 24px; }
    .intro-statement { font-size: clamp(38px, 8.5vw, 60px); }
  }
  /* Sin movimiento la raya debe existir igual: si no, la negación se lee como
     una afirmación. */
  @media (prefers-reduced-motion: reduce) {
    .contrast-strike { transform: scaleX(1); }
  }
</style>

<script>
import { ensureGsap, registerMotion } from '@/lib/motion'

registerMotion(() => {
  const root = document.querySelector('.about-intro')
  if (!root)
    return
  const { gsap } = ensureGsap()
  const media = gsap.matchMedia()

  media.add('(prefers-reduced-motion: no-preference)', () => {
    const contrast = root.querySelector<HTMLElement>('[data-intro-contrast]')
    const affirmation = root.querySelector<HTMLElement>('[data-intro-affirmation]')

    const timeline = gsap.timeline({
      defaults: { duration: 0.95, ease: 'power3.out' },
      scrollTrigger: { trigger: root, start: 'top 78%', once: true },
    })

    timeline
      .from(root.querySelector('.intro-label'), { autoAlpha: 0, y: 12 }, 0)
      .from(root.querySelectorAll('.intro-mask > span'), { yPercent: 115, stagger: 0.12 }, 0.08)
      // :not(...) excluye la afirmación, que tiene su propio from() más abajo.
      // Dos from() sobre el mismo elemento se pisan: el segundo toma como
      // destino el autoAlpha:0 del primero y el texto no vuelve a aparecer.
      .from(root.querySelectorAll('.intro-copy > p:not([data-intro-affirmation])'), { autoAlpha: 0, y: 24, stagger: 0.13 }, 0.22)

    if (contrast) {
      // Cada negación entra y se tacha antes de que aparezca la siguiente.
      timeline.from(contrast.querySelectorAll('li'), {
        autoAlpha: 0,
        x: -18,
        duration: 0.6,
        stagger: 0.28,
      }, 0.45)
      timeline.to(contrast.querySelectorAll('.contrast-strike'), {
        scaleX: 1,
        duration: 0.45,
        stagger: 0.28,
        ease: 'expo.out',
      }, 0.72)
      timeline.to(contrast.querySelectorAll('li'), {
        color: '#c2c7d0',
        duration: 0.45,
        stagger: 0.28,
      }, 0.72)
    }

    if (affirmation) {
      // Aterriza recién cuando las dos negaciones ya están descartadas.
      timeline.from(affirmation, { autoAlpha: 0, y: 26, duration: 0.85, ease: 'expo.out' }, 1.45)
    }
  })
})
</script>
