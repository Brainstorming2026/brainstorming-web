---
import { Image } from 'astro:assets'
import { Icon } from 'astro-icon/components'
import type { ProyectoFeature } from '@/data/proyectosDetalle'

interface Props {
  feature: ProyectoFeature
}

const { feature } = Astro.props
const imagenPrimero = (feature.imagenLado ?? 'izquierda') === 'izquierda'
const textoClaro = feature.textoClaro ?? false
---

<section class="relative overflow-hidden bg-white lg:py-20">
  <Image
    src={feature.bgImagen}
    alt=""
    class="pointer-events-none absolute inset-0 h-full w-full object-cover object-top"
    loading="lazy"
    widths={[758, 1512]}
    sizes="100vw"
  />
  <div class="feature-root relative z-10 mx-auto grid max-w-[1512px] gap-12 px-6 lg:grid-cols-2 lg:items-center lg:px-24" data-img-dir={imagenPrimero ? 'left' : 'right'} data-text-from={imagenPrimero ? '24' : '-24'}>
    {
      imagenPrimero && (
        <div class="feature-img-wrap mx-auto h-auto w-full max-w-[520px] overflow-hidden">
          <Image
            src={feature.imagen}
            alt={feature.imagenAlt}
            class="feature-img h-auto w-full"
            widths={[520, 1040]}
            sizes="(min-width: 1024px) 520px, 90vw"
            loading="lazy"
          />
        </div>
      )
    }

    <div class="feature-text">
      <div class:list={['flex items-center gap-2 font-heading text-sm font-bold', textoClaro ? 'text-white' : 'text-dark']}>
        <Icon name={feature.icon} class:list={['h-6 w-6', textoClaro ? 'text-white/70' : 'text-dark-300']} />
        <span>{feature.label}</span>
      </div>
      <h2 class:list={['mt-4 max-w-[520px] font-heading text-3xl font-bold leading-tight sm:text-7xl', textoClaro ? 'text-white' : 'text-dark']}>
        {feature.heading}
      </h2>
      {
        feature.parrafos.map((parrafo, i) => (
          <p class:list={['max-w-[440px] text-[14px] leading-6 text-dark-500', i === 0 ? 'mt-6' : 'mt-4']}>
            {parrafo}
          </p>
        ))
      }
    </div>

    {
      !imagenPrimero && (
        <div class="feature-img-wrap mx-auto h-auto w-full max-w-[520px] overflow-hidden">
          <Image
            src={feature.imagen}
            alt={feature.imagenAlt}
            class="feature-img h-auto w-full"
            widths={[520, 1040]}
            sizes="(min-width: 1024px) 520px, 90vw"
            loading="lazy"
          />
        </div>
      )
    }
  </div>
</section>

<script>
import { registerMotion, revealClip } from '@/lib/motion'
import { ensureGsap } from '@/lib/motion/gsap-client'
import { prefersReducedMotion } from '@/lib/motion/reduced-motion'

registerMotion(() => {
  const { gsap } = ensureGsap()

  // Un solo script cubre TODAS las instancias de ProjectFeature en la página
  // (Astro deduplica el <script>, así que iteramos igual que ProyectosList).
  document.querySelectorAll<HTMLElement>('.feature-root').forEach((root) => {
    const imgWrap = root.querySelector<HTMLElement>('.feature-img-wrap')
    const img = root.querySelector<HTMLElement>('.feature-img')
    const text = root.querySelector<HTMLElement>('.feature-text')
    const imgDir = root.dataset.imgDir === 'right' ? 'right' : 'left'
    const textFrom = Number(root.dataset.textFrom ?? 24)

    if (imgWrap) revealClip(imgWrap, { direction: imgDir })

    if (img && !prefersReducedMotion()) {
      gsap.fromTo(img, { scale: 1.15 }, { scale: 1, duration: 1.5, ease: 'power2.out', scrollTrigger: { trigger: root, start: 'top 85%' } })
    }

    if (text) {
      if (prefersReducedMotion()) {
        gsap.fromTo(text, { opacity: 0 }, { opacity: 1, duration: 0.4 })
      }
      else {
        // El texto entra desde el lado contrario a la imagen — refuerza la
        // composición en vez de que todo llegue desde el mismo lado.
        gsap.set(text, { opacity: 0, x: textFrom })
        gsap.to(text, { opacity: 1, x: 0, duration: 1.0, ease: 'power2.out', delay: 0.15, scrollTrigger: { trigger: root, start: 'top 85%' } })
      }
    }
  })
})
</script>
