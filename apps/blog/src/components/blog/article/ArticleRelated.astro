---
import type { Post } from '@/data/posts'
import PostCard from '@/components/blog/PostCard.astro'

interface Props {
  posts: Post[]
}

const { posts } = Astro.props
---

{posts.length > 0 && (
  <section class="mx-auto max-w-[1140px] px-5 pb-16 sm:px-6 lg:px-16">
    <h2 class="font-heading text-2xl font-extrabold text-dark">Creemos que también te puede interesar:</h2>
    <div id="article-related-grid" class="mt-6 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {posts.map(post => <PostCard post={post} showCategory />)}
    </div>
  </section>
)}

<script>
import { registerMotion, staggerGrid } from '@/lib/motion'

registerMotion(() => {
  staggerGrid(document.querySelectorAll('#article-related-grid > *'))
})
</script>
