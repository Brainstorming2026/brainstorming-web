---
import type { Article } from '@/data/articles'
import SmartImage from '@/components/common/SmartImage.astro'
import { heroTitleClass } from '@/lib/hero-title'
import HeroBreadcrumb from './HeroBreadcrumb.astro'
import HeroByline from './HeroByline.astro'

interface Props {
  article: Article
}

const { article } = Astro.props
const titleClass = heroTitleClass(article.title)
---

<header class="bg-art-deep text-white">
  <div class="mx-auto max-w-[1140px] px-5 pt-5 pb-8 sm:px-6 lg:px-16 lg:pb-9">
    <HeroBreadcrumb article={article} />
    <div class="mx-auto mt-6 max-w-[860px] text-center">
      <p class="art-rise inline-flex rounded-full bg-art px-4 py-1.5 font-heading text-sm font-bold tracking-wide" style="--i: 1">{article.kicker || article.category}</p>
      <h1 class:list={['art-rise mt-4 font-heading leading-[1.1] font-extrabold tracking-tight', titleClass]} style="--i: 2">{article.title}</h1>
      <HeroByline article={article} class="art-rise mt-5 justify-center" />
    </div>
    {article.heroImage && (
      <div class="art-rise mt-6 overflow-hidden rounded-3xl" style="--i: 3">
        <SmartImage
          src={article.heroImage}
          alt={article.title}
          class="aspect-[16/9] w-full object-cover sm:aspect-[21/9]"
          widths={[640, 960, 1440]}
          sizes="(min-width: 1140px) 1000px, 92vw"
          loading="eager"
        />
      </div>
    )}
  </div>
</header>
