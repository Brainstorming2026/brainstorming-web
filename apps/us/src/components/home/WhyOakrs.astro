---
import { Image } from 'astro:assets'
import journeyIllustration from '@/assets/okrs/figure4.png'
import Wave from '@/components/common/Wave.astro'
import up from '@/assets/okrs/down.png'
import investmentBanner from '@/assets/okrs/figure3.png'
import { getLang, useTranslations } from '@/i18n/utils'

const lang = getLang(Astro.url)
const t = useTranslations(lang, 'oakrs')
---

<div class="relative">
  <section class="bg-primary pt-4 pb-6 lg:pb-8">
    <div id="oakrs-banner-wrap" class="mx-auto h-auto w-full max-w-[1220px] -mt-8 overflow-hidden rounded-3xl sm:-mt-10 lg:-mt-14">
      <Image
        src={investmentBanner}
        alt={t.bannerAlt}
        class="banner-img h-auto w-full"
        widths={[758, 1220]}
        sizes="100vw"
        loading="lazy"
      />
    </div>
    <Image
      src={up}
      alt=""
      class="pointer-events-none mx-auto h-auto w-full max-w-[1137px]"
    />
    <div class="mx-auto max-w-[1512px] px-6 lg:px-16">
      <h2 id="oakrs-headline" class="font-heading text-3xl font-bold text-white sm:text-4xl">
        {t.headline} <span class="text-gold">{t.headlineAccent}</span>{t.headlineSuffix}
      </h2>
      <p id="oakrs-text" class="mt-3 max-w-[560px] font-body text-white/85">
        {t.text} <strong class="font-bold">{t.textStrong}</strong>.
      </p>

      <div id="oakrs-journey-wrap" class="ml-auto mt-16 h-auto w-full max-w-[1066px] overflow-hidden">
        <Image
          src={journeyIllustration}
          alt={t.journeyAlt}
          class="journey-img h-auto w-full"
          widths={[500, 900]}
          sizes="(min-width: 1024px) 900px, 80vw"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <Wave color="text-mist-200" edge="top" class="absolute bottom-0 left-0 !h-[36px] w-full lg:!h-[56px]" />
</div>

<script>
import { ensureGsap, registerMotion, revealClip, splitHeadline } from '@/lib/motion'
import { prefersReducedMotion } from '@/lib/motion/reduced-motion'

registerMotion(() => {
  const bannerWrap = document.getElementById('oakrs-banner-wrap')
  const bannerImg = document.querySelector<HTMLElement>('.banner-img')
  const headline = document.getElementById('oakrs-headline')
  const text = document.getElementById('oakrs-text')
  const journeyWrap = document.getElementById('oakrs-journey-wrap')
  const { gsap } = ensureGsap()

  if (bannerWrap) revealClip(bannerWrap, { direction: 'up' })
  if (bannerImg && !prefersReducedMotion()) {
    gsap.fromTo(bannerImg, { scale: 1.1 }, { scale: 1, duration: 1.5, ease: 'power2.out', scrollTrigger: { trigger: bannerWrap, start: 'top 85%' } })
  }

  if (text && !prefersReducedMotion()) gsap.set(text, { opacity: 0, y: 10 })
  if (headline) {
    splitHeadline(headline, { by: 'lines', onComplete: () => {
      if (text) gsap.to(text, { opacity: 1, y: 0, duration: 0.5 })
    } })
  }

  if (journeyWrap) revealClip(journeyWrap, { direction: 'left', mode: 'scrub' })
})
</script>
