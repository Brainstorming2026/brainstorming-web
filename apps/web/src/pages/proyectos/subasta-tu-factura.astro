---
import Conversemos from '@/components/common/Conversemos.astro'
import ProjectCampaign from '@/components/projects/ProjectCampaign.astro'
import ProjectFeature from '@/components/projects/ProjectFeature.astro'
import ProjectHero from '@/components/projects/ProjectHero.astro'
import SubastaBranding from '@/components/projects/subasta/SubastaBranding.astro'
import { proyectos } from '@/data/proyectos'
import { proyectosDetalle } from '@/data/proyectosDetalle'
import Layout from '@/layouts/Layout.astro'

export const prerender = true;

const proyecto = proyectos.find(p => p.slug === 'subasta-tu-factura')!
const detalle = proyectosDetalle['subasta-tu-factura']
---

<Layout title="Subasta tus Facturas — Brainstorming">
  <ProjectHero proyecto={proyecto} detalle={detalle} />
  <SubastaBranding />
  {detalle.campania && <ProjectCampaign campania={detalle.campania} />}
  {detalle.features?.map(feature => <ProjectFeature feature={feature} />)}
  <Conversemos
    heading="¿Quieres ser parte de nuestro portafolio?"
    whatsappText="Hola, me gustaría formar parte de su portafolio"
  />
</Layout>
