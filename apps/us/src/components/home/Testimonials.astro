---
import Wave from '@/components/common/Wave.astro'
import { getLang, useTranslations } from '@/i18n/utils'

const lang = getLang(Astro.url)
const t = useTranslations(lang, 'testimonials')
const testimonials = t.items
---

<div class="relative">
  <section class="bg-gradient-to-b from-[#223B79] to-[#111E3D] pt-16 pb-[100px] lg:pt-24 lg:pb-[140px]">
    <div class="mx-auto max-w-[1512px] px-6 lg:px-16">
      <h2 id="testimonials-headline" class="font-heading text-3xl font-bold text-white sm:text-4xl">
        {t.headline}
      </h2>

      <div id="testimonials-grid" class="mt-12 grid gap-6 md:grid-cols-3">
        {
          testimonials.map(t => (
            <div class="testimonial-card relative rounded-2xl bg-white p-8 pt-12 shadow-lg">
              <svg
                class="absolute -top-4 left-6 h-10 w-10 text-primary"
                viewBox="0 0 24 24"
                fill="currentColor"
              >
                <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z" />
              </svg>
              <p class="font-body text-sm leading-relaxed text-dark/70">{t.quote}</p>
              <p class="mt-6 font-heading text-sm font-bold text-dark">{t.author}</p>
              <p class="font-body text-xs text-dark/60">{t.role}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <Wave color="text-mist-200" edge="top" class="absolute bottom-0 left-0 w-full -scale-x-100" />
</div>

<script>
import { registerMotion, splitHeadline, staggerGrid } from '@/lib/motion'

registerMotion(() => {
  const headline = document.getElementById('testimonials-headline')
  const cards = document.querySelectorAll('#testimonials-grid .testimonial-card')
  if (headline) splitHeadline(headline, { by: 'words' })
  staggerGrid(cards, { variant: 'organic' })
})
</script>
