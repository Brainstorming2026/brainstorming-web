---
import type { ArticleSecondaryCta } from '@/data/articles'

interface Props {
  cta: ArticleSecondaryCta
}

const { cta } = Astro.props
---

<section class="mx-auto max-w-[720px] px-6 pt-12 text-center lg:px-0">
  <h2 class="font-heading text-lg font-bold text-dark">{cta.title}</h2>
  <a
    href={cta.ctaHref}
    class="mt-4 inline-block rounded-[10px] bg-primary px-6 py-2.5 font-heading text-sm font-bold text-white transition-colors hover:bg-primary-600"
  >
    {cta.ctaLabel}
  </a>
</section>
