---
import { Icon } from 'astro-icon/components'
import { marketingBenefits, marketingSteps } from '@/data'
---

<section class="bg-gradient-to-b from-mist to-white">
  <div class="mx-auto max-w-[1140px] px-6 py-20 lg:px-24">
    <h2 class="text-center font-heading text-2xl font-bold text-dark sm:text-3xl">
      Nuestro proceso de trabajo nos ayuda a crear y comunicar
      <br class="hidden sm:block" />
      estratégicamente tu marca.
    </h2>

    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        marketingSteps.map((step, index) => (
          <div class="flex items-center gap-4 rounded-2xl border border-black/10 bg-white p-5 shadow-sm">
            <span class="font-heading text-3xl font-bold text-[#0063D6]">{index + 1}</span>
            <Icon name={step.icon} class="h-10 w-10 flex-shrink-0" />
            <p class="text-[13.5px] leading-5 text-dark-500">{step.text}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<section class="bg-white py-16">
  <div class="mx-auto max-w-[1140px] px-6 lg:px-24">
    <h2 class="text-center font-heading text-2xl font-bold text-dark sm:text-3xl">
      ¿En qué puede ayudar esto a tu marca?
    </h2>

    <div class="mt-10 grid gap-8 sm:grid-cols-2">
      <ul class="space-y-4">
        {
          marketingBenefits.left.map((text) => (
            <li class="flex items-start gap-3">
              <Icon name="marketing-check" class="mt-1 h-3 w-auto flex-shrink-0" />
              <span class="text-[15px] leading-6 text-dark-500">{text}</span>
            </li>
          ))
        }
      </ul>
      <ul class="space-y-4">
        {
          marketingBenefits.right.map((text) => (
            <li class="flex items-start gap-3">
              <Icon name="marketing-check" class="mt-1 h-3 w-auto flex-shrink-0" />
              <span class="text-[15px] leading-6 text-dark-500">{text}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
