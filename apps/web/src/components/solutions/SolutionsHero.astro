---
import type { ImageMetadata } from 'astro'
import { Image } from 'astro:assets'
import automationVisual from '@/assets/solutions-map/automation-ai-editorial.png'
import brandingVisual from '@/assets/solutions-map/branding-editorial.png'
import growthVisual from '@/assets/solutions-map/growth-planning-editorial.png'
import inboundVisual from '@/assets/solutions-map/inbound-marketing-editorial.png'
import salesVisual from '@/assets/solutions-map/smart-selling-editorial.png'
import innovationVisual from '@/assets/solutions-map/strategic-innovation-editorial.png'
import { solutions } from '@/data/solutions'

const visuals: Record<string, { src: ImageMetadata; alt: string }> = {
  'growth-planning': { src: growthVisual, alt: 'Señales de negocio organizándose en una ruta de crecimiento priorizada' },
  'branding': { src: brandingVisual, alt: 'Sistema de identidad construido alrededor de un núcleo visual coherente' },
  'inbound-marketing': { src: inboundVisual, alt: 'Contenidos relevantes atrayendo y desarrollando oportunidades comerciales' },
  'smart-selling': { src: salesVisual, alt: 'Oportunidades avanzando mediante un proceso comercial con puntos de control' },
  'automatizacion-ia': { src: automationVisual, alt: 'Capa inteligente conectando entradas, herramientas y resultados del negocio' },
  'innovacion-estrategica': { src: innovationVisual, alt: 'Hipótesis evaluadas antes de construir un nuevo modelo de negocio' },
}
---

<section id="solutions-landscape" class="solutions-landscape" aria-labelledby="solutions-hero-headline">
  <div class="solutions-shell">
    <header class="solutions-intro" data-solutions-intro>
      <p class="solutions-eyebrow"><span aria-hidden="true" /> Portafolio estratégico</p>
      <div class="solutions-intro-grid">
        <h1 id="solutions-hero-headline">Seis capacidades.<br /><span>Un sistema para crecer.</span></h1>
        <div>
          <p>Del diagnóstico a la ejecución, cada solución resuelve una parte crítica del negocio y se conecta con las demás.</p>
          <p class="solutions-guide"><span aria-hidden="true">↓</span> Descubre cada capacidad al avanzar.</p>
        </div>
      </div>
    </header>

    <div id="solutions-journey" class="solutions-journey">
      {solutions.map((solution) => {
        const visual = visuals[solution.slug]
        return (
          <article id={solution.slug} class="solution-card" style={`--solution-accent: ${solution.accent}; --solution-tint: ${solution.tint}`} data-solution-card>
            <a href={solution.href} aria-labelledby={`${solution.slug}-title`}>
              <div class="solution-copy" data-solution-copy>
                <div class="solution-process"><span aria-hidden="true" />{solution.process}</div>
                <h2 id={`${solution.slug}-title`}>{solution.title}</h2>
                <p class="solution-description">{solution.desc}</p>
                <span class="solution-action">Explorar solución <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true"><path d="M4 10h11M11 6l4 4-4 4" /></svg></span>
              </div>
              <div class="solution-visual" data-solution-visual>
                <Image src={visual.src} alt={visual.alt} widths={[640, 960, 1280, 1600]} sizes="(max-width: 720px) calc(100vw - 40px), (max-width: 1100px) calc(100vw - 96px), 680px" quality={90} loading="lazy" class="solution-image" data-solution-image />
                <div class="solution-visual-shade" aria-hidden="true" />
              </div>
            </a>
          </article>
        )
      })}
    </div>

    <aside class="solutions-cta" aria-labelledby="solutions-cta-headline" data-solutions-cta>
      <p class="solutions-eyebrow"><span aria-hidden="true" /> Evidencia real</p>
      <div>
        <h2 id="solutions-cta-headline">Mira cómo estas capacidades se convierten en resultados.</h2>
        <a id="solutions-cta-btn" href="/proyectos">Ver proyectos <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true"><path d="M4 10h11M11 6l4 4-4 4" /></svg></a>
      </div>
    </aside>
  </div>
</section>

<style>
  .solutions-landscape { --ease-out: cubic-bezier(.23, 1, .32, 1); overflow: clip; color: var(--color-dark); background: linear-gradient(180deg, #eef2f8 0%, #f8f9fc 34%, #fff 100%); }
  .solutions-shell { width: min(1320px, calc(100% - 96px)); margin-inline: auto; padding-block: clamp(72px, 8vw, 116px) 84px; }
  .solutions-intro { padding-bottom: clamp(58px, 7vw, 92px); }
  .solutions-eyebrow { display: flex; align-items: center; gap: 12px; color: #5628a3; font-size: 11px; line-height: 1.5; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; }
  .solutions-eyebrow > span { width: 28px; height: 2px; background: #7d44e4; }
  .solutions-intro-grid { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(280px, .7fr); gap: clamp(48px, 8vw, 130px); align-items: end; margin-top: 26px; }
  h1 { max-width: 900px; font-family: var(--font-heading); font-size: clamp(50px, 6.6vw, 96px); font-weight: 700; line-height: .95; letter-spacing: -.065em; text-wrap: balance; }
  h1 span { color: #7d44e4; }
  .solutions-intro-grid > div > p:first-child { max-width: 43ch; color: #454545; font-size: clamp(17px, 1.45vw, 20px); line-height: 1.65; text-wrap: pretty; }
  .solutions-guide { display: flex; gap: 12px; align-items: center; margin-top: 28px; color: #5628a3; font-size: 13px; font-weight: 600; }
  .solutions-guide span { display: grid; place-items: center; width: 32px; height: 32px; border: 1px solid rgb(125 68 228 / .28); border-radius: 50%; }
  .solutions-journey { display: grid; gap: clamp(28px, 4vw, 48px); }
  .solution-card { min-width: 0; scroll-margin-top: 100px; }
  .solution-card > a { position: relative; display: grid; grid-template-columns: minmax(320px, .76fr) minmax(0, 1.24fr); min-height: 520px; overflow: hidden; border: 1px solid rgb(33 34 34 / .10); border-radius: 30px; background: rgb(255 255 255 / .94); box-shadow: 0 24px 70px rgb(33 34 34 / .07); isolation: isolate; transition: border-color 180ms ease-out, box-shadow 220ms var(--ease-out), transform 140ms var(--ease-out); }
  .solution-card:nth-child(even) > a { grid-template-columns: minmax(0, 1.24fr) minmax(320px, .76fr); }
  .solution-card:nth-child(even) .solution-copy { order: 2; }
  .solution-card:nth-child(even) .solution-visual { order: 1; }
  .solution-copy { display: flex; flex-direction: column; position: relative; z-index: 2; padding: clamp(36px, 4vw, 58px); }
  .solution-copy::after { content: ''; position: absolute; top: 0; bottom: 0; right: 0; width: 1px; background: linear-gradient(180deg, transparent, color-mix(in srgb, var(--solution-accent) 24%, transparent), transparent); }
  .solution-card:nth-child(even) .solution-copy::after { right: auto; left: 0; }
  .solution-process { display: flex; align-items: center; gap: 12px; color: var(--solution-accent); font-size: 10px; line-height: 1.6; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; }
  .solution-process span { width: 20px; height: 2px; flex: 0 0 auto; background: currentColor; transform-origin: left center; }
  .solution-card h2 { margin-top: 28px; max-width: 12ch; font-family: var(--font-heading); font-size: clamp(38px, 4.2vw, 62px); font-weight: 700; line-height: .98; letter-spacing: -.055em; text-wrap: balance; }
  .solution-description { max-width: 38ch; margin-top: 26px; color: #585959; font-size: clamp(16px, 1.35vw, 19px); line-height: 1.65; text-wrap: pretty; }
  .solution-action { display: inline-flex; align-items: center; gap: 10px; width: fit-content; margin-top: auto; padding-top: 38px; color: var(--solution-accent); font-size: 14px; font-weight: 700; }
  .solution-action svg, .solutions-cta a svg { fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; transition: transform 180ms var(--ease-out); }
  .solution-visual { position: relative; min-height: 520px; overflow: hidden; background: var(--solution-tint); transform-origin: center; }
  :global(.solution-image) { position: absolute; inset: -4%; width: 108%; height: 108%; max-width: none; object-fit: cover; will-change: transform; }
  .solution-visual-shade { position: absolute; inset: 0; pointer-events: none; background: linear-gradient(90deg, rgb(255 255 255 / .16), transparent 24%, transparent 78%, rgb(255 255 255 / .08)); }
  .solution-card > a:focus-visible { outline: 3px solid var(--solution-accent); outline-offset: 5px; }
  .solution-card > a:active { transform: scale(.99); }
  .solutions-cta { display: grid; grid-template-columns: minmax(180px, .4fr) minmax(0, 1.6fr); gap: 48px; align-items: start; margin-top: 84px; padding: 54px 0 16px; border-top: 1px solid rgb(125 68 228 / .18); }
  .solutions-cta > div { display: flex; justify-content: space-between; gap: 40px; align-items: end; }
  .solutions-cta h2 { max-width: 760px; font-family: var(--font-heading); font-size: clamp(30px, 3.6vw, 52px); font-weight: 700; line-height: 1.08; letter-spacing: -.045em; text-wrap: balance; }
  .solutions-cta a { display: inline-flex; flex-shrink: 0; align-items: center; justify-content: center; gap: 12px; min-height: 50px; border-radius: 12px; padding: 0 22px; color: white; background: #7d44e4; font-size: 14px; font-weight: 700; transition: background-color 180ms ease-out, transform 140ms var(--ease-out); }
  .solutions-cta a:focus-visible { outline: 3px solid #7d44e4; outline-offset: 4px; }
  @media (hover: hover) and (pointer: fine) { .solution-card > a:hover { border-color: color-mix(in srgb, var(--solution-accent) 34%, transparent); box-shadow: 0 30px 82px rgb(33 34 34 / .11); } .solution-card > a:hover .solution-action svg, .solutions-cta a:hover svg { transform: translateX(4px); } .solutions-cta a:hover { background: #6a34c9; } }
  @media (max-width: 900px) {
    .solutions-shell { width: calc(100% - 56px); }
    .solutions-intro-grid { grid-template-columns: 1fr; gap: 32px; }
    .solutions-intro-grid > div { display: grid; grid-template-columns: 1fr 1fr; gap: 28px; }
    .solutions-guide { margin-top: 0; }
    .solution-card > a, .solution-card:nth-child(even) > a { grid-template-columns: 1fr; min-height: 0; }
    .solution-card:nth-child(even) .solution-copy, .solution-copy { order: 1; }
    .solution-card:nth-child(even) .solution-visual, .solution-visual { order: 2; }
    .solution-copy::after, .solution-card:nth-child(even) .solution-copy::after { top: auto; left: 0; right: 0; bottom: 0; width: auto; height: 1px; }
    .solution-action { margin-top: 32px; padding-top: 0; }
    .solution-visual { min-height: 420px; }
    .solutions-cta { grid-template-columns: 1fr; gap: 30px; }
  }
  @media (max-width: 600px) {
    .solutions-shell { width: calc(100% - 40px); padding-block: 58px 64px; }
    .solutions-intro-grid > div { display: block; }
    .solutions-guide { margin-top: 24px; }
    .solutions-journey { gap: 20px; }
    .solution-card > a { border-radius: 22px; }
    .solution-copy { padding: 28px 24px 30px; }
    .solution-card h2 { margin-top: 20px; font-size: clamp(34px, 11vw, 48px); }
    .solution-description { margin-top: 18px; font-size: 15px; }
    .solution-visual { min-height: 280px; }
    .solutions-cta { margin-top: 56px; padding-top: 38px; }
    .solutions-cta > div { align-items: flex-start; flex-direction: column; }
    .solutions-cta a { width: 100%; }
  }
  @media (prefers-reduced-motion: reduce) { .solution-card > a, :global(.solution-image), .solution-action svg, .solutions-cta a, .solutions-cta a svg { transition: none; will-change: auto; } .solution-card > a:active { transform: none; } }
</style>

<script>
import { initSolutionsMapMotion } from '@/scripts/solutions/solutions-map'

initSolutionsMapMotion()
</script>
