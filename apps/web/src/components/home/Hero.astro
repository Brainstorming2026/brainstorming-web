---
import { Icon } from 'astro-icon/components'
import { Image } from 'astro:assets'
import heroVideo from '@/assets/logos/hero-video.webp'
import { heroYoutubeId as youtubeId } from '@/data'
import { homeContent } from '@/data/transversal-content'
---

<section id="hero" class="bg-white">
  <div
    class="mx-auto grid max-w-[1512px] items-center gap-10 px-6 pb-16 pt-6 lg:grid-cols-2 lg:gap-16 lg:px-24 lg:pb-24 lg:pt-10"
  >
    <!-- Titular -->
    <!-- data-speed solo lo lee ScrollSmoother (desktop): el texto avanza algo
         más rápido que el scroll y el video se queda atrás → profundidad. -->
    <div class="min-w-0" data-speed="1.06">
      <h1
        id="hero-headline"
        data-animate
        class="font-heading text-[clamp(2rem,3.4vw,3.25rem)] font-bold leading-[1.1] tracking-[-0.035em] text-ink"
      >
        {homeContent.hero.title}
      </h1>
      <p class="mt-7 max-w-[60ch] text-base leading-relaxed text-gray-body sm:text-lg">
        {homeContent.hero.subtitle}
      </p>
    </div>

    <!-- Video con facade -->
    <div
      id="hero-video"
      data-id={youtubeId}
      data-animate="circle"
      data-speed="0.9"
      class="group relative aspect-video w-full cursor-pointer overflow-hidden rounded-3xl shadow-lg"
    >
      <Image
        src={heroVideo}
        alt="Video de presentación de Brainstorming"
        widths={[480, 720, 1080]}
        sizes="(min-width: 1024px) 42vw, 100vw"
        quality={75}
        loading="eager"
        fetchpriority="high"
        class="absolute inset-0 h-full w-full object-cover"
      />
      <div
        class="absolute inset-0 flex items-center justify-center bg-black/10 transition-colors group-hover:bg-black/20"
      >
        <button
          type="button"
          aria-label="Reproducir video"
          class="text-white/90 transition-transform group-hover:scale-110"
        >
          <Icon name="play" class="h-20 w-20 drop-shadow-lg" />
        </button>
      </div>
    </div>
  </div>
</section>

<script>
document.addEventListener('astro:page-load', () => {
  const holder = document.getElementById('hero-video')
  holder?.addEventListener('click', () => {
    const id = holder.dataset.id
    holder.innerHTML = `<iframe class="absolute inset-0 h-full w-full" src="https://www.youtube.com/embed/${id}?autoplay=1&rel=0" title="Video Brainstorming" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>`
  }, { once: true })
})
</script>

<script>
import { registerMotion, revealCircle, splitHeadline } from '@/lib/motion'

registerMotion(() => {
  const headline = document.getElementById('hero-headline')
  const video = document.getElementById('hero-video')
  if (headline)
    splitHeadline(headline, { by: 'words', scrollTrigger: false })
  if (video)
    revealCircle(video, { delay: 0.3 })
})
</script>
