---
import { Image } from 'astro:assets'

import { clienteLogos } from '@/assets/clientes'
import curva from '@/icons/proyecto-curva.svg'

interface Props {
  /** Prefijo de ids; cambia si la sección aparece más de una vez en la página. */
  id?: string
  eyebrow?: string
  title?: string
  /** Curva oscura de entrada, para cuando la sección previa es `section-dark`. */
  curve?: boolean
}

const {
  id = 'clientes',
  eyebrow = 'Clientes',
  title = 'Empresas que confían en nosotros',
  curve = false,
} = Astro.props

// "Más de 60" y no "64": el número exacto envejece con cada cliente nuevo.
const total = Math.floor(clienteLogos.length / 10) * 10

// Las celdas son más altas que en la grilla vieja: el mismo peso visual, escalado.
const SCALE = 1.15
const logoWidth = (width: number, scale = SCALE) => Math.round(width * scale)
---

<section class:list={['client-wall relative bg-white', curve && 'pt-24']} aria-labelledby={`${id}-title`}>
  {
    curve && (
      <img
        src={curva.src}
        alt=""
        class="absolute top-0 left-0 block h-[120px] w-full object-cover object-top"
        aria-hidden="true"
      />
    )
  }
  <div class="relative mx-auto max-w-[1512px] px-6 py-16 lg:px-24 lg:py-24">
    <header class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between lg:gap-16">
      <div>
        <p class="text-xs font-semibold tracking-[0.18em] text-primary uppercase">{eyebrow}</p>
        <h2 id={`${id}-title`} class="mt-3 font-heading text-3xl font-bold text-ink sm:text-[35px]">
          {title}
        </h2>
      </div>
      <p class="max-w-md text-[15px] leading-relaxed text-ink-500">
        Más de {total} marcas, de empresas locales a multinacionales, han trabajado con nosotros en
        estrategia, marca y crecimiento.
      </p>
    </header>

    <div id={`${id}-wall`} class="client-collapse relative mt-12 overflow-hidden lg:mt-16" data-collapsed>
      <ul id={`${id}-grid`} class="client-grid grid grid-cols-3 sm:grid-cols-4 md:grid-cols-6 lg:grid-cols-8" role="list">
        {
          clienteLogos.map(logo => (
            <li class="client-cell flex h-24 items-center justify-center px-3 lg:h-28">
              <Image
                src={logo.image}
                alt={logo.name}
                widths={[logoWidth(logo.width), logoWidth(logo.width, SCALE * 2)]}
                sizes={`${logoWidth(logo.width)}px`}
                quality={80}
                loading="lazy"
                style={`width:${logoWidth(logo.width)}px`}
                class:list={['h-auto max-h-14 max-w-full object-contain', logo.className]}
              />
            </li>
          ))
        }
      </ul>
      <div class="client-fade pointer-events-none absolute inset-x-0 bottom-0 h-28 bg-gradient-to-b from-white/0 to-white"></div>
    </div>

    <div class="mt-8 flex justify-center">
      <button
        type="button"
        class="client-toggle inline-flex items-center gap-2 rounded-full border border-dark-100 px-6 py-3 text-sm font-medium text-ink transition-colors hover:border-primary hover:text-primary focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary"
        aria-expanded="false"
        aria-controls={`${id}-wall`}
        data-label-closed={`Ver las ${clienteLogos.length} marcas`}
        data-label-open="Ver menos"
      >
        <span class="client-toggle-label">Ver más marcas</span>
        <svg class="client-toggle-icon size-4" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>
    </div>
  </div>
</section>

<style>
  /* Sin líneas de grilla: el ritmo lo dan las celdas de alto fijo. El hover
     tiñe la celda para que se lea cuál estás señalando. */
  .client-cell {
    border-radius: 12px;
    transition: background-color 300ms ease-out;
  }

  /* Logos siempre a color. El hover solo marca la celda: no cambia el logo,
     así nada depende del mouse (en táctil se ve igual). El transform va sobre
     la <img> y no sobre la celda, que es la que anima GSAP en la entrada. */
  .client-cell img { transition: transform 400ms cubic-bezier(.16,1,.3,1); }
  @media (hover: hover) and (pointer: fine) {
    .client-cell:hover { background-color: var(--color-mist-50); }
    .client-cell:hover img { transform: scale(1.05); }
  }

  /* Colapsado muestra cuatro filas (4 × h-24, 4 × h-28 en desktop); el
     degradado insinúa que hay más debajo. */
  .client-collapse { transition: max-height 600ms cubic-bezier(.16,1,.3,1); }
  .client-collapse[data-collapsed] { max-height: 24rem; }
  @media (min-width: 1024px) {
    .client-collapse[data-collapsed] { max-height: 28rem; }
  }
  .client-fade { transition: opacity 300ms ease-out; }
  .client-collapse:not([data-collapsed]) .client-fade { opacity: 0; }

  .client-toggle-icon { transition: transform 300ms cubic-bezier(.16,1,.3,1); }
  .client-toggle[aria-expanded='true'] .client-toggle-icon { transform: rotate(180deg); }

  @media (prefers-reduced-motion: reduce) {
    .client-cell, .client-cell img, .client-collapse, .client-fade, .client-toggle-icon { transition: none; }
  }
</style>

<script>
import { ensureGsap, prefersReducedMotion, registerMotion, splitHeadline } from '@/lib/motion'
import { tempo } from '@/lib/motion/config'

// El toggle va fuera de registerMotion: si el motion cae en fallback, la
// lista completa tiene que seguir abriéndose.
document.addEventListener('astro:page-load', () => {
  document.querySelectorAll<HTMLButtonElement>('.client-wall .client-toggle').forEach((button) => {
    const wall = document.getElementById(button.getAttribute('aria-controls') ?? '')
    const label = button.querySelector('.client-toggle-label')
    if (!wall || !label)
      return

    button.addEventListener('click', () => {
      const open = button.getAttribute('aria-expanded') !== 'true'
      button.setAttribute('aria-expanded', String(open))
      label.textContent = (open ? button.dataset.labelOpen : button.dataset.labelClosed) ?? ''

      // max-height anima entre valores en px: se fija la altura real antes de
      // soltar o poner el tope de cuatro filas.
      wall.style.maxHeight = `${wall.scrollHeight}px`
      if (open) {
        wall.removeAttribute('data-collapsed')
      }
      else {
        requestAnimationFrame(() => {
          wall.toggleAttribute('data-collapsed', true)
          wall.style.maxHeight = ''
        })
        button.closest('.client-wall')?.scrollIntoView({ block: 'start' })
      }

      const settle = () => {
        if (open)
          wall.style.maxHeight = 'none'
        // La altura de la página cambió: los triggers de más abajo se recalculan.
        ensureGsap().ScrollTrigger.refresh()
      }
      if (prefersReducedMotion()) {
        requestAnimationFrame(settle)
        return
      }
      // Los transitionend de las celdas (fondo, escala) también suben hasta aquí.
      const onEnd = (event: TransitionEvent) => {
        if (event.target !== wall || event.propertyName !== 'max-height')
          return
        wall.removeEventListener('transitionend', onEnd)
        settle()
      }
      wall.addEventListener('transitionend', onEnd)
    })
  })
})

registerMotion(() => {
  const { gsap } = ensureGsap()
  gsap.matchMedia().add('(prefers-reduced-motion: no-preference)', () => {
    document.querySelectorAll<HTMLElement>('.client-wall').forEach((wall) => {
      const headline = wall.querySelector<HTMLElement>('h2')
      if (headline)
        splitHeadline(headline, { by: 'lines' })

      // Etiqueta y bajada acompañan al titular.
      const intro = Array.from(wall.querySelectorAll('header p'))
      gsap.set(intro, { autoAlpha: 0, y: 12 })
      gsap.to(intro, { autoAlpha: 1, y: 0, duration: 0.8 * tempo, stagger: 0.12 * tempo, ease: 'expo.out', clearProps: 'opacity,visibility,transform', scrollTrigger: { trigger: wall.querySelector('header'), start: 'top 85%', once: true } })

      // Los logos entran como una onda diagonal desde la esquina superior
      // izquierda (stagger por grilla), no como un barrido de 67 items en fila.
      const grid = wall.querySelector('.client-grid')
      const cells = wall.querySelectorAll('.client-cell')
      gsap.set(cells, { autoAlpha: 0, y: 12 })
      gsap.to(cells, {
        autoAlpha: 1,
        y: 0,
        duration: 0.8 * tempo,
        ease: 'expo.out',
        stagger: { each: 0.035 * tempo, grid: 'auto', from: 'start' },
        clearProps: 'opacity,visibility,transform',
        scrollTrigger: { trigger: grid, start: 'top 82%', once: true },
      })
    })
  })
})
</script>
