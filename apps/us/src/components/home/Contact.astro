---
import { PUBLIC_TURNSTILE_SITE_KEY } from 'astro:env/client'
import { Image } from 'astro:assets'
import illustration from '@/assets/contact/hero-contact.png'
import arrow from '@/assets/contact/right.png'
import FormStatusModal from '@/components/common/FormStatusModal.astro'
import { getLang, useTranslations } from '@/i18n/utils'

const lang = getLang(Astro.url)
const t = useTranslations(lang, 'contact')
const investmentRanges = t.investmentRanges
---

<div class="relative">
  <svg
    viewBox="0 0 1512 50"
    preserveAspectRatio="none"
    fill="none"
    class="pointer-events-none absolute top-0 left-0 z-10 h-[50px] w-full text-white lg:h-[90px]"
  >
    <path
      fill="currentColor"
      d="M316.384 3.44999C406.123 6.09999 493.138 12.45 607.846 28.45C652.64 34.8 724.219 43.95 759.932 46.4C795.646 48.85 839.532 50.3 874.187 49.05C889.622 48.5 908.387 48.35 950.003 45.35C991.165 42.2 1038.08 37.05 1070.16 33C1132.66 25.05 1213.77 22.05 1272.94 21.7C1403.69 20.9 1512.65 37.1 1512.65 37.1V-1.14441e-05H-0.6521V17.35C-0.6521 17.35 77.2829 7.64999 160.06 4.49999C242.233 1.49999 280.67 2.39999 316.384 3.44999Z"
    />
  </svg>

  <section id="contact" class="relative overflow-hidden bg-mist-100">
    <div
      class="absolute inset-y-0 right-0 w-full bg-gradient-to-br from-primary to-navy-700 lg:w-1/2"
    >
    </div>

    <Image
      src={arrow}
      alt=""
      role="presentation"
      class="contact-arrow pointer-events-none absolute top-[62%] left-[58%] z-30 hidden w-16 -translate-x-1/2 -translate-y-1/2 opacity-90 lg:block"
    />

    <div class="relative mx-auto grid max-w-[1512px] gap-10 px-6 pt-20 pb-12 lg:grid-cols-2 lg:gap-16 lg:px-16 lg:pt-28 lg:pb-16">
      <div id="contact-text" class="flex flex-col lg:justify-center">
        <h2 id="contact-headline" class="font-heading text-3xl font-bold text-navy sm:text-4xl">{t.headline}</h2>
        <p class="mt-3 max-w-[420px] font-body text-dark/70">
          {t.text}
        </p>

        <div id="contact-img-wrap" class="relative mt-8 max-w-md overflow-hidden">
          <Image
            src={illustration}
            alt={t.illustrationAlt}
            class="h-auto w-full object-contain"
            widths={[400, 740]}
            sizes="(min-width: 1024px) 480px, 90vw"
            loading="lazy"
          />
        </div>
      </div>

      <div id="contact-form-card" class="rounded-2xl bg-white p-8 shadow-xl lg:max-w-[540px] lg:ml-auto">
        <h3 class="text-center font-heading text-xl font-bold text-navy">
          {t.formTitle}
        </h3>
        <p class="mt-1 text-center font-body text-sm italic text-dark/60">{t.requiredNote}</p>

        <form
          id="contact-form"
          class="mt-6 flex flex-col gap-4"
          data-sending-title={t.sendingTitle}
          data-success-title={t.successTitle}
          data-success-message={t.successMessage}
          data-error-title={t.errorTitle}
          data-error-message={t.errorMessage}
          data-privacy-consent-error={t.privacyConsentError}
        >
          <input type="hidden" name="lang" value={lang} />
          <label class="hidden" aria-hidden="true">
            <input type="text" name="website" tabindex="-1" autocomplete="off" />
          </label>

          <input
            type="text"
            name="firstName"
            placeholder={t.firstName}
            required
            minlength="1"
            maxlength="100"
            class="rounded-lg border border-mist-200 bg-mist-100/60 px-4 py-3 font-body text-sm text-dark placeholder:text-dark/50 focus:border-primary focus:outline-none"
          />
          <input
            type="text"
            name="lastName"
            placeholder={t.lastName}
            required
            minlength="1"
            maxlength="100"
            class="rounded-lg border border-mist-200 bg-mist-100/60 px-4 py-3 font-body text-sm text-dark placeholder:text-dark/50 focus:border-primary focus:outline-none"
          />
          <input
            type="email"
            name="companyEmail"
            placeholder={t.companyEmail}
            required
            maxlength="150"
            class="rounded-lg border border-mist-200 bg-mist-100/60 px-4 py-3 font-body text-sm text-dark placeholder:text-dark/50 focus:border-primary focus:outline-none"
          />
          <input
            type="tel"
            name="phone"
            placeholder={t.phone}
            required
            minlength="6"
            maxlength="30"
            class="rounded-lg border border-mist-200 bg-mist-100/60 px-4 py-3 font-body text-sm text-dark placeholder:text-dark/50 focus:border-primary focus:outline-none"
          />

          <fieldset>
            <legend class="font-body text-sm text-dark">{t.investmentLegend}</legend>
            <div class="mt-2 flex flex-col gap-1.5">
              {
                investmentRanges.map(range => (
                  <label class="flex items-center gap-2 font-body text-sm text-dark/80">
                    <input type="radio" name="investment" value={range} required class="accent-primary" />
                    {range}
                  </label>
                ))
              }
            </div>
            <p class="mt-2 font-body text-xs text-dark/50">{t.investmentNote}</p>
          </fieldset>

          <label class="font-body text-sm font-bold text-dark">
            {t.messageLabel}
            <textarea
              name="message"
              maxlength="2000"
              rows="3"
              class="mt-2 w-full rounded-lg border border-mist-200 bg-mist-100/60 px-4 py-3 font-body text-sm text-dark placeholder:text-dark/50 focus:border-primary focus:outline-none"
            ></textarea>
          </label>

          <label class="flex items-start gap-2 font-body text-xs text-dark/70">
            <input
              type="checkbox"
              name="privacyConsent"
              required
              class="mt-0.5 h-4 w-4 shrink-0 accent-primary"
            />
            <span>
              {t.privacyConsentPrefix}
              {' '}
              <a href="https://brainstorming.la/politica-de-privacidad" target="_blank" rel="noopener noreferrer" class="underline hover:text-primary">{t.privacyConsentLink}</a>.
            </span>
          </label>

          <div id="contact-turnstile" class="cf-turnstile" data-sitekey={PUBLIC_TURNSTILE_SITE_KEY} data-action="contact-us"></div>

          <button
            type="submit"
            id="contact-form-submit"
            class="mt-2 rounded-lg bg-primary py-3 font-heading text-sm font-bold tracking-wide text-white transition-colors hover:bg-primary-600 disabled:cursor-not-allowed disabled:opacity-60"
          >
            {t.submit}
          </button>
        </form>
      </div>
    </div>
  </section>
</div>

<FormStatusModal />

<script>
import { ensureGsap, registerMotion, revealClip, splitHeadline } from '@/lib/motion'
import { prefersReducedMotion } from '@/lib/motion/reduced-motion'

registerMotion(() => {
  const headline = document.getElementById('contact-headline')
  const imgWrap = document.getElementById('contact-img-wrap')
  const formCard = document.getElementById('contact-form-card')
  const { gsap } = ensureGsap()

  if (headline) splitHeadline(headline, { by: 'lines' })
  if (imgWrap) revealClip(imgWrap, { direction: 'up' })

  if (formCard) {
    if (prefersReducedMotion()) {
      gsap.fromTo(formCard, { opacity: 0 }, { opacity: 1, duration: 0.4 })
    }
    else {
      gsap.set(formCard, { opacity: 0, y: 24, scale: 0.98 })
      gsap.to(formCard, { opacity: 1, y: 0, scale: 1, duration: 0.9, ease: 'power2.out', delay: 0.1, scrollTrigger: { trigger: formCard, start: 'top 85%' } })
    }
  }
})
</script>

<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

<script>
  declare global {
    interface Window {
      turnstile?: { reset: (widget?: string | HTMLElement) => void }
    }
  }

  const form = document.querySelector<HTMLFormElement>('#contact-form')
  const submitBtn = document.querySelector<HTMLButtonElement>('#contact-form-submit')
  const privacyCheckbox = form?.querySelector<HTMLInputElement>('input[name="privacyConsent"]')

  privacyCheckbox?.addEventListener('change', () => {
    privacyCheckbox.setCustomValidity(privacyCheckbox.checked ? '' : (form?.dataset.privacyConsentError ?? ''))
  })
  privacyCheckbox?.addEventListener('invalid', () => {
    privacyCheckbox.setCustomValidity(form?.dataset.privacyConsentError ?? '')
  })

  form?.addEventListener('submit', async (event) => {
    event.preventDefault()
    if (!submitBtn || !form)
      return

    // Verificacion explicita de campos: no depender solo del `required` nativo,
    // que un submit programatico o un boton mal tipado podria saltarse.
    if (!form.checkValidity()) {
      form.reportValidity()
      return
    }

    const data = new FormData(form)
    const turnstileToken = data.get('cf-turnstile-response')
    if (typeof turnstileToken !== 'string' || turnstileToken.length === 0) {
      document.dispatchEvent(new CustomEvent('form-status', {
        detail: { state: 'error', title: form.dataset.errorTitle, message: 'Please wait a moment and try again.' },
      }))
      return
    }

    submitBtn.disabled = true
    document.dispatchEvent(new CustomEvent('form-status', {
      detail: { state: 'loading', title: form.dataset.sendingTitle },
    }))

    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({
          firstName: data.get('firstName'),
          lastName: data.get('lastName'),
          companyEmail: data.get('companyEmail'),
          phone: data.get('phone'),
          investment: data.get('investment'),
          message: data.get('message'),
          lang: data.get('lang'),
          turnstileToken,
          privacyConsent: data.get('privacyConsent') === 'on',
          website: data.get('website'),
        }),
      })

      if (!res.ok) {
        document.dispatchEvent(new CustomEvent('form-status', {
          detail: { state: 'error', title: form.dataset.errorTitle, message: form.dataset.errorMessage },
        }))
        return
      }

      form.reset()
      document.dispatchEvent(new CustomEvent('form-status', {
        detail: { state: 'success', title: form.dataset.successTitle, message: form.dataset.successMessage },
      }))
    }
    catch {
      document.dispatchEvent(new CustomEvent('form-status', {
        detail: { state: 'error', title: form.dataset.errorTitle, message: form.dataset.errorMessage },
      }))
    }
    finally {
      submitBtn.disabled = false
      window.turnstile?.reset('contact-turnstile')
    }
  })
</script>

<style>
  .contact-arrow {
    animation: contact-arrow-bounce 1.6s ease-in-out infinite;
  }

  @keyframes contact-arrow-bounce {
    0%,
    100% {
      transform: translate(-50%, -50%);
    }
    50% {
      transform: translate(-35%, -50%);
    }
  }
</style>
