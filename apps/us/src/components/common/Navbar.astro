---
import { Image } from 'astro:assets'
import logo from '@/assets/brainstorming/logo.png'
import LanguageSwitcher from '@/components/common/LanguageSwitcher.astro'

interface Props {
  ctaHref?: string
}

const { ctaHref = '#contact' } = Astro.props
---

<header class="relative z-20 mx-auto flex w-full max-w-[1512px] items-center justify-between gap-6 px-6 py-6 lg:px-16">
  <a href="/">
    <Image src={logo} alt="Brainstorming" class="h-8 w-auto" widths={[200, 400]} sizes="200px" />
  </a>

  <div class="flex items-center gap-3">
    <LanguageSwitcher />
    <a
      href={ctaHref}
      class="rounded-lg bg-gold px-5 py-2.5 font-heading text-sm font-bold text-dark whitespace-nowrap transition-transform hover:scale-[1.03]"
    >
      Book a strategy call
    </a>
  </div>
</header>
