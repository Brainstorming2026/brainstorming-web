---
import { CMS_API_URL } from 'astro:env/server'
import { z } from 'zod'
import SmartImage from '@/components/common/SmartImage.astro'
import { categoryLabels } from '@/data/guides'
import Layout from '@/layouts/Layout.astro'

export const prerender = false
Astro.response.headers.set('Cache-Control', 'private, no-store')
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow')
Astro.response.headers.set('Referrer-Policy', 'no-referrer')
const file = z.object({ url: z.url(), fileName: z.string() })
const schema = z.object({
  title: z.string(),
category: z.enum(['branding', 'desarrollo-web', 'inbound-marketing', 'optimizacion', 'inbound-sales']).nullable(),
  status: z.enum(['draft', 'published', 'changed']),
cover: file.nullable(),
pdf: file.nullable(),
  problems: z.array(z.object({ message: z.string() })),
})
let guide: z.infer<typeof schema> | null = null
let error = 'El enlace no es válido o ya venció. Vuelve al editor y abre otra vista previa.'
const token = Astro.url.searchParams.get('t')
Astro.response.status = 401
if (token && CMS_API_URL) {
  try {
    const response = await fetch(`${CMS_API_URL.replace(/\/$/, '')}/v1/preview/guides/${encodeURIComponent(Astro.params.id ?? '')}`, {
      headers: { Authorization: `Bearer ${token}` },
signal: AbortSignal.timeout(15000),
    })
    if (response.ok) {
      guide = schema.parse(await response.json())
      Astro.response.status = 200
    }
    else if (response.status !== 401) {
      Astro.response.status = response.status === 404 ? 404 : 503
      error = response.status === 404 ? 'Esta guía ya no existe.' : 'No pudimos cargar la guía. Inténtalo otra vez.'
    }
  }
  catch {
    Astro.response.status = 503
    error = 'No pudimos cargar la guía. Inténtalo otra vez.'
  }
}
const labels = { draft: 'Borrador', published: 'Publicado', changed: 'Con cambios sin publicar' }
---

<Layout title="Vista previa de guía — Brainstorming" noindex>
  {guide
    ? (
        <>
          <aside role="status" class="border-b border-amber-300 bg-amber-50 px-6 py-4 text-sm text-amber-950">
            <p class="mx-auto max-w-[1140px] font-bold">Vista previa del contenido guardado · {labels[guide.status]} · enlace privado</p>
            {guide.problems.map(problem => <p class="mx-auto mt-1 max-w-[1140px]">Falta para publicar: {problem.message}</p>)}
          </aside>
          <section class="bg-mist px-6 py-16">
            <div class="mx-auto max-w-[480px] rounded-[16px] bg-white p-4">
              {guide.cover && <SmartImage src={guide.cover.url} alt={guide.title} class="h-auto w-full rounded-[12px] object-cover" loading="eager" />}
              {guide.category && <p class="mt-3 text-[13px] text-primary">{categoryLabels[guide.category]}</p>}
              <h1 class="mt-1 font-heading text-[20px] font-bold leading-[28px] text-ink">{guide.title}</h1>
              {guide.pdf && <a href={guide.pdf.url} target="_blank" rel="noopener noreferrer" class="mt-4 inline-flex rounded-[10px] bg-primary px-5 py-3 font-heading text-sm font-bold text-white">Abrir PDF</a>}
            </div>
          </section>
        </>
      )
    : <section class="mx-auto max-w-[720px] px-6 py-24"><h1 class="font-heading text-2xl font-bold">Vista previa no disponible</h1><p class="mt-4">{error}</p></section>}
</Layout>
