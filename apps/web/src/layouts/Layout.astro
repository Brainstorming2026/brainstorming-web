---
import { ClientRouter, fade } from 'astro:transitions'
import Footer from '@/components/common/Footer.astro'
import Navbar from '@/components/common/Navbar.astro'
import SplashScreen from '@/components/common/SplashScreen.astro'
import SolutionMotion from '@/components/solutions/SolutionMotion.astro'
import '@/styles/global.css'

interface Props {
  title: string
  description?: string
  footerCurveBg?: string
  showNavbar?: boolean
}

const { title, description = 'Brainstorming — Agencia de Marketing', footerCurveBg, showNavbar = true } = Astro.props
const isSolution = Astro.url.pathname.startsWith('/soluciones')
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico?v=2" sizes="48x48" />
    <link rel="icon" type="image/png" href="/brainstorming-icon-file.png?v=2" />
    <link rel="apple-touch-icon" href="/brainstorming-icon-file.png?v=2" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />

    <!-- Navegación suave entre páginas, sin recarga completa -->
    <ClientRouter />
  </head>
  <body class="font-body text-ink antialiased overflow-x-hidden">
    <SplashScreen />
    {showNavbar && <Navbar />}
    <main data-solution-page={isSolution ? '' : undefined} transition:animate={fade({ duration: '0.4s' })}>
      <slot />
    </main>
    {isSolution && <SolutionMotion />}
    <Footer curveBg={footerCurveBg} />
  </body>
</html>
