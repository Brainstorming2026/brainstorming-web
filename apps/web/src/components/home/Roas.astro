---
import { Icon } from 'astro-icon/components'
import { Image } from 'astro:assets'
import backgroundVideo from '@/assets/backgrounds/background-video.webp'
import stanleyLogo from '@/assets/clientes/customer-stanley.webp'
import grinLogo from '@/assets/roast/roast-gris.webp'
import { newProjectLogos } from '@/data/new-projects'

const youtubeId = 'm9yNCH4-MB4'
const clients = [
  { logo: newProjectLogos.nordic, name: 'Nordic International School' },
  { logo: newProjectLogos.senati, name: 'SENATI' },
  { logo: newProjectLogos.pastipan, name: 'Pastipan' },
  { logo: grinLogo, name: 'Grin', full: true },
  { logo: stanleyLogo, name: 'Stanley Black & Decker' },
]
---

<section id="roas" class="bg-dark text-white">
  <div class="mx-auto max-w-[1512px] px-6 py-20 lg:px-24 lg:py-24">
    <!-- Bloque superior: texto + video -->
    <div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-16">
      <div>
        <h2 class="font-heading text-3xl font-bold leading-tight sm:text-4xl">
          La importancia del ROAS Return on Advertising Spend
        </h2>
        <p class="mt-8 font-heading text-xl font-bold">
          ¿Quieres empezar un proyecto con nosotros?
        </p>
        <a
          href="/soluciones"
          class="mt-8 inline-block rounded-[10px] bg-primary px-8 py-3 font-heading text-sm font-bold text-white transition-colors hover:bg-primary-600"
        >
          VER SERVICIOS
        </a>
      </div>

      <!-- Video con facade -->
      <div
        id="roas-video"
        data-id={youtubeId}
        class="group relative aspect-video w-full cursor-pointer overflow-hidden rounded-3xl shadow-lg"
      >
        <Image
          src={backgroundVideo}
          alt="Video: ¿Qué es el ROAS?"
          widths={[480, 720, 1080]}
          sizes="(min-width: 1024px) 42vw, 100vw"
          quality={75}
          loading="lazy"
          class="absolute inset-0 h-full w-full object-cover"
        />
        <div
          class="absolute inset-0 flex items-center justify-center bg-black/10 transition-colors group-hover:bg-black/20"
        >
          <button
            type="button"
            aria-label="Reproducir video"
            class="text-white/90 transition-transform group-hover:scale-110"
          >
            <Icon name="play" class="h-20 w-20 drop-shadow-lg" />
          </button>
        </div>
      </div>
    </div>

    <!-- Clientes + ROAS -->
    <div
      id="roas-grid"
      class="mt-16 grid grid-cols-2 gap-x-6 gap-y-10 sm:grid-cols-3 lg:grid-cols-5"
    >
      {
        clients.map(r => (
          <div class="roas-item mx-auto flex aspect-square w-full max-w-[220px] items-center justify-center overflow-hidden rounded-full bg-[#f8f8fc]">
            <Image
              src={r.logo}
              alt={r.name}
              widths={[160, 220]}
              sizes="220px"
              quality={80}
              loading="lazy"
              class:list={['max-h-full w-full object-contain', r.full ? 'p-0' : 'p-6']}
            />

          </div>
        ))
      }
    </div>
  </div>
</section>



<script>
document.addEventListener('astro:page-load', () => {
  const holder = document.getElementById('roas-video')
  holder?.addEventListener('click', () => {
    const id = holder.dataset.id
    holder.innerHTML = `<iframe class="absolute inset-0 h-full w-full" src="https://www.youtube.com/embed/${id}?autoplay=1&rel=0" title="Video ROAS" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>`
  }, { once: true })
})
</script>

<script>
import { registerMotion, revealCards, splitHeadline } from '@/lib/motion'

registerMotion(() => {
  const headline = document.querySelector<HTMLElement>('#roas h2')
  if (headline)
    splitHeadline(headline, { by: 'lines' })

  revealCards(document.querySelectorAll('#roas-grid .roas-item'), {
    trigger: document.getElementById('roas-grid'),
    intensity: 1.15,
    stagger: 0.1,
  })
})
</script>
