---
import { siteUrl } from '@/lib/site-urls'

export const prerender = false
Astro.response.headers.set('Cache-Control', 'private, no-store')
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow')
Astro.response.headers.set('Referrer-Policy', 'no-referrer')
const destination = new URL(siteUrl('web', `/preview/guides/${encodeURIComponent(Astro.params.id ?? '')}`))
const token = Astro.url.searchParams.get('t')
if (token)
  destination.searchParams.set('t', token)
return Astro.redirect(destination.toString(), 302)
---
