---
import type { ArticleSecondaryCta } from '@/data/articles'

interface Props {
  cta: ArticleSecondaryCta
}

const { cta } = Astro.props
---

<section class="mx-auto max-w-[720px] px-5 pt-12 sm:px-6 lg:px-0">
  <div id="article-secondary-cta" class="rounded-3xl bg-art-soft px-6 py-8 text-center sm:px-10">
    <h2 class="font-heading text-xl leading-snug font-bold text-art-deep sm:text-2xl">{cta.title}</h2>
    <a
      href={cta.ctaHref}
      class="mt-5 inline-flex min-h-12 items-center rounded-xl bg-art px-7 font-heading text-base font-bold text-white transition-colors hover:bg-art-strong"
    >
      {cta.ctaLabel}
    </a>
  </div>
</section>

<script>
import { fadeUp, registerMotion } from '@/lib/motion'

registerMotion(() => {
  fadeUp(document.querySelectorAll('#article-secondary-cta'))
})
</script>
