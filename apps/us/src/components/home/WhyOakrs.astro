---
import { Image } from 'astro:assets'
import journeyIllustration from '@/assets/okrs/figure4.png'
import Wave from '@/components/common/Wave.astro'
import up from '@/assets/okrs/down.png'
import investmentBanner from '@/assets/okrs/figure3.png'
---

<div class="relative">
  <section class="bg-primary pt-4 pb-6 lg:pb-8">
    <Image
      src={investmentBanner}
      alt="The OAKRs Workshop is a valuable investment for any business that wants to improve its bottom line"
      class="h-auto w-full max-w-[1220px] -mt-8 rounded-3xl mx-auto sm:-mt-10 lg:-mt-14"
      widths={[758, 1220]}
      sizes="100vw"
      loading="lazy"
    />
    <Image
      src={up}
      alt=""
      class="pointer-events-none mx-auto h-auto w-full max-w-[1137px]"
    />
    <div class="mx-auto max-w-[1512px] px-6 lg:px-16">
      <h2 class="font-heading text-3xl font-bold text-white sm:text-4xl">
        Why <span class="text-gold">OAKRs</span>?
      </h2>
      <p class="mt-3 max-w-[560px] font-body text-white/85">
        We have added a step that links Objectives and Key Results with <strong class="font-bold">ACTIONS</strong>.
      </p>

      <Image
        src={journeyIllustration}
        alt="From Point A, where the business starts, to Point B, the objective reached through the OAKRs Workshop's step-by-step growth plan"
        class="ml-auto mt-16 h-auto w-full max-w-[1066px]"
        widths={[500, 900]}
        sizes="(min-width: 1024px) 900px, 80vw"
        loading="lazy"
      />
    </div>
  </section>

  <Wave color="text-mist-200" edge="top" class="absolute bottom-0 left-0 !h-[36px] w-full lg:!h-[56px]" />
</div>
