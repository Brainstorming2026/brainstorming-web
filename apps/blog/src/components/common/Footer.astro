---
import { Icon } from 'astro-icon/components'
import { Image } from 'astro:assets'
import { TURNSTILE_SITE_KEY } from 'astro:env/client'
import footerLogo from '@/assets/logos/footer-brainstormiing.webp'
import { redes } from '@/data/footer'

const SITE_URL = 'https://brainstorming.la'

const navegando = [
  { label: 'Brainstorming', href: SITE_URL },
  { label: 'Nosotros', href: `${SITE_URL}/nosotros` },
  { label: 'Soluciones', href: `${SITE_URL}/soluciones` },
  { label: 'Proyectos', href: `${SITE_URL}/proyectos` },
  { label: 'Blog', href: '/' },
  { label: 'Contacto', href: `${SITE_URL}/contacto` },
]

const oficinas = [
  { label: 'Lima, Perú' },
  { label: 'Barcelona, España' },
]
---

<footer class="text-white">
  <div class="bg-mist-100">
    <Icon name="footer-up" aria-hidden="true" class="block h-auto w-full select-none text-dark" />
  </div>

  <div class="bg-dark">
    <div class="mx-auto max-w-[1512px] px-6 py-12 lg:px-24 lg:py-16">
      <div class="grid gap-10 lg:grid-cols-3 lg:gap-8">
        <div>
          <h3 class="font-heading text-lg font-bold">Sigue navegando...</h3>
          <div class="mt-4 grid grid-cols-2 gap-x-8 gap-y-3">
            {
              navegando.map(l => (
                <a href={l.href} class="font-body text-sm text-white/70 transition-colors hover:text-primary-300">
                  {l.label}
                </a>
              ))
            }
          </div>
        </div>

        <div>
          <h3 class="font-heading text-lg font-bold">Contáctanos</h3>
          <ul class="mt-4 flex flex-col gap-3 text-sm">
            <li>
              <a href="mailto:cuentas@brainstorming.la" class="flex items-center gap-2.5 text-white/70 transition-colors hover:text-primary-300">
                <Icon name="footer-mail" class="h-4 w-4 shrink-0" />
                <span>cuentas@brainstorming.la</span>
              </a>
            </li>
            <li>
              <a href="https://wa.me/51993070396" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2.5 text-white/70 transition-colors hover:text-primary-300">
                <Icon name="footer-phone" class="h-4 w-4 shrink-0" />
                <span>+51 993 070 396</span>
              </a>
            </li>
          </ul>
        </div>

        <div>
          <h3 class="font-heading text-lg font-bold">Únete a nuestro Brainstorming Blog</h3>
          <form id="footer-newsletter-form" class="mt-4">
            <span class="font-body text-sm text-white/70">¡Suscríbete ya!</span>
            <div class="mt-2 flex gap-2">
              <input
                type="email"
                name="email"
                required
                class="w-full min-w-0 rounded-[8px] border border-white/20 bg-white/5 px-4 py-2.5 font-body text-sm text-white placeholder:text-white/40 focus:border-primary focus:outline-none"
              />
              <button
                type="submit"
                class="shrink-0 rounded-[8px] bg-primary px-5 py-2.5 font-heading text-sm font-bold text-white transition-colors hover:bg-primary-600"
              >
                Suscribirme
              </button>
            </div>
            <label class="hidden" aria-hidden="true">
              <input type="text" name="website" tabindex="-1" autocomplete="off" />
            </label>

            {TURNSTILE_SITE_KEY && (
              <div class="mt-2 cf-turnstile" data-sitekey={TURNSTILE_SITE_KEY} data-size="flexible" data-theme="dark" />
            )}
          </form>

          <ul class="mt-5 flex items-center gap-2">
            {
              redes.map(r => (
                <li>
                  <a href={r.href} target="_blank" rel="noopener noreferrer" aria-label={r.label} class="flex h-9 w-9 items-center justify-center rounded-full bg-white/10 text-white transition-colors hover:bg-primary">
                    <Icon name={r.name} class="h-10 w-10" />
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <div class="mt-10 flex flex-col items-start justify-between gap-6 border-t border-white/10 pt-8 sm:flex-row sm:items-center">
        <div>
          <Image src={footerLogo} alt="Brainstorming" class="h-7 w-auto" />
          <p class="mt-3 font-body text-sm text-white/70">Copyright © 2026 Brainstorming</p>
        </div>

        <ul class="flex flex-col gap-2 text-sm text-white/70 sm:items-end">
          {
            oficinas.map(o => (
              <li class="flex items-center gap-2">
                <Icon name="footer-map" class="h-4 w-4 shrink-0" />
                <span>{o.label}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</footer>

<script>
import { wireSubscribeForm } from '@/lib/wire-subscribe-form'

wireSubscribeForm(document.querySelector('#footer-newsletter-form'), 'Footer')
</script>
