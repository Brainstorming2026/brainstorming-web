---
import ConversationCta from '@/components/common/ConversationCta.astro'
import TransversalMotion from '@/components/common/TransversalMotion.astro'
import Clientes from '@/components/home/Clientes.astro'
import Hero from '@/components/home/Hero.astro'
import Problemas from '@/components/home/Problemas.astro'
import Results from '@/components/home/Results.astro'
import ServicesHub from '@/components/home/ServicesHub.astro'
import { homeContent } from '@/data/transversal-content'
import Layout from '@/layouts/Layout.astro'
import '@/styles/transversal.css'

export const prerender = true;
---

<Layout title={homeContent.title} description={homeContent.hero.subtitle}>
  <Hero />
  <Problemas />
  <Results />
  <ServicesHub />
  <Clientes />
  <ConversationCta id="home-final-conversation" final />
  <TransversalMotion />
</Layout>
