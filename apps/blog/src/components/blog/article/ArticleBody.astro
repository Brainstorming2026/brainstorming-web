---
import type { ArticleSection } from '@/data/articles'
import ArticleBlockView from '@/components/blog/article/ArticleBlockView.astro'
import { blockWidth } from '@/lib/article-layout'

interface Props {
  sections: ArticleSection[]
  /** Un id por sección (vacío sin subtítulo): los enlaces del índice apuntan a estos. */
  ids: string[]
}

const { sections, ids } = Astro.props

/** Lectura angosta, lo visual más ancho: la regla vive en `lib/article-layout.ts`. */
const widthClass = { narrow: 'mx-auto w-full max-w-[720px]', wide: 'w-full' } as const
---

<div id="article-body" class="mx-auto max-w-[1000px] px-5 py-10 sm:px-6 lg:py-12">
  <div class="flex flex-col gap-10 sm:gap-12">
    {sections.map((section, index) => (
      <section aria-labelledby={ids[index] || undefined}>
        {section.heading && (
          <div data-reveal class="mx-auto w-full max-w-[720px]">
            <span aria-hidden="true" class="block h-1.5 w-12 rounded-full bg-art"></span>
            <h2 id={ids[index]} class="mt-4 scroll-mt-24 font-heading text-[1.75rem] leading-[1.15] font-extrabold text-dark sm:text-4xl">{section.heading}</h2>
          </div>
        )}
        <div class:list={['flex flex-col gap-5 sm:gap-6', section.heading && 'mt-5']}>
          {section.blocks.map(block => (
            <div data-reveal class={widthClass[blockWidth(block)]}>
              <ArticleBlockView block={block} />
            </div>
          ))}
        </div>
      </section>
    ))}
  </div>
</div>

<script>
import { countUp, fadeUp, registerMotion } from '@/lib/motion'

registerMotion(() => {
  fadeUp(document.querySelectorAll('#article-body [data-reveal]'))
  document.querySelectorAll<HTMLElement>('#article-body [data-count]').forEach(el => countUp(el))
})
</script>
