---
import { Image } from 'astro:assets'
import celebration from '@/assets/projects/new/pastipan/celebracion.webp'
---

<div class="pastipan-cover" aria-label="Newstalgia, concepto creativo de Pastipan">
  <div class="pastipan-cover__story">
    <span class="pastipan-cover__eyebrow">Pastipan · Estrategia de marca</span>
    <div>
      <p>Un recuerdo compartido puede abrir una conversación nueva.</p>
      <strong>News<span>talgia.</span></strong>
    </div>
    <span class="pastipan-cover__footer">Investigación → concepto → contenido</span>
  </div>
  <div class="pastipan-cover__visual">
    <Image
      src={celebration}
      alt="Pieza real de Pastipan: una celebración entre amigos alrededor de sus productos."
      widths={[430]}
      sizes="(min-width: 768px) 430px, 85vw"
      loading="eager"
      fetchpriority="high"
    />
  </div>
</div>

<style>
  .pastipan-cover { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, .8fr); gap: clamp(24px, 5vw, 72px); min-height: 520px; overflow: hidden; border-radius: 8px; color: #5c211c; background: #fae9e2; }
  .pastipan-cover__story { display: flex; flex-direction: column; justify-content: space-between; min-width: 0; padding: clamp(30px, 5.5vw, 76px); }
  .pastipan-cover__eyebrow, .pastipan-cover__footer { font-size: 12px; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; }
  .pastipan-cover__story p { max-width: 23ch; margin-bottom: 18px; font: 500 clamp(21px, 2.8vw, 36px)/1.15 var(--font-heading); letter-spacing: -.035em; }
  .pastipan-cover__story strong { display: block; font: 650 clamp(52px, 6.4vw, 108px)/.96 var(--font-heading); letter-spacing: -.075em; overflow-wrap: anywhere; }
  .pastipan-cover__story strong span { color: #c12929; }
  .pastipan-cover__footer { color: #9b5146; }
  .pastipan-cover__visual { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 12px; min-width: 0; padding: 38px clamp(24px, 4vw, 60px) 28px 0; background: #d34a39; }
  .pastipan-cover__visual img { display: block; width: min(100%, 360px); height: auto; box-shadow: 0 24px 46px rgb(92 33 28 / 22%); }
  @media (max-width: 767px) {
    .pastipan-cover { grid-template-columns: 1fr; min-height: 0; gap: 0; }
    .pastipan-cover__story { gap: 30px; padding: 28px 24px 30px; }
    .pastipan-cover__story p { max-width: 28ch; margin-bottom: 12px; font-size: 22px; }
    .pastipan-cover__story strong { font-size: clamp(42px, 12vw, 68px); }
    .pastipan-cover__footer { font-size: 10px; }
    .pastipan-cover__visual { padding: 26px 24px; }
    .pastipan-cover__visual img { width: min(100%, 290px); }
  }
</style>
