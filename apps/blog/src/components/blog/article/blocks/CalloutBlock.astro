---
import type { BlockOf } from '@/data/articles'

interface Props {
  block: BlockOf<'callout'>
}

const { block } = Astro.props

/** Un estilo = colores, nombre por defecto e ícono. Agregar un estilo es agregar una entrada aquí. */
const STYLES = {
  tip: { name: 'Consejo', box: 'bg-art-soft', badge: 'bg-art text-white', label: 'text-art-strong', title: 'text-art-deep' },
  warning: { name: 'Atención', box: 'bg-warn-soft', badge: 'bg-warn text-white', label: 'text-warn', title: 'text-warn-deep' },
  idea: { name: 'Idea', box: 'bg-art-deep', badge: 'bg-art text-white', label: 'text-white/80', title: 'text-white' },
} as const

const style = STYLES[block.style]
const label = block.title || style.name
---

<aside class:list={['flex items-start gap-4 rounded-3xl p-5 sm:gap-5 sm:p-7', style.box]}>
  <span aria-hidden="true" class:list={['grid size-11 shrink-0 place-items-center rounded-2xl', style.badge]}>
    {block.style === 'tip' && (
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5" /><path d="M9 18h6" /><path d="M10 22h4" /></svg>
    )}
    {block.style === 'warning' && (
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m21.7 18-8-14a2 2 0 0 0-3.4 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.7-3Z" /><path d="M12 9v4" /><path d="M12 17h.01" /></svg>
    )}
    {block.style === 'idea' && (
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l2.4 5.6L20 9.3l-4.2 3.9L17 19l-5-3-5 3 1.2-5.8L4 9.3l5.6-.7z" /></svg>
    )}
  </span>
  <div class="min-w-0">
    <p class:list={['font-body text-xs font-bold tracking-wider uppercase', style.label]}>{label}</p>
    <p class:list={['mt-1.5 font-heading text-lg leading-snug font-semibold sm:text-xl', style.title]}>{block.text}</p>
  </div>
</aside>
