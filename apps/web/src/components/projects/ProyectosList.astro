---
import type { CategoriaTipo } from '@/data/proyectos'
import { categoriaLabels, proyectos } from '@/data/proyectos'
import ProjectListCard from './ProjectListCard.astro'

const iconMap: Record<CategoriaTipo, string> = {
  'branding': 'expert-huella-mono',
  'desarrollo-web': 'expert-window-mono',
  'inbound-marketing': 'expert-iman-mono',
}
---

<section id="proyectos-list" class="bg-section-dark">
  <div class="mx-auto max-w-[1512px] px-6 py-16 lg:px-24">
    {
      proyectos.map((p, i) => (
        <ProjectListCard
          first={i === 0}
          href={`/proyectos/${p.slug}`}
          icons={p.categorias.map(cat => iconMap[cat])}
          title={p.nombre}
          subtitle={p.categorias.map(c => categoriaLabels[c]).join(' / ')}
          image={{ src: p.imagen, alt: p.nombre }}
        />
      ))
    }
  </div>
</section>
