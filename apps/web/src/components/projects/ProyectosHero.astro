---
import { Image } from 'astro:assets'
import sectionBg from '@/assets/projects/Section.png'
---

<section
  id="proyectos-hero"
  class="relative h-screen overflow-hidden bg-section-dark"
>
  <Image
    id="proyectos-hero-bg"
    src={sectionBg}
    alt=""
    class="pointer-events-none absolute inset-0 h-full w-full object-cover object-bottom"
    loading="eager"
  />
  <div
    class="relative z-10 mx-auto flex h-full max-w-[1512px] flex-col justify-start px-6 pb-20 pt-25 lg:px-24"
  >
    <h1
      id="proyectos-hero-headline"
      data-animate
      class="max-w-[670px] font-heading text-[40px] font-bold leading-[56px] text-white sm:text-[60px] sm:leading-[100px]"
    >
      En nuestros proyectos hacemos tangibles nuestras soluciones.
    </h1>
    <p
      id="proyectos-hero-text"
      data-animate
      class="mt-5 max-w-[670px] text-[18px] leading-6 text-white/90 sm:text-[22px] sm:leading-[24px]"
    >
      Conoce los objetivos y soluciones creados para ellos.
    </p>
  </div>
</section>

<script>
import { ensureGsap, registerMotion, splitHeadline } from '@/lib/motion'
import { prefersReducedMotion } from '@/lib/motion/reduced-motion'

registerMotion(() => {
  const bg = document.getElementById('proyectos-hero-bg')
  const headline = document.getElementById('proyectos-hero-headline')
  const text = document.getElementById('proyectos-hero-text')
  const { gsap } = ensureGsap()

  if (text && !prefersReducedMotion()) gsap.set(text, { opacity: 0, y: 10 })

  if (headline) {
    splitHeadline(headline, { by: 'words', scrollTrigger: false, onComplete: () => {
      if (text) gsap.to(text, { opacity: 1, y: 0, duration: 0.5 })
    } })
  }
  if (bg && !prefersReducedMotion()) gsap.fromTo(bg, { scale: 1 }, { scale: 1.06, duration: 8, ease: 'none' })
})
</script>
