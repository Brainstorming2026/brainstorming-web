---
import { Icon } from 'astro-icon/components'
import { salesBenefits, salesSteps } from '@/data'
---

<section class="bg-gradient-to-b from-mist to-white">
  <div class="mx-auto max-w-[1140px] px-6 py-20 lg:px-24">
    <h2 class="text-center font-heading text-2xl font-bold text-dark sm:text-3xl">
      ¿Cómo funciona el proceso de Inbound Sales?
    </h2>
    <p class="mx-auto mt-4 max-w-[700px] text-center text-[15px] leading-6 text-dark-500">
      Conoce los 6 pasos que seguimos para lograr que la experiencia de compra esté siempre
      alineada al contexto de tus usuarios.
    </p>

    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        salesSteps.map((step, index) => (
          <div class="flex items-center gap-4 rounded-2xl border border-black/10 bg-white p-5 shadow-sm">
            <span class="font-heading text-3xl font-bold text-primary">{index + 1}</span>
            <Icon name={step.icon} class="h-9 w-9 flex-shrink-0 text-primary" />
            <p class="text-[13.5px] leading-5 text-dark-500">{step.text}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<section class="bg-white py-16">
  <div class="mx-auto max-w-[1140px] px-6 lg:px-24">
    <h2 class="text-center font-heading text-2xl font-bold text-dark sm:text-3xl">
      ¿En qué puede esto ayudar a tu negocio?
    </h2>

    <div class="mt-10 grid gap-8 sm:grid-cols-2">
      <ul class="space-y-4">
        {
          salesBenefits.left.map((text) => (
            <li class="flex items-start gap-3">
              <Icon name="sales-check" class="mt-1 h-3 w-auto flex-shrink-0" />
              <span class="text-[15px] leading-6 text-dark-500">{text}</span>
            </li>
          ))
        }
      </ul>
      <ul class="space-y-4">
        {
          salesBenefits.right.map((text) => (
            <li class="flex items-start gap-3">
              <Icon name="sales-check" class="mt-1 h-3 w-auto flex-shrink-0" />
              <span class="text-[15px] leading-6 text-dark-500">{text}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
