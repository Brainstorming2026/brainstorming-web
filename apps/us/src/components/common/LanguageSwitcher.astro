---
import { Icon } from 'astro-icon/components'

interface Locale {
  code: string
  label: string
  flag: string
  available: boolean
}

const locales: Locale[] = [
  { code: 'en', label: 'English', flag: 'flag-us', available: true },
  { code: 'es', label: 'Español', flag: 'flag-es', available: false },
]

const current = locales[0]
---

<div class="relative" data-language-switcher>
  <button
    type="button"
    class="flex items-center gap-2 rounded-full bg-white py-1.5 pr-3 pl-1.5 font-heading text-sm font-bold text-dark shadow-sm"
    aria-haspopup="listbox"
    aria-expanded="false"
    data-language-trigger
  >
    <Icon name={current.flag} class="h-5 w-5 shrink-0 rounded-full" />
    <span>{current.code.toUpperCase()}</span>
    <Icon name="chevron-down" class="h-3.5 w-3.5 text-dark/50 transition-transform" data-language-chevron />
  </button>

  <ul
    role="listbox"
    class="pointer-events-none absolute right-0 top-[calc(100%+8px)] z-20 w-44 origin-top-right scale-95 rounded-xl bg-white p-1.5 opacity-0 shadow-lg transition-all duration-150"
    data-language-menu
  >
    {
      locales.map(locale => (
        <li>
          {locale.available ? (
            <a
              href="/"
              role="option"
              aria-selected={locale.code === current.code}
              class:list={[
                'flex items-center gap-2.5 rounded-lg px-2.5 py-2 font-body text-sm',
                locale.code === current.code ? 'bg-mist/60 font-bold text-dark' : 'text-dark/70 hover:bg-mist/40',
              ]}
            >
              <Icon name={locale.flag} class="h-5 w-5 shrink-0 rounded-full" />
              {locale.label}
            </a>
          ) : (
            <span
              role="option"
              aria-disabled="true"
              aria-selected="false"
              title="Versión en español próximamente"
              class="flex cursor-not-allowed items-center gap-2.5 rounded-lg px-2.5 py-2 font-body text-sm text-dark/35"
            >
              <Icon name={locale.flag} class="h-5 w-5 shrink-0 rounded-full grayscale" />
              {locale.label}
              <span class="ml-auto text-[10px] font-bold tracking-wide uppercase">Soon</span>
            </span>
          )}
        </li>
      ))
    }
  </ul>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-language-switcher]').forEach((root) => {
    const trigger = root.querySelector<HTMLButtonElement>('[data-language-trigger]')
    const menu = root.querySelector<HTMLElement>('[data-language-menu]')
    const chevron = root.querySelector<HTMLElement>('[data-language-chevron]')
    if (!trigger || !menu)
      return

    const close = () => {
      trigger.setAttribute('aria-expanded', 'false')
      menu.classList.add('pointer-events-none', 'opacity-0', 'scale-95')
      chevron?.classList.remove('rotate-180')
    }

    const toggle = () => {
      const isOpen = trigger.getAttribute('aria-expanded') === 'true'
      if (isOpen) {
        close()
      }
      else {
        trigger.setAttribute('aria-expanded', 'true')
        menu.classList.remove('pointer-events-none', 'opacity-0', 'scale-95')
        chevron?.classList.add('rotate-180')
      }
    }

    trigger.addEventListener('click', (e) => {
      e.stopPropagation()
      toggle()
    })
    document.addEventListener('click', close)
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape')
        close()
    })
  })
</script>
