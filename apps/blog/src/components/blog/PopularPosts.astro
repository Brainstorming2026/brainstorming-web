---
import PostRow from '@/components/blog/PostRow.astro'
import { popularPosts } from '@/data/posts'
---

<section class="mx-auto max-w-[1140px] px-6 pb-16 lg:px-16">
  <h2 class="font-heading text-lg font-bold text-dark">CONTENIDOS MÁS POPULARES</h2>

  <div class="mt-6 grid gap-10 lg:grid-cols-[1fr_320px]">
    <div class="flex flex-col gap-8">
      {popularPosts.map(post => <PostRow post={post} />)}
    </div>

    <a
      href="https://brainstorming.la/contacto"
      class="flex flex-col items-center justify-center rounded-[16px] bg-gradient-to-b from-primary to-navy px-8 py-12 text-center text-white transition-opacity hover:opacity-95"
    >
      <p class="font-heading text-2xl font-bold leading-snug">Actuamos para lograr tus objetivos de negocio</p>
      <span class="mt-6 rounded-[10px] bg-accent px-6 py-3 font-heading text-sm font-bold text-white transition-colors hover:bg-accent-600">
        ¡Descubre cómo!
      </span>
    </a>
  </div>
</section>
