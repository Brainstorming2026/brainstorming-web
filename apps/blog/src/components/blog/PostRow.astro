---
import type { Post } from '@/data/posts'
import { Image } from 'astro:assets'

interface Props {
  post: Post
}

const { post } = Astro.props
---

<article class="flex gap-4 sm:gap-6">
  <a href={`/${post.slug}`} class="block aspect-[4/3] w-32 shrink-0 overflow-hidden rounded-[10px] bg-mist-200 sm:w-44">
    {post.image && (
      <Image
        src={post.image}
        alt=""
        class="h-full w-full object-cover"
        widths={[176, 320]}
        sizes="176px"
        loading="lazy"
      />
    )}
  </a>
  <div class="flex flex-col justify-center">
    <a href={`/${post.slug}`} class="font-heading text-sm font-bold uppercase leading-snug text-dark transition-colors hover:text-primary sm:text-base">
      {post.title}
    </a>
    <p class="mt-2 line-clamp-2 font-body text-sm text-dark/60">{post.excerpt}</p>
    <a href={`/${post.slug}`} class="mt-2 inline-block font-heading text-xs font-bold text-primary hover:underline">
      Leer Más &gt;&gt;
    </a>
  </div>
</article>
