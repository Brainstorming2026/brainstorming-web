---
import { Icon } from 'astro-icon/components'
import { getLang, localizePath } from '@/i18n/utils'

interface Locale {
  code: 'en' | 'es'
  label: string
  flag: string
}

const locales: Locale[] = [
  { code: 'en', label: 'English', flag: 'flag-us' },
  { code: 'es', label: 'Español', flag: 'flag-es' },
]

const lang = getLang(Astro.url)
const current = locales.find(l => l.code === lang) ?? locales[0]

// Para "/" y "/es" mapeamos directo a home; el resto de rutas son anclas
// dentro de la misma página, por eso basta con re-localizar "/".
const targetPath = localizePath('/', lang === 'en' ? 'es' : 'en')
---

<div class="relative" data-language-switcher>
  <button
    type="button"
    class="flex items-center gap-2 rounded-full bg-white py-1.5 pr-3 pl-1.5 font-heading text-sm font-bold text-dark shadow-sm"
    aria-haspopup="listbox"
    aria-expanded="false"
    data-language-trigger
  >
    <Icon name={current.flag} class="h-5 w-5 shrink-0 rounded-full" />
    <span>{current.code.toUpperCase()}</span>
    <Icon name="chevron-down" class="h-3.5 w-3.5 text-dark/50 transition-transform" data-language-chevron />
  </button>

  <ul
    role="listbox"
    class="pointer-events-none absolute right-0 top-[calc(100%+8px)] z-20 w-44 origin-top-right scale-95 rounded-xl bg-white p-1.5 opacity-0 shadow-lg transition-all duration-150"
    data-language-menu
  >
    {
      locales.map(locale => (
        <li>
          <a
            href={locale.code === lang ? undefined : (locale.code === 'en' ? localizePath('/', 'en') : targetPath)}
            role="option"
            aria-selected={locale.code === lang}
            aria-disabled={locale.code === lang}
            class:list={[
              'flex items-center gap-2.5 rounded-lg px-2.5 py-2 font-body text-sm',
              locale.code === lang ? 'pointer-events-none bg-mist/60 font-bold text-dark' : 'text-dark/70 hover:bg-mist/40',
            ]}
          >
            <Icon name={locale.flag} class="h-5 w-5 shrink-0 rounded-full" />
            {locale.label}
          </a>
        </li>
      ))
    }
  </ul>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-language-switcher]').forEach((root) => {
    const trigger = root.querySelector<HTMLButtonElement>('[data-language-trigger]')
    const menu = root.querySelector<HTMLElement>('[data-language-menu]')
    const chevron = root.querySelector<HTMLElement>('[data-language-chevron]')
    if (!trigger || !menu)
      return

    const close = () => {
      trigger.setAttribute('aria-expanded', 'false')
      menu.classList.add('pointer-events-none', 'opacity-0', 'scale-95')
      chevron?.classList.remove('rotate-180')
    }

    const toggle = () => {
      const isOpen = trigger.getAttribute('aria-expanded') === 'true'
      if (isOpen) {
        close()
      }
      else {
        trigger.setAttribute('aria-expanded', 'true')
        menu.classList.remove('pointer-events-none', 'opacity-0', 'scale-95')
        chevron?.classList.add('rotate-180')
      }
    }

    trigger.addEventListener('click', (e) => {
      e.stopPropagation()
      toggle()
    })
    document.addEventListener('click', close)
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape')
        close()
    })
  })
</script>
