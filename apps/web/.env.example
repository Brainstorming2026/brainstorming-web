RESEND_API_KEY=
CORREO_TIPO=resend
CORREO_FROM=
CORREO_REPLY_TO=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Ambientes ────────────────────────────────────────────────────────────────
# Cada app lee .env.development (`astro dev`) y .env.production (build); en Vercel
# las variables del proyecto prevalecen. Puertos de desarrollo fijos en config/sites.mjs:
# web 4321 · us 4322 · blog 4323. Sin definir, `astro dev` apunta a localhost y el build
# a producción. Solo se definen para un entorno distinto (preview de Vercel, staging).
# WEB_URL=https://www.brainstorming.la
# US_URL=https://us.brainstorming.la
# BLOG_URL=https://blog.brainstorming.la

# Contenido desde el CMS (ver brainstorming-cms-api/docs/ENVIRONMENTS.md).
# CONTENT_SOURCE=cms lee el CMS; sin definirla se usa el contenido incluido en src/data (mientras dura la migración).
# Desarrollo (.env.development):  CMS_API_URL=http://localhost:8787
# Producción (.env.production):   CMS_API_URL=https://cms-api.brainstorming.la
#                                 CMS_FILES_URL=https://files.brainstorming.la  (opcional; ese es el valor por defecto)
# En desarrollo, las imágenes y PDF del CMS local se aceptan desde el origen de CMS_API_URL.
CONTENT_SOURCE=static
CMS_API_URL=
CMS_FILES_URL=
CMS_CONTENT_TOKEN=
