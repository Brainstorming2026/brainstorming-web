---
import { getImage, Image } from 'astro:assets'
import heroBg from '@/assets/nosotros/nosotros-hero-desktop-hd.png'
import heroMobileBg from '@/assets/nosotros/nosotros-hero-mobile.png'
import { aboutContent } from '@/data/transversal-content'

const heroMobileWebp = await getImage({
  src: heroMobileBg,
  width: 1080,
  height: 1920,
  format: 'webp',
  quality: 92,
})
---

<section
  class="relative isolate flex min-h-[min(680px,calc(100svh-5rem))] overflow-hidden bg-indigo lg:min-h-[calc(100vh-5rem)]"
>
  <picture>
    <source media="(max-width: 1023px)" srcset={heroMobileWebp.src} type="image/webp" />
    <Image
      id="about-hero-bg"
      src={heroBg}
      alt=""
      class="pointer-events-none absolute inset-0 h-full w-full object-cover object-center"
      loading="eager"
      fetchpriority="high"
      widths={[768, 1280, 1920]}
      sizes="100vw"
      quality={80}
    />
  </picture>
  <div
    class="relative z-10 mx-auto flex w-full max-w-[1512px] items-end px-6 pb-12 pt-48 sm:px-10 sm:pb-16 lg:items-center lg:justify-end lg:px-24 lg:py-24"
  >
    <div class="w-full max-w-[580px] lg:max-w-[520px]">
      <h1 id="about-hero-headline" data-animate class="font-heading text-[clamp(2rem,4.3vw,3.5rem)] font-bold leading-[1.08] tracking-[-0.035em] text-white">
        {aboutContent.title}
      </h1>
      <div id="about-hero-line" data-animate="draw" class="mt-5 h-[3px] w-12 bg-white"></div>
    </div>
  </div>
</section>

<script>
import { drawLine, ensureGsap, prefersReducedMotion, registerMotion, splitHeadline } from '@/lib/motion'

registerMotion(() => {
  const bg = document.getElementById('about-hero-bg')
  const headline = document.getElementById('about-hero-headline')
  const line = document.getElementById('about-hero-line')
  const { gsap } = ensureGsap()

  // Oculto YA (no recién cuando termine el titular) — evita el flash de
  // contenido visible antes de animar.
  if (line && !prefersReducedMotion())
    gsap.set(line, { scaleX: 0, transformOrigin: '0% 50%' })

  if (headline) {
    splitHeadline(headline, { by: 'words', scrollTrigger: false, onComplete: () => {
      if (line)
        drawLine(line)
    } })
  }

  if (bg && !prefersReducedMotion())
    gsap.fromTo(bg, { scale: 1 }, { scale: 1.06, duration: 8, ease: 'none' })
})
</script>
