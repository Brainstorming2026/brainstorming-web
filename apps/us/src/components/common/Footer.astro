---
import { Image } from 'astro:assets'
import logo from '@/assets/brainstorming/logo.png'

const year = new Date().getFullYear()
---

<footer class="bg-dark py-10 text-center text-white">
  <div class="mx-auto flex max-w-[1512px] flex-col items-center gap-4 px-6">
    <a href="/">
      <Image src={logo} alt="Brainstorming" class="h-7 w-auto" widths={[200, 400]} sizes="200px" />
    </a>
    <p class="font-body text-sm text-white/60">
      Copyright &copy; {year} Brainstorming
    </p>
  </div>
</footer>
