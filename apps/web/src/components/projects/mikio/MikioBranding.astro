---
import { Image } from 'astro:assets'
import { Icon } from 'astro-icon/components'
import brandingBg from '@/assets/projects/mikio/bg2.png'
import colorsImg from '@/assets/projects/mikio/colors.png'

const lineas = ['Creación de', 'Manual de', 'Identidad de', 'Marca']
---

<section id="branding-intro" class="relative overflow-hidden bg-white py-16 lg:py-20">
  <Image
    id="branding-bg"
    src={brandingBg}
    alt=""
    class="pointer-events-none absolute inset-0 h-full w-full object-cover object-top"
    loading="lazy"
    widths={[758, 1512]}
    sizes="100vw"
  />
  <div class="relative z-10 mx-auto max-w-[1512px] px-6 lg:px-24">
    <div class="grid gap-12 lg:grid-cols-2 lg:items-center">
      <div>
        <div id="branding-label" class="flex items-center gap-2 font-heading text-sm font-bold text-dark">
          <Icon name="expert-huella" class="h-6 w-6 text-dark-300" />
          <span>Branding</span>
        </div>

        <h2 id="branding-heading" class="mt-4 font-heading text-3xl font-bold leading-tight text-dark sm:text-6xl">
          {
            lineas.map(linea => (
              <span class="heading-line relative block py-1">
                {linea}
              </span>
            ))
          }
        </h2>
      </div>

      <div class="lg:min-h-[420px]" aria-hidden="true"></div>
    </div>
  </div>
</section>

<section id="branding-detail" class="bg-white pb-16 lg:pb-20">
  <div class="mx-auto max-w-[1512px] px-6 lg:px-24">
    <div class="grid gap-10 lg:grid-cols-[1fr_auto] lg:items-center">
      <p id="branding-desc" class="max-w-[440px] text-[14px] leading-6 text-dark-500">
        Creamos una identidad de marca que refleja su promesa de valor: con Mikio Car Wash, te das
        el placer de engreír a tu auto desde la comodidad de tu hogar. Los colores elegidos
        comunican la frescura y limpieza que conlleva el servicio. Incluso, en el logo, le dimos a
        una de sus letras una connotación de la forma de manguera y la gota de agua cayendo.
      </p>

      <div id="branding-colors-wrap" class="mx-auto h-auto w-full max-w-[560px] overflow-hidden">
        <Image
          src={colorsImg}
          alt="Paleta de colores de Mikio Car Wash"
          class="branding-colors-img h-auto w-full"
          loading="lazy"
        />
      </div>
    </div>
  </div>
</section>

<script>
import { ensureGsap, registerMotion, revealClip } from '@/lib/motion'
import { ease } from '@/lib/motion/config'
import { prefersReducedMotion } from '@/lib/motion/reduced-motion'

registerMotion(() => {
  const bg = document.getElementById('branding-bg')
  const label = document.getElementById('branding-label')
  const lines = document.querySelectorAll('#branding-heading .heading-line')
  const desc = document.getElementById('branding-desc')
  const colorsWrap = document.getElementById('branding-colors-wrap')

  const { gsap } = ensureGsap()

  if (prefersReducedMotion()) {
    gsap.fromTo([label, ...lines, desc].filter(Boolean), { opacity: 0 }, { opacity: 1, duration: 0.4, stagger: 0.06 })
    return
  }

  if (bg) gsap.fromTo(bg, { scale: 1 }, { scale: 1.06, duration: 10, ease: 'none' })
  if (label) gsap.fromTo(label, { opacity: 0, y: 10 }, { opacity: 1, y: 0, duration: 0.5, ease: ease.out })
  if (lines.length > 0) {
    gsap.set(lines, { opacity: 0, y: '100%' })
    gsap.to(lines, { opacity: 1, y: '0%', duration: 1.0, ease: ease.out, stagger: 0.12, delay: 0.2 })
  }

  if (desc) {
    gsap.set(desc, { opacity: 0, y: 16 })
    gsap.to(desc, { opacity: 1, y: 0, duration: 1.0, ease: ease.out, scrollTrigger: { trigger: '#branding-detail', start: 'top 85%' } })
  }
  if (colorsWrap) revealClip(colorsWrap, { direction: 'up' })
})
</script>
