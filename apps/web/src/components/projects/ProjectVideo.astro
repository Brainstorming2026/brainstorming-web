---
import type { ImageMetadata } from 'astro'
import { Icon } from 'astro-icon/components'
import { Image } from 'astro:assets'

interface Props {
  youtubeId: string
  title: string
  poster: ImageMetadata
  priority?: boolean
  className?: string
}

const { youtubeId, title, poster, priority = false, className = '' } = Astro.props
---

<div class:list={['project-video group relative aspect-video overflow-hidden rounded-3xl bg-dark shadow-lg', className]} data-project-video-id={youtubeId} data-project-video-title={title}>
  <Image src={poster} alt="" class="h-full w-full object-cover" widths={[480, 800, 1200]} sizes="(min-width: 1024px) 800px, 90vw" loading={priority ? 'eager' : 'lazy'} fetchpriority={priority ? 'high' : 'auto'} />
  <button type="button" aria-label={`Reproducir ${title}`} class="project-video-play absolute inset-0 flex items-center justify-center bg-black/10 text-white/90 transition-colors focus-visible:outline-4 focus-visible:outline-offset-4 focus-visible:outline-primary">
    <span class="project-video-ring relative flex items-center justify-center rounded-full">
      <Icon name="play" class="h-20 w-20 drop-shadow-lg transition-transform" aria-hidden="true" />
    </span>
  </button>
  <noscript><a href={`https://www.youtube.com/watch?v=${youtubeId}`} class="absolute inset-0 z-10 flex items-center justify-center bg-black/60 font-heading font-bold text-white">Ver {title} en YouTube</a></noscript>
</div>

<style>
  .project-video-ring::after {
    content: '';
    position: absolute;
    inset: 4px;
    border: 2px solid rgb(255 255 255 / .7);
    border-radius: inherit;
    animation: project-video-ring 2.6s cubic-bezier(.16,1,.3,1) infinite;
    pointer-events: none;
  }
  @keyframes project-video-ring {
    0% { transform: scale(.9); opacity: .8; }
    70%, 100% { transform: scale(1.45); opacity: 0; }
  }
  @media (hover: hover) and (pointer: fine) {
    .project-video-play:hover { background: rgb(0 0 0 / .2); }
    .project-video-play:hover .project-video-ring::after { animation-play-state: paused; opacity: 0; }
    .project-video-play:hover svg { transform: scale(1.1); }
  }
  @media (prefers-reduced-motion: reduce) {
    .project-video-ring::after { animation: none; opacity: 0; }
    .project-video-play, .project-video-play svg { transition: none; }
  }
</style>

<script>
document.addEventListener('click', (event) => {
  if (!(event.target instanceof Element))
    return
  const play = event.target.closest<HTMLButtonElement>('.project-video-play')
  const stage = play?.closest<HTMLElement>('.project-video[data-project-video-id]')
  if (!stage)
    return
  const iframe = document.createElement('iframe')
  iframe.title = stage.dataset.projectVideoTitle ?? 'Video del proyecto'
  iframe.src = `https://www.youtube-nocookie.com/embed/${stage.dataset.projectVideoId}?autoplay=1&rel=0`
  iframe.className = 'absolute inset-0 h-full w-full border-0'
  iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share'
  iframe.allowFullscreen = true
  stage.replaceChildren(iframe)
  iframe.focus()
})
</script>
