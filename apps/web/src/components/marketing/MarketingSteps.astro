---
import { Image } from 'astro:assets'
import { Icon } from 'astro-icon/components'
import { marketingBenefits } from '@/data'
import marketing1 from '@/assets/marketing/marketing-1.png'
import marketing2 from '@/assets/marketing/marketing-2.png'

const rowImages = [marketing1, marketing2]
---

<section class="bg-gradient-to-b from-mist from-0% via-white via-35% to-white">
  <div class="mx-auto max-w-[1140px] px-6 py-20 lg:px-24">
    <h2 id="marketing-steps-headline" class="text-center font-heading text-2xl font-bold text-dark sm:text-3xl">
      Nuestro proceso de trabajo nos ayuda a crear y comunicar
      <br class="hidden sm:block" />
      estratégicamente tu marca.
    </h2>

    <div id="marketing-steps-imgs" class="mt-12 space-y-6">
      <Image
        class="marketing-step-img mx-auto h-auto w-full"
        src={rowImages[0]}
        alt="Proceso paso 1-3"
        widths={[560, 1120]}
        sizes="(min-width: 1140px) 1120px, 100vw"
        loading="lazy"
      />
      <Image
        class="marketing-step-img mx-auto h-auto w-full"
        src={rowImages[1]}
        alt="Proceso paso 4-6"
        widths={[560, 1120]}
        sizes="(min-width: 1140px) 1120px, 100vw"
        loading="lazy"
      />
    </div>
  </div>
</section>

<section class="bg-white py-16">
  <div class="mx-auto max-w-[1140px] px-6 lg:px-24">
    <h2 id="marketing-benefits-headline" class="text-center font-heading text-2xl font-bold text-dark sm:text-3xl">
      ¿En qué puede ayudar esto a tu marca?
    </h2>

    <div id="marketing-benefits" class="mt-10 grid gap-8 sm:grid-cols-2">
      <ul class="space-y-4">
        {
          marketingBenefits.left.map((text) => (
            <li class="benefit-item flex items-start gap-3">
              <Icon name="marketing-check" class="mt-1 h-3 w-auto flex-shrink-0" />
              <span class="text-[15px] leading-6 text-dark-500">{text}</span>
            </li>
          ))
        }
      </ul>
      <ul class="space-y-4">
        {
          marketingBenefits.right.map((text) => (
            <li class="benefit-item flex items-start gap-3">
              <Icon name="marketing-check" class="mt-1 h-3 w-auto flex-shrink-0" />
              <span class="text-[15px] leading-6 text-dark-500">{text}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<script>
import { registerMotion, revealClip, splitHeadline, staggerGrid } from '@/lib/motion'

registerMotion(() => {
  const stepsHeadline = document.getElementById('marketing-steps-headline')
  const imgs = document.querySelectorAll<HTMLElement>('#marketing-steps-imgs .marketing-step-img')
  const benefitsHeadline = document.getElementById('marketing-benefits-headline')
  const benefits = document.querySelectorAll('#marketing-benefits .benefit-item')

  if (stepsHeadline) splitHeadline(stepsHeadline, { by: 'lines' })
  imgs.forEach(img => revealClip(img, { direction: 'up', mode: 'scrub' }))
  if (benefitsHeadline) splitHeadline(benefitsHeadline, { by: 'lines' })
  staggerGrid(benefits, { variant: 'organic' })
})
</script>
