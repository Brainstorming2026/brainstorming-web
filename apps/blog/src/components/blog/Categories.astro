---
import { Icon } from 'astro-icon/components'
import { categories } from '@/data/posts'
---

<section class="bg-black py-14">
  <div class="mx-auto max-w-[1140px] px-6 lg:px-16">
    <h2 class="font-heading text-lg font-bold text-white">CATEGORÍAS</h2>

    <div class="mx-auto mt-6 grid max-w-[720px] gap-4 sm:grid-cols-2">
      {categories.map(category => (
        <a
          href={`/${category.slug}`}
          class="flex items-center gap-4 rounded-[10px] bg-primary px-6 py-4 text-white transition-colors hover:bg-primary-600"
        >
          <Icon name={category.icon} class="h-7 w-7 shrink-0" />
          <span class="font-heading text-base font-bold">{category.label}</span>
        </a>
      ))}
    </div>
  </div>
</section>
