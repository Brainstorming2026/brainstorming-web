    <h1 class="font-heading text-[36px] font-bold text-dark sm:text-[44px]">
      CONTACTO
    </h1>
    <div class="mt-6 flex flex-col items-center justify-center gap-4 text-sm text-dark-600 sm:flex-row sm:gap-8 sm:text-base">
      <a
        href="mailto:conversemos@brainstorming.la"
        class="flex items-center gap-2 transition-colors hover:text-primary"
      >
        <Icon name="footer-mail" class="h-5 w-5 shrink-0" />
        <span>conversemos@brainstorming.la</span>
      </a>
      <a
        href="https://wa.me/51992528363"
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-2 transition-colors hover:text-primary"
      >
        <Icon name="footer-phone" class="h-5 w-5 shrink-0" />
        <span>+51 992 528 363</span>
      </a>
    </div>
