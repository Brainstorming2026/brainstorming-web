---
import { Icon } from 'astro-icon/components'
import SolutionProcessCards from '@/components/solutions/SolutionProcessCards.astro'
import { procesosBenefits, procesosSteps } from '@/data'
---

<section class="bg-mist py-16">
  <div class="mx-auto max-w-[1140px] px-6 text-center lg:px-24">
    <h2 id="procesos-steps-headline" class="font-heading text-2xl font-bold text-dark sm:text-3xl">
      ¡Conoce el Proceso detrás de los procesos!
    </h2>
    <p class="mx-auto mt-4 max-w-2xl text-[15px] leading-6 text-dark-500">
      A lo largo de nuestra experiencia, hemos identificado las siguientes 9 etapas en la mejora continua
      de una organización.
    </p>
  </div>
</section>

<section class="bg-white py-20">
  <div class="mx-auto max-w-[1140px] px-6 lg:px-24">
    <SolutionProcessCards
      steps={procesosSteps}
      accent="#f17900"
      softAccent="#fff4e8"
      label="Etapas de optimización de procesos"
    />
  </div>
</section>

<section class="bg-white pb-16">
  <div class="mx-auto max-w-[1140px] px-6 lg:px-24">
    <h2 id="procesos-benefits-headline" class="text-center font-heading text-2xl font-bold text-dark sm:text-3xl">
      ¿En qué puede esto ayudar a tu negocio?
    </h2>

    <div id="procesos-benefits" class="mt-10 grid gap-8 sm:grid-cols-2">
      <ul class="space-y-4">
        {
          procesosBenefits.left.map(text => (
            <li class="benefit-item flex items-start gap-3">
              <Icon name="sales-check" class="mt-1 h-3 w-auto flex-shrink-0 text-orange" />
              <span class="text-[15px] leading-6 text-dark-500">{text}</span>
            </li>
          ))
        }
      </ul>
      <ul class="space-y-4">
        {
          procesosBenefits.right.map(text => (
            <li class="benefit-item flex items-start gap-3">
              <Icon name="sales-check" class="mt-1 h-3 w-auto flex-shrink-0 text-orange" />
              <span class="text-[15px] leading-6 text-dark-500">{text}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<script>
import { registerMotion, splitHeadline, staggerGrid } from '@/lib/motion'

registerMotion(() => {
  const headline = document.getElementById('procesos-steps-headline')
  const benefitsHeadline = document.getElementById('procesos-benefits-headline')
  const benefits = document.querySelectorAll('#procesos-benefits .benefit-item')

  if (headline)
    splitHeadline(headline, { by: 'lines' })
  if (benefitsHeadline)
    splitHeadline(benefitsHeadline, { by: 'lines' })
  staggerGrid(benefits, { variant: 'organic' })
})
</script>
