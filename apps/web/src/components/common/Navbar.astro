---
import { Icon } from 'astro-icon/components'
import { Image } from 'astro:assets'
import logo from '@/assets/logos/brainstorming-logo.webp'
import { navLinks as links, redes } from '@/data'
import { siteContact, siteRoutes } from '@/data/site-navigation'

const currentPath = Astro.url.pathname

---

<header class="fixed inset-x-0 top-0 z-50 border-b border-black/10 bg-white">
  <nav
    class="mx-auto flex h-20 max-w-[1512px] items-center justify-between gap-3 px-6 sm:gap-4 xl:px-16"
    aria-label="Principal"
  >
    <a href="/" class="shrink-0" aria-label="Brainstorming — inicio">
      <Image
        src={logo}
        alt="Brainstorming"
        class="h-6 w-auto sm:h-8"
        widths={[200, 300, 400]}
        sizes="220px"
        quality={80}
      />
    </a>

    <ul class="hidden items-center lg:flex xl:gap-1">
      {
        links.map((link) => {
          const isActive = link.href !== '/' && currentPath.startsWith(link.href)
          const hasDropdown = link.children && link.children.length > 0
          const isExternal = link.href.startsWith('http')
          return (
            <li class="relative group">
              <a
                href={link.href}
                target={isExternal ? '_blank' : undefined}
                rel={isExternal ? 'noopener noreferrer' : undefined}
                class:list={[
                  'flex items-center gap-1.5 whitespace-nowrap px-2 py-2 font-heading text-[15px] font-bold transition-colors hover:text-primary xl:px-3 xl:text-base',
                  isActive ? 'text-primary' : 'text-ink',
                ]}
              >
                {link.label}
                {hasDropdown && (
                  <Icon name="chevron-down" class="h-2.5 w-2.5" />
                )}
              </a>
              {hasDropdown && (
                <ul class="invisible absolute left-0 top-full z-50 w-[320px] rounded-[10px] border border-black/10 bg-white py-2 shadow-lg opacity-0 transition-[opacity,visibility] duration-200 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100">
                  {link.children?.map(child => (
                    <li class:list={{ 'mt-2 border-t border-black/10 pt-2': child.complementary }}>
                      <a
                        href={child.href}
                        class="block px-4 py-2.5 text-[15px] font-bold text-ink transition-colors hover:bg-primary/5 hover:text-primary"
                      >
                        {child.label}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          )
        })
      }
    </ul>

    <div class="flex shrink-0 items-center gap-1">
      <!-- CTA visible en todos los tamaños: en móvil, compacto junto a la
           hamburguesa (se oculta solo bajo 360px, donde no entra). -->
      <a
        href="/contacto"
        class="nav-cta hidden shrink-0 rounded-[10px] bg-primary px-3.5 py-2 text-center text-[13px] font-semibold text-white transition-colors hover:bg-primary-600 min-[360px]:inline-block lg:px-4 lg:py-2.5 lg:text-sm xl:px-6"
      >
        <span class="lg:hidden">Agendar</span>
        <span class="hidden lg:inline">Agendar Asesoría</span>
      </a>

      <button
        type="button"
        id="nav-toggle"
        class="nav-toggle relative flex h-11 w-11 items-center justify-center text-ink lg:hidden"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="nav-toggle-line" aria-hidden="true"></span>
        <span class="nav-toggle-line" aria-hidden="true"></span>
      </button>
    </div>
  </nav>

  <!-- Menú móvil a pantalla completa, centrado: navegación, redes y CTA. -->
  <div
    id="mobile-menu"
    class="mobile-menu fixed inset-x-0 top-20 bottom-0 flex flex-col overflow-y-auto overscroll-contain bg-white lg:hidden"
    data-open="false"
  >
    <div class="flex flex-1 flex-col items-center px-6 pt-10 pb-10 text-center">
      <ul class="flex w-full flex-col items-center gap-1">
        {
          links.map((link, index) => {
            const isActive = link.href !== '/' && currentPath.startsWith(link.href)
            const hasDropdown = link.children && link.children.length > 0
            const isExternal = link.href.startsWith('http')
            const labelClass = 'font-heading text-[30px] leading-tight font-bold tracking-tight transition-colors'
            return (
              <li class="mobile-item w-full" style={`--i: ${index}`}>
                {hasDropdown
                  ? (
                      // Soluciones / Recursos: todo el renglón despliega el submenú.
                      <button
                        type="button"
                        class:list={['mobile-dropdown-toggle inline-flex items-center gap-2 py-2.5 hover:text-primary', labelClass, isActive ? 'text-primary' : 'text-ink']}
                        aria-expanded="false"
                      >
                        {link.label}
                        <Icon name="chevron-down" class="mobile-chevron h-3.5 w-3.5" aria-hidden="true" />
                      </button>
                    )
                  : (
                      <a
                        href={link.href}
                        target={isExternal ? '_blank' : undefined}
                        rel={isExternal ? 'noopener noreferrer' : undefined}
                        class:list={['inline-flex items-center gap-2 py-2.5 hover:text-primary', labelClass, isActive ? 'text-primary' : 'text-ink']}
                        aria-current={isActive ? 'page' : undefined}
                      >
                        {link.label}
                        {isExternal && <Icon name="arrow-right" class="h-5 w-5 -rotate-45 text-ink-500" aria-hidden="true" />}
                      </a>
                    )}
                {hasDropdown && (
                  <div class="mobile-dropdown-panel">
                    <ul class="min-h-0 overflow-hidden">
                      <li class="h-1" aria-hidden="true"></li>
                      {link.href !== '#' && (
                        <li>
                          <a href={link.href} class="block py-2 text-[15px] font-semibold text-primary transition-colors hover:text-primary-600">
                            Ver todas las {link.label.toLowerCase()}
                          </a>
                        </li>
                      )}
                      {link.children?.map(child => (
                        <>
                          {child.complementary && <li class="mx-auto my-2 w-10 border-t border-dark-100" aria-hidden="true"></li>}
                          <li>
                            <a href={child.href} class="block py-2 text-[15px] font-medium text-ink-500 transition-colors hover:text-primary">
                              {child.label}
                            </a>
                          </li>
                        </>
                      ))}
                      <li class="h-4" aria-hidden="true"></li>
                    </ul>
                  </div>
                )}
              </li>
            )
          })
        }
      </ul>

      <div class="mobile-item mt-auto flex w-full flex-col items-center pt-12" style={`--i: ${links.length}`}>
        <ul class="flex items-center gap-3">
          {redes.map(red => (
            <li>
              <a
                href={red.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={red.label}
                class="flex h-11 w-11 items-center justify-center rounded-full border border-dark-100 text-ink transition-colors hover:border-primary hover:bg-primary hover:text-white"
              >
                <Icon name={red.name} class="h-9 w-9" aria-hidden="true" />
              </a>
            </li>
          ))}
        </ul>

        <a
          href={siteRoutes.contact}
          class="group mt-8 inline-flex w-full max-w-xs items-center justify-center gap-2 rounded-[10px] bg-primary px-6 py-4 text-[15px] font-semibold text-white transition-colors hover:bg-primary-600"
        >
          Agendar Asesoría
          <Icon name="arrow-right" class="h-5 w-5 transition-transform group-hover:translate-x-1" aria-hidden="true" />
        </a>

        <a href={`mailto:${siteContact.email}`} class="mt-5 text-sm text-ink-500 transition-colors hover:text-primary">
          {siteContact.email}
        </a>
      </div>
    </div>
  </div>
</header>

<style>
  header a:focus-visible, header button:focus-visible { outline: 2px solid var(--color-primary); outline-offset: 3px; border-radius: 4px; }

  /* Con el menú abierto, el CTA del panel manda: el del header se retira. */
  .nav-cta { transition: opacity 200ms ease-out; }
  header:has(.mobile-menu[data-open='true']) .nav-cta { opacity: 0; pointer-events: none; }

  /* Hamburguesa de dos líneas que se cruza en X al abrir. */
  .nav-toggle-line {
    position: absolute;
    left: 50%;
    width: 24px;
    height: 2px;
    border-radius: 2px;
    background: currentColor;
    translate: -50% 0;
    transition: transform 400ms cubic-bezier(.16,1,.3,1);
  }
  .nav-toggle-line:first-child { transform: translateY(-4px); }
  .nav-toggle-line:last-child { transform: translateY(4px); }
  .nav-toggle[aria-expanded='true'] .nav-toggle-line:first-child { transform: rotate(45deg); }
  .nav-toggle[aria-expanded='true'] .nav-toggle-line:last-child { transform: rotate(-45deg); }

  /* Panel: entra con fundido y los items suben en cascada (--i = orden). */
  .mobile-menu {
    visibility: hidden;
    opacity: 0;
    transition: opacity 300ms ease-out, visibility 0s linear 300ms;
  }
  .mobile-menu[data-open='true'] {
    visibility: visible;
    opacity: 1;
    transition: opacity 300ms ease-out;
  }
  .mobile-item {
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 400ms ease-out, transform 500ms cubic-bezier(.16,1,.3,1);
  }
  .mobile-menu[data-open='true'] .mobile-item {
    opacity: 1;
    transform: none;
    transition-delay: calc(var(--i) * 45ms + 60ms);
  }

  /* Acordeón con grid 0fr → 1fr: anima a la altura real sin medir en JS. */
  .mobile-dropdown-panel {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 400ms cubic-bezier(.16,1,.3,1);
  }
  .mobile-dropdown-panel[data-open='true'] { grid-template-rows: 1fr; }

  .mobile-chevron { transition: transform 300ms cubic-bezier(.16,1,.3,1); }
  .mobile-dropdown-toggle[aria-expanded='true'] .mobile-chevron { transform: rotate(180deg); }

  @media (prefers-reduced-motion: reduce) {
    .nav-toggle-line, .mobile-menu, .mobile-item, .mobile-dropdown-panel, .mobile-chevron { transition: none !important; }
  }
</style>

<script>
// Los listeners globales (Esc, breakpoint) se renuevan en cada navegación:
// el AbortController suelta los de la página anterior.
let pageListeners: AbortController | undefined

document.addEventListener('astro:page-load', () => {
  pageListeners?.abort()
  pageListeners = new AbortController()
  const { signal } = pageListeners

  const toggle = document.getElementById('nav-toggle')
  const menu = document.getElementById('mobile-menu')
  if (!toggle || !menu)
    return

  const setOpen = (open: boolean) => {
    menu.dataset.open = String(open)
    toggle.setAttribute('aria-expanded', String(open))
    toggle.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú')
    // En móvil no hay ScrollSmoother: bloquear el scroll nativo basta.
    document.documentElement.style.overflow = open ? 'hidden' : ''
    menu.toggleAttribute('inert', !open)
  }

  setOpen(false)

  toggle.addEventListener('click', () => setOpen(menu.dataset.open !== 'true'))

  // Esc cierra y devuelve el foco; pasar a desktop también cierra.
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && menu.dataset.open === 'true') {
      setOpen(false)
      toggle.focus()
    }
  }, { signal })
  window.matchMedia('(min-width: 1024px)').addEventListener('change', (event) => {
    if (event.matches)
      setOpen(false)
  }, { signal })

  // Al navegar, el menú se cierra antes del cambio de página.
  menu.querySelectorAll<HTMLAnchorElement>('a[href]').forEach((link) => {
    link.addEventListener('click', () => setOpen(false))
  })

  menu.querySelectorAll<HTMLElement>('.mobile-dropdown-toggle').forEach((btn) => {
    const panel = btn.closest('li')?.querySelector<HTMLElement>('.mobile-dropdown-panel')
    btn.addEventListener('click', () => {
      const open = btn.getAttribute('aria-expanded') !== 'true'
      btn.setAttribute('aria-expanded', String(open))
      if (panel)
        panel.dataset.open = String(open)
    })
  })
})
</script>
