---
import { Image } from 'astro:assets'
import circle from '@/assets/nosotros/nosotros-circle.png'
import figure1 from '@/assets/nosotros/nosotros-figure1.png'
import figure2 from '@/assets/nosotros/nosotros-figure2.png'
import figure3 from '@/assets/nosotros/nosotros-figure3.png'
import { aboutContent } from '@/data/transversal-content'

const pillars = [
  {
    image: figure1,
    title: 'Tecnología',
    description:
      'Somos digitales y queremos que tú también lo seas. La aplicación de diversas herramientas digitales ha optimizado nuestro funcionamiento empresarial y lo pueden hacer para ti.',
  },
  {
    image: figure2,
    title: 'Procesos',
    description:
      'Saber lo que hacemos y cómo lo hacemos nos permite mejorar constantemente, así identificar cuáles son las mejores prácticas para la gestión de proyectos. De esta forma, podemos entregar mayor valor a tu negocio en menor tiempo.',
  },
  {
    image: figure3,
    title: 'Proyectos',
    description:
      'El enfoque de proyectos permite la creación de productos digitales funcionales que optimizan tu negocio y mejoran la experiencia de tus clientes.',
  },
]
---

<section>
  <!-- Part 1: Dark section -->
  <div class="bg-gradient-to-b from-navy to-dark">
    <div class="mx-auto max-w-[1512px] px-6 py-20 lg:px-24">
      <div class="grid items-center gap-12 lg:grid-cols-2">
        <div id="howwedo-text">
          <h2 class="font-heading text-[40px] font-bold text-white sm:text-[50px]">
            ¿Cómo lo hacemos?
          </h2>

          <p class="methodology-opening">{aboutContent.methodology.opening}</p>
          <div class="methodology-copy">
            {aboutContent.methodology.paragraphs.map(paragraph => <p>{paragraph}</p>)}
          </div>

        </div>

        <div id="howwedo-circle-wrap" class="flex justify-center">
          <Image
            src={circle}
            alt="Metodologías que combinamos: Design Thinking, Lean Startup, Agile, Kanban, Scrum y Six Sigma"
            class="methodology-wheel w-full max-w-[440px]"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </div>

  <!-- Part 2: Three pillars -->
  <div class="pillars-section bg-white py-16">
    <div class="mx-auto max-w-[1512px] px-6 lg:px-24">
      <div class="pillars-heading"><p>Tecnología, procesos y proyectos</p><h2>Aplicamos ingeniería<br />a la forma de trabajar.</h2></div>
      <div id="howwedo-pillars" class="grid gap-12 md:grid-cols-3">
        {
          pillars.map(pillar => (
            <div class="howwedo-pillar">
              <Image
                src={pillar.image}
                alt={pillar.title}
                class="pillar-image mx-auto h-[190px] w-auto object-contain"
                loading="lazy"
              />
              <h3 class="mt-6 font-heading text-[22px] font-bold text-ink">
                {pillar.title}
              </h3>
              <p class="mt-3 text-[15px] leading-relaxed text-gray-body">
                {pillar.description}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .methodology-opening { margin-top: 32px; max-width: 32ch; font: 500 clamp(22px, 2.2vw, 30px)/1.4 var(--font-heading); letter-spacing: -.025em; color: white; }
  .methodology-copy { margin-top: 28px; color: #dce3f1; font-size: 16px; line-height: 1.85; }
  .methodology-copy p + p { margin-top: 20px; }
  .methodology-wheel { height: auto; }
  .pillars-section { padding-block: clamp(64px, 7vw, 104px); }
  .pillars-heading { margin-bottom: 48px; }
  .pillars-heading > p { font-size: 12px; color: #6740b2; margin-bottom: 16px; }
  .pillars-heading h2 { font: 600 clamp(30px, 3vw, 44px)/1.12 var(--font-heading); letter-spacing: -.04em; }
  .howwedo-pillar { border-bottom: 1px solid #dfe3eb; padding-bottom: 28px; }
  .pillar-image { margin-bottom: 32px; max-width: 100%; }
  @media (max-width: 767px) { .methodology-wheel { max-width: 320px; } .pillar-image { height: 160px; } }
</style>
<script>
import { ensureGsap, registerMotion } from '@/lib/motion'

registerMotion(() => {
  const { gsap } = ensureGsap()
  const media = gsap.matchMedia()
  media.add('(prefers-reduced-motion: no-preference)', () => {
    const text = document.getElementById('howwedo-text')
    if (text)
      gsap.from(text.children, { y: 20, autoAlpha: 0, duration: 0.8, stagger: 0.12, ease: 'power3.out', scrollTrigger: { trigger: text, start: 'top 85%', once: true } })
    const circle = document.getElementById('howwedo-circle-wrap')
    if (circle)
      gsap.from(circle, { scale: 0.96, autoAlpha: 0, duration: 1, ease: 'power3.out', scrollTrigger: { trigger: circle, start: 'top 85%', once: true } })
    document.querySelectorAll('.howwedo-pillar').forEach((pillar) => {
      gsap.from(pillar, { y: 24, autoAlpha: 0, duration: 0.8, ease: 'power3.out', scrollTrigger: { trigger: pillar, start: 'top 88%', once: true } })
    })
  })
})
</script>
