---
interface Props {
  status: 'draft' | 'published' | 'changed'
  problems: readonly { field: string, message: string }[]
}

const { status, problems } = Astro.props
const STATUS_LABEL = { draft: 'Borrador', published: 'Publicado', changed: 'Con cambios sin publicar' } as const
---

<aside role="status" class="sticky top-0 z-50 border-b border-amber-300 bg-amber-50 px-6 py-3 text-sm text-amber-950">
  <p class="mx-auto max-w-[1140px] font-bold">
    Vista previa del borrador guardado · {STATUS_LABEL[status]} · no es público
  </p>
  {problems.length > 0 && (
    <ul class="mx-auto mt-1 max-w-[1140px] list-disc pl-5">
      {problems.map(problem => <li>Falta para publicar: {problem.message}</li>)}
    </ul>
  )}
</aside>
