---
import { Image } from 'astro:assets'
import logo from '@/assets/brainstorming/logo-hd.png'
import LanguageSwitcher from '@/components/common/LanguageSwitcher.astro'
import { getLang, localizePath, useTranslations } from '@/i18n/utils'

interface Props {
  ctaHref?: string
}

const { ctaHref = '#contact' } = Astro.props
const lang = getLang(Astro.url)
const t = useTranslations(lang, 'navbar')
---

<header class="relative z-20 mx-auto flex w-full max-w-[1512px] items-center justify-between gap-3 px-4 py-5 sm:gap-6 sm:px-6 sm:py-6 lg:px-16">
  <a href={localizePath('/', lang)} class="shrink-0">
    <Image src={logo} alt="Brainstorming" class="h-6 w-auto shrink-0 object-contain sm:h-8" widths={[200, 400, 600]} sizes="200px" />
  </a>

  <div class="flex shrink-0 items-center gap-2 sm:gap-3">
    <LanguageSwitcher />
    <a
      href={ctaHref}
      class="shrink-0 whitespace-nowrap rounded-lg bg-gold px-3 py-2 font-heading text-xs font-bold text-dark transition-transform hover:scale-[1.03] sm:px-5 sm:py-2.5 sm:text-sm"
    >
      {t.cta}
    </a>
  </div>
</header>
