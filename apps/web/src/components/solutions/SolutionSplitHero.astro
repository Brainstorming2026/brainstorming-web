---
import type { ImageMetadata } from 'astro'
import { Image } from 'astro:assets'

interface Props {
  image: ImageMetadata
  title: string
  description: string
}

const { image, title, description } = Astro.props
---

<section data-split-hero class="relative overflow-hidden bg-white lg:min-h-[702px]">
  <Image
    data-split-hero-bg
    src={image}
    alt=""
    class="pointer-events-none absolute inset-0 hidden h-full w-full object-cover object-bottom lg:block"
    loading="eager"
    fetchpriority="high"
    widths={[1512, 3024]}
    sizes="100vw"
  />

  <div class="relative z-10 mx-auto flex max-w-[1512px] items-center px-6 pb-3 pt-16 lg:min-h-[702px] lg:px-24 lg:py-16">
    <div class="max-w-[600px]">
      <h1 data-split-hero-headline class="font-heading text-[clamp(2.35rem,10vw,3.25rem)] font-bold leading-[1.08] text-dark lg:text-[52px] lg:leading-[60px]">
        {title}
      </h1>
      <p data-split-hero-text class="mt-6 text-[16px] leading-[1.65] text-dark-500 lg:leading-6">
        {description}
      </p>
    </div>
  </div>

  <div class="relative h-[320px] overflow-hidden sm:h-[380px] lg:hidden" aria-hidden="true">
    <Image
      data-split-hero-bg
      src={image}
      alt=""
      class="pointer-events-none absolute bottom-0 right-[-10%] h-auto w-[190%] max-w-none sm:right-[-4%] sm:w-[165%]"
      loading="eager"
      widths={[758, 1120]}
      sizes="(max-width: 639px) 190vw, 165vw"
    />
  </div>
</section>

<script>
import { ensureGsap, prefersReducedMotion, registerMotion, splitHeadline } from '@/lib/motion'

registerMotion(() => {
  document.querySelectorAll<HTMLElement>('[data-split-hero]').forEach((hero) => {
    const backgrounds = hero.querySelectorAll('[data-split-hero-bg]')
    const headline = hero.querySelector('[data-split-hero-headline]')
    const text = hero.querySelector('[data-split-hero-text]')
    const { gsap } = ensureGsap()

    if (text && !prefersReducedMotion())
      gsap.set(text, { opacity: 0, y: 10 })

    if (headline) {
      splitHeadline(headline, {
        by: 'words',
        scrollTrigger: false,
        onComplete: () => {
          if (text)
            gsap.to(text, { opacity: 1, y: 0, duration: 0.5 })
        },
      })
    }

    if (!prefersReducedMotion()) {
      backgrounds.forEach(background =>
        gsap.fromTo(background, { scale: 1 }, { scale: 1.025, duration: 8, ease: 'none' }))
    }
  })
})
</script>
