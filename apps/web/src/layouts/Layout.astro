---
import { ClientRouter } from 'astro:transitions'
import Footer from '@/components/common/Footer.astro'
import MotionStartup from '@/components/common/MotionStartup.astro'
import Navbar from '@/components/common/Navbar.astro'
import SiteMotion from '@/components/common/SiteMotion.astro'
import SmoothScroll from '@/components/common/SmoothScroll.astro'
import SplashScreen from '@/components/common/SplashScreen.astro'
import Stick from '@/components/common/Stick.astro'
import SeoHead from '@/components/seo/SeoHead.astro'
import SolutionMotion from '@/components/solutions/SolutionMotion.astro'
import '@/styles/global.css'

interface Props {
  title: string
  description?: string
  image?: string
  imageAlt?: string
  noindex?: boolean
  type?: 'website' | 'article'
  structuredData?: Record<string, unknown>[]
  publishedTime?: string
  modifiedTime?: string
  footerCurveBg?: string
  showNavbar?: boolean
}

const { title, image, imageAlt, noindex = false, type, structuredData, publishedTime, modifiedTime, description: rawDescription = 'Brainstorming: consultoría estratégica, crecimiento comercial, marketing y automatización con IA para empresas en LATAM.', footerCurveBg, showNavbar = true } = Astro.props
const isSolution = Astro.url.pathname.startsWith('/soluciones')
const cleanDescription = rawDescription.replace(/\s+/g, ' ').trim()
// Google shows ~155–160 characters; cut on a word boundary and drop dangling punctuation.
const description = cleanDescription.length > 158 ? `${cleanDescription.slice(0, cleanDescription.lastIndexOf(' ', 156)).replace(/[\s,;:.—-]+$/, '')}…` : cleanDescription
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Headings above the fold use Nexa Bold: fetch it early to avoid a visible font swap. -->
    <link rel="preload" href="/fonts/Nexa-Bold.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.ico?v=2" sizes="48x48" />
    <link rel="icon" type="image/png" href="/brainstorming-icon-file.png?v=2" />
    <link rel="apple-touch-icon" href="/brainstorming-icon-file.png?v=2" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <SeoHead {title} {description} {image} {imageAlt} {noindex} {type} {structuredData} {publishedTime} {modifiedTime} />

    <!-- Navegación suave entre páginas, sin recarga completa -->
    <MotionStartup />
    <ClientRouter />
  </head>
  <body class="font-body text-ink antialiased overflow-x-hidden">
    <!-- Fuera del wrapper: ScrollSmoother transforma #smooth-content, así que
         cualquier elemento fixed/sticky que viva dentro deja de estarlo. -->
    <SplashScreen />
    {showNavbar && <Navbar />}

    <div id="smooth-wrapper">
      <div id="smooth-content" class:list={{ 'pt-20': showNavbar }}>
        <main data-solution-page={isSolution ? '' : undefined} transition:animate="none">
          <slot />
        </main>
        {isSolution && <SolutionMotion />}
        <Footer curveBg={footerCurveBg} />
      </div>
    </div>

    <SmoothScroll />
    <Stick />
    <SiteMotion />
  </body>
</html>
