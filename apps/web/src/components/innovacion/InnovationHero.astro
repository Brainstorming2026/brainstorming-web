---
import image from '@/assets/service-heroes/innovation-editorial.png'
import ServiceEditorialHero from '@/components/solutions/ServiceEditorialHero.astro'
import { contact } from '@/data/innovation-content'
---

<ServiceEditorialHero
  service="innovation"
  eyebrow="Innovación estratégica / Nuevas oportunidades"
  title="Tu próximo negocio"
  accent="todavía no existe."
  statement="Te ayudamos a diseñarlo. Y a validarlo."
  description="De una oportunidad a un negocio validado, junto a tu equipo y el Board de Brainstorming."
  image={image}
  imageAlt="Prototipos modulares de cristal lila, modelos de negocio y bocetos para explorar una nueva oportunidad"
  cta="Conversemos sobre tu idea"
  href={contact}
  processHref="#proceso-innovacion"
  caption="El futuro del negocio se trabaja."
  facts={[
    { label: 'Punto de partida', value: 'Una oportunidad con potencial' },
    { label: 'Validación', value: 'Evidencia con clientes reales' },
    { label: 'Acompañamiento', value: 'El Board junto a tu equipo' },
  ]}
/>

<script>
  import '@/scripts/innovation/page-motion'
</script>
