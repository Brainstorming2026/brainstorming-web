---
import { Image } from 'astro:assets'
import { executionResults } from '@/data/results'
import { getLang, useTranslations } from '@/i18n/utils'

const t = useTranslations(getLang(Astro.url), 'results')
---

<section id="execution-results" class="bg-gradient-to-b from-navy-600 to-primary py-16 lg:py-24" aria-labelledby="results-headline">
  <div class="mx-auto max-w-[1384px] px-6 sm:px-8 lg:px-16">
    <div class="max-w-[800px]">
      <p class="mb-4 font-body text-xs font-bold tracking-[0.14em] text-white/60 uppercase">{t.eyebrow}</p>
      <h2 id="results-headline" class="font-heading text-[clamp(1.75rem,3vw,2.25rem)] leading-[1.15] font-bold tracking-[-0.03em] text-white">
        {t.headline}
      </h2>
    </div>

    <div id="results-grid" class="mt-8 grid gap-4 sm:grid-cols-2 lg:mt-9 lg:grid-cols-6 lg:gap-4">
      {executionResults.map((result, index) => (
        <article class:list={['results-card flex flex-col rounded-xl bg-white p-6 shadow-[0_18px_40px_-28px_rgb(23_41_82/0.6)]', index < 3 ? 'lg:col-span-2' : 'lg:col-span-3', index === 4 && 'sm:col-span-2']} aria-labelledby={`result-${result.id}`}>
          <div class="flex h-10 items-center">
            <Image src={result.logo} alt="" class="h-10 w-32 object-contain object-left" loading="lazy" />
          </div>
          <h3 id={`result-${result.id}`} class="mt-3 font-heading text-sm font-bold text-navy">{result.name}</h3>
          <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2 border-t border-navy/15 pt-4">
            <p class="font-heading text-[42px] leading-none font-bold tracking-[-0.045em] text-navy tabular-nums lg:text-5xl" data-count-up>{result.value}</p>
            <div>
              <p class="font-body text-[13px] font-bold leading-snug text-primary-600">{t.metrics[result.metric]}</p>
              {result.id === 'stanley' && <p class="mt-1 font-body text-[13px] font-medium text-navy">{t.stanleyPeriod}</p>}
            </div>
          </div>
          <p class="mt-4 max-w-[480px] font-body text-sm leading-relaxed text-dark/75">{t.items[result.id]}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
import { countUp, registerMotion, splitHeadline, staggerGrid } from '@/lib/motion'
import { prefersReducedMotion } from '@/lib/motion/reduced-motion'

registerMotion(() => {
  if (prefersReducedMotion())
    return

  const headline = document.getElementById('results-headline')
  const cards = document.querySelectorAll('#results-grid .results-card')
  if (headline)
    splitHeadline(headline, { by: 'lines' })
  staggerGrid(cards, { variant: 'wipe', itemDuration: 1, itemStagger: 0.12 })
  // Count once each card has mostly wiped in; offset per column mirrors the card stagger.
  document.querySelectorAll<HTMLElement>('#results-grid [data-count-up]').forEach((el, index) => {
    countUp(el, { delay: 0.3 + (index % 3) * 0.12 })
  })
})
</script>
