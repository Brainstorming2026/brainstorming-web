---
import { Image } from 'astro:assets'
import { Icon } from 'astro-icon/components'
import brandingBg from '@/assets/projects/mikio/bg2.png'
import colorsImg from '@/assets/projects/mikio/colors.png'

const lineas = ['Creación de', 'Manual de', 'Identidad de', 'Marca']
---

<section class="relative overflow-hidden bg-white py-16 lg:py-20">
  <Image
    src={brandingBg}
    alt=""
    class="pointer-events-none absolute inset-0 h-full w-full object-cover object-top"
    loading="lazy"
    widths={[758, 1512]}
    sizes="100vw"
  />
  <div class="relative z-10 mx-auto max-w-[1512px] px-6 lg:px-24">
    <div class="grid gap-12 lg:grid-cols-2 lg:items-center">
      <div>
        <div class="flex items-center gap-2 font-heading text-sm font-bold text-dark">
          <Icon name="expert-huella" class="h-6 w-6 text-dark-300" />
          <span>Branding</span>
        </div>

        <h2 class="mt-4 font-heading text-3xl font-bold leading-tight text-dark sm:text-6xl">
          {
            lineas.map(linea => (
              <span class="relative block py-1">
                {linea}
              </span>
            ))
          }
        </h2>
      </div>

      <div class="lg:min-h-[420px]" aria-hidden="true"></div>
    </div>
  </div>
</section>

<section class="bg-white pb-16 lg:pb-20">
  <div class="mx-auto max-w-[1512px] px-6 lg:px-24">
    <div class="grid gap-10 lg:grid-cols-[1fr_auto] lg:items-center">
      <p class="max-w-[440px] text-[14px] leading-6 text-dark-500">
        Creamos una identidad de marca que refleja su promesa de valor: con Mikio Car Wash, te das
        el placer de engreír a tu auto desde la comodidad de tu hogar. Los colores elegidos
        comunican la frescura y limpieza que conlleva el servicio. Incluso, en el logo, le dimos a
        una de sus letras una connotación de la forma de manguera y la gota de agua cayendo.
      </p>

      <Image
        src={colorsImg}
        alt="Paleta de colores de Mikio Car Wash"
        class="mx-auto h-auto w-full max-w-[560px]"
        loading="lazy"
      />
    </div>
  </div>
</section>
