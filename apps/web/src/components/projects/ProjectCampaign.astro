---
import { Image } from 'astro:assets'
import { Icon } from 'astro-icon/components'
import type { ProyectoCampania } from '@/data/proyectosDetalle'

interface Props {
  campania: ProyectoCampania
}

const { campania } = Astro.props
---

<section class="bg-white pt-16 lg:pt-20">
  <div class="mx-auto grid max-w-[1512px] gap-8 px-6 lg:grid-cols-2 lg:items-start lg:px-24">
    <div>
      <div class="flex items-center gap-2 font-heading text-sm font-bold text-dark">
        <Icon name="expert-iman" class="h-6 w-6 text-dark-300" />
        <span>Inbound Marketing</span>
      </div>
      <h2 class="mt-4 max-w-[380px] font-heading text-3xl font-bold leading-tight text-dark sm:text-5xl">
        {campania.heading}
      </h2>
    </div>
    <p class="text-[14px] leading-6 text-dark-500 lg:mt-1">
      {campania.parrafo}
    </p>
  </div>

  {
    campania.waveIcon && (
      <Icon
        name={campania.waveIcon}
        class="block w-full h-full"
        style={{ color: campania.colorFondo }}
      />
    )
  }
</section>

{
  campania.video && (
    <section class="py-16 lg:py-20" style={{ backgroundColor: campania.colorFondo }}>
      <div class="mx-auto max-w-[1512px] px-6 lg:px-24">
        <div class="relative mx-auto max-w-[1190px] overflow-hidden rounded-lg bg-[#eee]">
          {
            campania.video.thumbnail ? (
              <Image
                src={campania.video.thumbnail}
                alt={campania.video.alt ?? ''}
                class="h-auto w-full"
                widths={[758, 1190]}
                sizes="(min-width: 1024px) 1190px, 90vw"
                loading="lazy"
              />
            ) : (
              <div class="h-[300px] w-full lg:h-[468px]" />
            )
          }
          {
            campania.video.thumbnail && (
              <div class="pointer-events-none absolute inset-0 flex items-center justify-center">
                <div class="flex h-16 w-16 items-center justify-center rounded-full bg-black/40">
                  <Icon name="play" class="h-6 w-6 text-white" />
                </div>
              </div>
            )
          }
        </div>
      </div>
    </section>
  )
}

{
  campania.imagenes.length > 0 && (
    <section
      class:list={[campania.video ? 'bg-white py-16 lg:py-20' : undefined]}
      style={campania.video ? undefined : { backgroundColor: campania.colorFondo }}
    >
      <div class="mx-auto max-w-[1512px] px-6 lg:px-24">
        <div class="flex flex-wrap items-center justify-center gap-8">
          {
            campania.imagenes.map(img => (
              <Image
                src={img.src}
                alt={img.alt}
                class="h-auto w-full"
                style={{ maxWidth: `${img.maxWidth ?? 420}px` }}
                widths={[img.maxWidth ?? 420, (img.maxWidth ?? 420) * 2]}
                sizes={`(min-width: 640px) ${img.maxWidth ?? 420}px, 90vw`}
                loading="lazy"
              />
            ))
          }
        </div>
      </div>
    </section>
  )
}
