---
import { Image } from 'astro:assets'
import PostCard from '@/components/blog/PostCard.astro'
import { featuredPost, quickPosts } from '@/data/posts'
---

<section class="mx-auto max-w-[1140px] px-6 pt-10 pb-16 lg:px-16 lg:pt-14">
  <h1 class="font-heading text-2xl font-bold text-dark sm:text-3xl">BLOG</h1>

  <a
    href={`/${featuredPost.slug}`}
    class="relative mt-8 flex min-h-[320px] flex-col justify-end overflow-hidden rounded-[16px] p-8 text-white sm:min-h-[420px] lg:p-12"
  >
    {featuredPost.image && (
      <Image
        src={featuredPost.image}
        alt=""
        class="absolute inset-0 -z-10 h-full w-full object-cover"
        widths={[640, 960, 1280, 1600]}
        sizes="100vw"
        loading="eager"
      />
    )}
    <div class="absolute inset-0 -z-10 bg-gradient-to-t from-primary via-primary/70 to-transparent"></div>

    <span class="font-heading text-xs font-bold uppercase tracking-wide text-white/70">{featuredPost.category}</span>
    <h2 class="mt-2 max-w-3xl font-heading text-xl font-bold leading-tight sm:text-3xl">{featuredPost.title}</h2>
    <p class="mt-3 max-w-xl text-sm text-white/80">{featuredPost.excerpt}</p>
    <span class="mt-4 text-xs text-white/60">{featuredPost.date}</span>
  </a>

  <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {quickPosts.map(post => <PostCard post={post} showCategory />)}
  </div>
</section>
