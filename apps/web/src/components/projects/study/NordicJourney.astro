---
const stages = [
  { label: 'Interés', title: 'Una propuesta que conecta.', text: 'La familia descubre la propuesta educativa. La comunicación abre la conversación y da sentido al primer contacto.' },
  { label: 'Visita', title: 'Conocer para decidir.', text: 'La visita permite acercarse al colegio y conocer su propuesta más allá de la comunicación inicial.' },
  { label: 'Seguimiento', title: 'Dar continuidad al interés.', text: 'El seguimiento mantiene la conversación con la familia y acompaña su avance hacia el siguiente paso.' },
  { label: 'Admisión', title: 'Un siguiente paso claro.', text: 'La familia avanza al proceso de admisión con una ruta definida y continuidad en el contacto.' },
  { label: 'Matrícula', title: 'El comienzo de una nueva etapa.', text: 'La matrícula completa el recorrido de admisión y marca el inicio de la relación con la comunidad educativa.' },
]
---

<section class="nordic-journey" aria-labelledby="nordic-journey-heading">
  <div class="nordic-journey__statement">
    <span class="nordic-journey__statement-eyebrow">Nordic · Recorrido de admisión</span>
    <div class="nordic-journey__statement-main"><span aria-hidden="true">01 — 05</span><p>Escuchar.<br />Orientar.<br /><strong>Acompañar.</strong></p></div>
  </div>

  <div class="nordic-journey__content">
    <header class="nordic-journey__heading">
      <p>Experiencia de admisión <span>01 — 05</span></p>
      <h3 id="nordic-journey-heading">Del primer interés<br />a un nuevo comienzo.</h3>
      <div>Un proceso pensado para acompañar a las familias en su decisión.</div>
    </header>

    <div class="nordic-journey__stages" aria-label="Etapas del proceso de admisión">
      {stages.map((stage, index) => (
        <details class="nordic-journey__stage" name="nordic-admission-stages" open={index === 0}>
          <summary>
            <span class="nordic-journey__number">{String(index + 1).padStart(2, '0')}</span>
            <span class="nordic-journey__label">{stage.label}</span>
            <span class="nordic-journey__toggle" aria-hidden="true"></span>
          </summary>
          <div class="nordic-journey__description">
            <h4>{stage.title}</h4>
            <p>{stage.text}</p>
          </div>
        </details>
      ))}
    </div>
    <p class="nordic-journey__hint">Explora cada etapa del recorrido.</p>
  </div>
</section>

<style>
  .nordic-journey {
    --journey-navy: #163751;
    --journey-blue: #345f88;
    --journey-muted: #51697b;
    --journey-line: #cddbe5;
    display: grid;
    grid-template-columns: minmax(0, .95fr) minmax(0, 1.05fr);
    gap: clamp(32px, 5vw, 72px);
    align-items: stretch;
    padding-block: 32px 12px;
    color: var(--journey-navy);
  }
  .nordic-journey__statement { display: flex; flex-direction: column; justify-content: space-between; min-height: 560px; padding: clamp(30px, 4vw, 58px); overflow: hidden; border-radius: 6px 64px 6px 6px; background: radial-gradient(circle at 95% 8%, #466f96 0, transparent 36%), #163751; color: #fff; }
  .nordic-journey__statement-eyebrow { color: #cbdce9; font-size: 11px; font-weight: 600; letter-spacing: .13em; text-transform: uppercase; }
  .nordic-journey__statement-main > span { display: block; margin-bottom: 18px; color: #aecbde; font-size: 12px; font-variant-numeric: tabular-nums; letter-spacing: .2em; }
  .nordic-journey__statement-main p { font: 500 clamp(38px, 4.5vw, 66px)/1.04 var(--font-heading); letter-spacing: -.055em; }
  .nordic-journey__statement-main strong { color: #c8dcea; font-weight: inherit; }
  .nordic-journey__statement small { max-width: 32ch; color: #d2e2ec; font-size: 12px; line-height: 1.5; }
  .nordic-journey__content { min-width: 0; padding-block: 8px; }
  .nordic-journey__heading > p { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin: 0; font-size: 10px; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; }
  .nordic-journey__heading > p span { flex: none; color: var(--journey-muted); font-variant-numeric: tabular-nums; letter-spacing: .08em; }
  .nordic-journey__heading h3 { margin-block: 24px 16px; font: 600 clamp(30px, 3.2vw, 46px)/1.06 var(--font-heading); letter-spacing: -.045em; text-wrap: balance; }
  .nordic-journey__heading > div { max-width: 42ch; font-size: 15px; line-height: 1.6; color: var(--journey-muted); }
  .nordic-journey__stages { margin-top: 30px; }
  .nordic-journey__stage { border-top: 1px solid var(--journey-line); }
  .nordic-journey__stage:last-child { border-bottom: 1px solid var(--journey-line); }
  .nordic-journey__stage summary { display: grid; grid-template-columns: 34px minmax(0, 1fr) 28px; gap: 15px; align-items: center; min-height: 69px; padding-block: 15px; cursor: pointer; list-style: none; }
  .nordic-journey__stage summary::-webkit-details-marker { display: none; }
  .nordic-journey__stage summary:focus-visible { outline: 2px solid var(--journey-blue); outline-offset: 5px; border-radius: 3px; }
  .nordic-journey__number { font-size: 11px; font-variant-numeric: tabular-nums; color: var(--journey-muted); }
  .nordic-journey__label { font: 600 clamp(21px, 2vw, 27px)/1.2 var(--font-heading); letter-spacing: -.025em; transition: color 180ms ease, transform 180ms ease; }
  .nordic-journey__toggle { position: relative; width: 28px; height: 28px; border: 1px solid var(--journey-line); border-radius: 50%; transition: background 180ms ease, border-color 180ms ease; }
  .nordic-journey__toggle::before,
  .nordic-journey__toggle::after { position: absolute; content: ''; top: 12px; left: 8px; width: 10px; height: 1px; background: currentColor; }
  .nordic-journey__toggle::after { transform: rotate(90deg); transition: transform 180ms ease; }
  .nordic-journey__stage[open] .nordic-journey__toggle { background: var(--journey-navy); border-color: var(--journey-navy); color: #fff; }
  .nordic-journey__stage[open] .nordic-journey__toggle::after { transform: rotate(0); }
  .nordic-journey__stage[open] .nordic-journey__number { color: var(--journey-blue); font-weight: 700; }
  .nordic-journey__description { padding: 0 35px 24px 49px; }
  .nordic-journey__description h4 { margin: 0 0 8px; font-size: 14px; font-weight: 600; line-height: 1.5; }
  .nordic-journey__description p { margin: 0; max-width: 48ch; color: var(--journey-muted); font-size: 14px; line-height: 1.65; }
  .nordic-journey__hint { margin-top: 18px; color: var(--journey-muted); font-size: 11px; }
  @media (hover: hover) {
    .nordic-journey__stage summary:hover .nordic-journey__label { color: var(--journey-blue); transform: translateX(4px); }
  }
  @media (prefers-reduced-motion: no-preference) {
    .nordic-journey__stage[open] .nordic-journey__description { animation: journey-reveal 240ms ease-out; }
    @keyframes journey-reveal { from { opacity: 0; transform: translateY(5px); } to { opacity: 1; transform: translateY(0); } }
  }
  @media (prefers-reduced-motion: reduce) {
    .nordic-journey__label, .nordic-journey__toggle, .nordic-journey__toggle::after { transition: none; }
  }
  @media (max-width: 899px) {
    .nordic-journey { grid-template-columns: 1fr; gap: 32px; padding-top: 8px; }
    .nordic-journey__statement { min-height: 360px; border-radius: 6px 40px 6px 6px; }
    .nordic-journey__heading h3 { font-size: clamp(30px, 5vw, 42px); }
  }
  @media (max-width: 479px) {
    .nordic-journey__statement { min-height: 310px; padding: 28px 24px; }
    .nordic-journey__statement-main p { font-size: 43px; }
    .nordic-journey__description { padding-right: 0; }
  }
</style>
