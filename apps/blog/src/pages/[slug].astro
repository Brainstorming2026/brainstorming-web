---
import ArticlePage from '@/components/blog/article/ArticlePage.astro'
import { articles, getArticleBySlug } from '@/lib/content'

export const prerender = true

export function getStaticPaths() {
  return articles.map(article => ({ params: { slug: article.slug } }))
}

const article = getArticleBySlug(Astro.params.slug)

if (!article) {
  return Astro.redirect('/404')
}
---

<ArticlePage {article} />
