---
import { organization, ORGANIZATION_ID } from '@/data/organization'

interface Props {
  title: string
  description: string
  image?: string
  imageAlt?: string
  noindex?: boolean
  type?: 'website' | 'article'
  structuredData?: Record<string, unknown>[]
  publishedTime?: string
  modifiedTime?: string
}
const { title, description, image = '/og/brainstorming.jpg', imageAlt = title, noindex = false, type = 'website', structuredData = [], publishedTime, modifiedTime } = Astro.props
const site = Astro.site!
const path = Astro.url.pathname.replace(/\/+$/, '') || '/'
const canonical = new URL(path, site).href
const imageUrl = new URL(image, site).href
const organizationId = ORGANIZATION_ID
const graph = [
  organization,
  {
    '@type': 'WebSite',
'@id': `${site.href}#website`,
'url': site.href,
    'name': 'Brainstorming Blog',
'inLanguage': 'es',
'publisher': { '@id': organizationId },
  },
  {
    '@type': path === '/' ? 'CollectionPage' : 'WebPage',
'@id': `${canonical}#webpage`,
'url': canonical,
    'name': title,
description,
'inLanguage': 'es',
    'isPartOf': { '@id': `${site.href}#website` },
    'primaryImageOfPage': { '@type': 'ImageObject', 'url': imageUrl },
  },
  {
    '@type': 'Blog',
'@id': `${site.href}#blog`,
'url': site.href,
    'name': 'Brainstorming Blog',
'inLanguage': 'es',
    'publisher': { '@id': organizationId },
    'isPartOf': { '@id': `${site.href}#website` },
  },
  ...structuredData,
]
const jsonLd = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph }).replace(/</g, '\\u003c')
---
{!noindex && <link rel="canonical" href={canonical} />}
<meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
<meta property="og:site_name" content="Brainstorming" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content={type} />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content="es_PE" />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:alt" content={imageAlt} />
{image === '/og/brainstorming.jpg' && (
<>
  <meta property="og:image:type" content="image/jpeg" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
</>
)}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
<meta name="twitter:image:alt" content={imageAlt} />
{type === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime} />}
{type === 'article' && modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
{!noindex && <script type="application/ld+json" set:html={jsonLd} />}
