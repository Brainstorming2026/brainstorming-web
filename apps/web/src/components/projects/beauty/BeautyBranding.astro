---
import { Image } from 'astro:assets'
import { Icon } from 'astro-icon/components'
import brandingBg from '@/assets/projects/beauty/bg2.png'
import badge1 from '@/assets/projects/beauty/img1.png'
import badge2 from '@/assets/projects/beauty/img2.png'
import iconsImg from '@/assets/projects/beauty/hero2.png'
---

<section id="branding-intro" class="relative overflow-hidden bg-gray-light py-16 lg:py-20">
  <Image
    id="branding-bg"
    src={brandingBg}
    alt=""
    class="pointer-events-none absolute inset-0 hidden h-full w-1/2 object-cover lg:right-0 lg:left-auto lg:block"
    loading="lazy"
    widths={[758, 1512]}
    sizes="50vw"
  />
  <div class="relative z-10 mx-auto max-w-[1512px] px-6 lg:px-24">
    <div class="grid gap-8 lg:grid-cols-2 lg:items-center">
      <div>
        <div id="branding-label" class="flex items-center gap-2 font-heading text-sm font-bold text-dark">
          <Icon name="expert-huella" class="h-6 w-6 text-dark-300" />
          <span>Branding</span>
        </div>

        <h2 id="branding-heading" class="mt-4 max-w-[440px] font-heading text-3xl font-bold leading-tight text-dark sm:text-6xl">
          Creación de Identidad Visual (logotipo)
        </h2>

        <div id="branding-badges" class="mt-8 flex gap-4">
          <Image src={badge1} alt="Variante del isotipo de The Beauty Trust sobre fondo blanco" class="badge-img h-16 w-16" loading="lazy" />
          <Image src={badge2} alt="Variante del isotipo de The Beauty Trust sobre degradado" class="badge-img h-16 w-16" loading="lazy" />
        </div>
      </div>
    </div>
  </div>
</section>

<section id="branding-detail" class="bg-white pb-16 lg:pb-20">
  <div class="mx-auto max-w-[1512px] px-6 lg:px-24">
    <div class="grid gap-10 pt-12 lg:grid-cols-[1fr_auto] lg:items-center">
      <p id="branding-desc" class="max-w-[550px] text-[14px] leading-6 text-dark-500">
        Era esencial para The Beauty Trust que su branding refleje un balance entre elegancia,
        clase y calidez. Con la identidad visual creada, pudimos integrar la belleza/feminidad y la
        inteligencia/expertise que la marca provee a sus usuarios. El diseño minimalista y la
        elección de colores con un degradado elegante transmite la onda moderna, limpia y formal
        que inspira confianza y seguridad al consumidor final.
      </p>

      <div id="branding-colors-wrap" class="mx-auto h-auto w-full max-w-[360px] overflow-hidden">
        <Image
          src={iconsImg}
          alt="Iconografía de productos de belleza de The Beauty Trust"
          class="branding-colors-img h-auto w-full"
          loading="lazy"
        />
      </div>
    </div>
  </div>
</section>

<script>
import { ensureGsap, registerMotion, revealClip, staggerGrid } from '@/lib/motion'
import { ease } from '@/lib/motion/config'
import { prefersReducedMotion } from '@/lib/motion/reduced-motion'

registerMotion(() => {
  const bg = document.getElementById('branding-bg')
  const label = document.getElementById('branding-label')
  const heading = document.getElementById('branding-heading')
  const badges = document.querySelectorAll('#branding-badges .badge-img')
  const desc = document.getElementById('branding-desc')
  const colorsWrap = document.getElementById('branding-colors-wrap')

  const { gsap } = ensureGsap()

  if (prefersReducedMotion()) {
    gsap.fromTo([label, heading, desc].filter(Boolean), { opacity: 0 }, { opacity: 1, duration: 0.4, stagger: 0.06 })
    return
  }

  if (bg) gsap.fromTo(bg, { scale: 1 }, { scale: 1.06, duration: 10, ease: 'none' })
  if (label) gsap.fromTo(label, { opacity: 0, y: 10 }, { opacity: 1, y: 0, duration: 0.5, ease: ease.out })
  if (heading) gsap.fromTo(heading, { opacity: 0, y: 16 }, { opacity: 1, y: 0, duration: 1.0, ease: ease.out, delay: 0.15 })
  staggerGrid(badges, { variant: 'organic' })

  if (desc) {
    gsap.set(desc, { opacity: 0, y: 16 })
    gsap.to(desc, { opacity: 1, y: 0, duration: 1.0, ease: ease.out, scrollTrigger: { trigger: '#branding-detail', start: 'top 85%' } })
  }
  if (colorsWrap) revealClip(colorsWrap, { direction: 'up' })
})
</script>
