---
import { Image } from 'astro:assets'
import logo1 from '@/assets/results/1.png'
import logo2 from '@/assets/results/2.png'
import logo3 from '@/assets/results/3.png'
import logo4 from '@/assets/results/4.png'
import logo5 from '@/assets/results/5.png'
import logo6 from '@/assets/results/6.png'

const results = [
  { logo: logo1, name: 'Grupo Pracda', roas: '11,1 ROAS', description: 'Business developer with an attractive investment opportunity' },
  { logo: logo2, name: 'Nadira', roas: '26 ROAS', description: 'Beauty salon that excels in customer support in a highly competitive market' },
  { logo: logo3, name: 'Vive Paracas', roas: '20 ROAS', description: 'Real estate developer with an innovative project centered around a sustainable city' },
  { logo: logo4, name: 'Grin', roas: '76 ROAS', description: 'Eco-friendly e-scooter enterprise that penetrated a market with heavy car usage' },
  { logo: logo5, name: 'Helena Chocolatier', roas: '8 ROAS', description: 'Famous and established premium chocolate company with unique classic products' },
  { logo: logo6, name: 'AlumSpazio', roas: '161 ROAS', description: 'A high-ticket Outdoor Living Product Sales Company based in Barcelona' },
]
---

<section class="bg-gradient-to-b from-navy-600 to-primary py-16 lg:py-24">
  <div class="mx-auto max-w-[1512px] px-6 lg:px-16">
    <h2 class="mx-auto max-w-[720px] text-center font-heading text-3xl font-bold text-white sm:text-4xl">
      Check out how our project plans turned out from the workshops.
    </h2>

    <div class="mt-12 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-6 lg:gap-5">
      {
        results.map(result => (
          <div class="rounded-2xl bg-white p-5 text-center shadow-lg">
            <Image src={result.logo} alt={result.name} class="mx-auto h-14 w-14 rounded-xl object-contain" />
            <p class="mt-3 font-heading text-base font-bold text-dark">{result.roas}</p>
            <p class="mt-2 font-body text-[11px] leading-tight text-dark/60">{result.description}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
