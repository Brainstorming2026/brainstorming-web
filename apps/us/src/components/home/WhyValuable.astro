---
import { Image } from 'astro:assets'
import mindsetIcon from '@/assets/okrs/figure1.png'
import growthIcon from '@/assets/okrs/figure2.png'
import investmentBanner from '@/assets/okrs/figure3.png'
import downDecor from '@/assets/okrs/down.png'
---

<section id="why-oakrs" class="relative overflow-hidden bg-gradient-to-b from-white via-mist-100 to-mist-200 pt-16 pb-0">
  <div class="mx-auto max-w-[1512px] px-6 lg:px-16">
    <h2 class="max-w-[666px] font-heading text-3xl font-bold text-dark sm:text-[48px] sm:leading-[1.3]">
      Why is our <span class="text-primary">OAKRs</span> Workshop extremely valuable to your business?
    </h2>

    <div class="mt-8 flex justify-end pb-20 -mr-6 lg:-mr-16">
      <div class="w-full max-w-[900px] rounded-l-[120px] rounded-r-none bg-white/60 py-8 pr-6 pl-20 shadow-sm lg:pr-16">
        <div class="flex flex-col gap-6">
          <div class="flex items-center gap-6">
            <Image src={mindsetIcon} alt="" class="h-16 w-16 shrink-0" />
            <p class="font-body text-dark/80">
              We approach business problems with a fresh <strong class="font-bold">100% user-centric mindset</strong>.
            </p>
          </div>
          <div class="flex items-center gap-6">
            <Image src={growthIcon} alt="" class="h-16 w-16 shrink-0" />
            <p class="font-body text-dark/80">
              Our <strong class="font-bold text-primary">OAKRs</strong> Workshop has helped businesses like yours
              <strong class="font-bold">double and triple their revenue</strong>.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
