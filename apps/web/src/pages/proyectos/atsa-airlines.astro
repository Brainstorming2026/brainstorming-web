---
import ProjectStudy from '@/components/projects/study/ProjectStudy.astro'
import { projectStudies } from '@/data/project-studies'
import Layout from '@/layouts/Layout.astro'
import { caseStudyTitle } from '@/lib/seo-title'

export const prerender = true
---

<Layout title={caseStudyTitle('Atsa Airlines', projectStudies['atsa-airlines'].services.map(service => service.label))} description={projectStudies['atsa-airlines'].summary} footerCurveBg="bg-white">
  <ProjectStudy slug="atsa-airlines" />
</Layout>
