---
import { Image } from 'astro:assets'
import { growthStages } from '@/data/growth-planning'

const phases = [
  { label: 'Entender', title: 'El negocio, desde dentro.', range: '00–01', start: 0, end: 2, image: growthStages[1].image },
  { label: 'Investigar', title: 'Escuchar al cliente. Leer el mercado.', range: '02–03', start: 2, end: 4, image: growthStages[2].image },
  { label: 'Decidir', title: 'Elegir dónde generar impacto.', range: '04–05', start: 4, end: 6, image: growthStages[5].image },
  { label: 'Ejecutar', title: 'De la claridad a la acción.', range: '06', start: 6, end: 7, image: growthStages[6].image },
]
---

<section id="proceso-growth" class="inbound-method">
  <div class="method-container">
    <header class="method-intro">
      <div><p class="method-eyebrow">EL PROCESO / 7 ETAPAS</p><h2 data-process-title>Primero entender.<br /><span>Después, decidir.</span></h2></div>
      <p class="method-description">Siete etapas para mirar tu negocio desde dentro y desde fuera. Cada conversación y cada análisis alimentan una decisión.</p>
    </header>
    <nav class="method-index" aria-label="Fases de Growth Planning">
      {phases.map((phase, index) => <a href={`#growth-phase-${index}`}><span>0{index + 1}</span>{phase.label}<span class="phase-range">{phase.range}</span></a>)}
    </nav>
    <div data-growth-process class="method-chapters">
      {phases.map((phase, index) => (
        <section id={`growth-phase-${index}`} class="method-chapter" aria-labelledby={`growth-phase-title-${index}`}>
          <div class="chapter-visual">
            <div class="chapter-heading"><p class="method-eyebrow">FASE 0{index + 1} / {phase.label}</p><h3 id={`growth-phase-title-${index}`}>{phase.title}</h3></div>
            <div class="chapter-photo"><Image src={phase.image} alt={`Trabajo de consultoría estratégica: ${phase.label.toLowerCase()}`} widths={[480, 768, 1024, 1440]} sizes="(max-width: 767px) calc(100vw - 48px), 42vw" format="webp" quality={90} loading="lazy" /></div>
          </div>
          <ol class="chapter-steps" start={phase.start + 1} aria-label={`Etapas: ${phase.label}`}>
            {growthStages.slice(phase.start, phase.end).map(stage => (
              <li id={`growth-stage-${stage.number}`} data-stage-card={stage.number} class="method-step scroll-mt-28"><span class="step-number" aria-hidden="true">{stage.number}</span><div><h4>{stage.title}</h4><p>{stage.description}</p></div></li>
            ))}
          </ol>
        </section>
      ))}
    </div>
  </div>
</section>

<style>
  .inbound-method { background: #faf9f7; padding-block: clamp(64px, 7vw, 104px); }
  .method-container { max-width: 1512px; margin-inline: auto; padding-inline: 24px; }
  .method-intro { display: grid; grid-template-columns: 1.5fr 1fr; gap: 64px; align-items: end; }
  .method-eyebrow { font-size: 10px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: #6740b2; }
  .method-intro h2 { margin-top: 24px; font-family: var(--font-heading); font-size: clamp(34px, 4.5vw, 64px); font-weight: 700; line-height: 1.08; letter-spacing: -.035em; }
  .method-intro h2 span { color: var(--color-primary); }
  .method-description { max-width: 44ch; font-size: 17px; line-height: 1.8; color: var(--color-gray-body); }
  .method-index { display: grid; grid-template-columns: repeat(4, 1fr); margin-top: 48px; border-block: 1px solid #ded8e5; }
  .method-index a { display: flex; align-items: center; gap: 12px; min-height: 68px; padding: 12px 16px; font-size: 13px; font-weight: 600; transition: background-color .2s, color .2s; }
  .method-index a + a { border-left: 1px solid #ded8e5; }
  .method-index a > span:first-child { color: var(--color-primary); font-size: 11px; }
  .method-index .phase-range { margin-left: auto; color: #76717e; font-size: 10px; }
  .method-index a:hover { background: #efe8fa; color: #5628a3; }
  .method-index a:focus-visible { outline: 2px solid var(--color-primary); outline-offset: 3px; }
  .method-chapter { display: grid; grid-template-columns: 1fr 1.1fr; column-gap: clamp(40px, 6vw, 88px); row-gap: 28px; padding-block: 64px; border-bottom: 1px solid #ded8e5; scroll-margin-top: 110px; }
  .chapter-visual { display: contents; }
  .chapter-heading { grid-column: 1; }
  .chapter-heading h3 { max-width: 18ch; margin-top: 16px; font-family: var(--font-heading); font-size: clamp(28px, 3vw, 42px); line-height: 1.12; letter-spacing: -.035em; font-weight: 700; }
  .chapter-photo { grid-column: 1; grid-row: 2; align-self: start; overflow: hidden; border-radius: 8px; background: #e8e4df; }
  .chapter-photo img { display: block; width: 100%; height: auto; }
  .chapter-steps { grid-column: 2; grid-row: 2; align-self: start; }
  .method-step { display: grid; grid-template-columns: 32px 1fr; gap: 20px; padding-block: 26px; border-top: 1px solid #ded8e5; }
  .method-step:first-child { border-top: none; padding-top: 0; }
  .step-number { padding-top: 4px; color: var(--color-primary); font-size: 12px; font-variant-numeric: tabular-nums; }
  .method-step h4 { font-family: var(--font-heading); font-weight: 700; font-size: 22px; letter-spacing: -.025em; line-height: 1.25; }
  .method-step p { margin-top: 12px; font-size: 16px; line-height: 1.75; color: var(--color-gray-body); }
  @media (min-width: 1024px) { .method-container { padding-inline: 96px; } }
  @media (max-width: 767px) {
    .method-intro, .method-chapter { grid-template-columns: 1fr; gap: 28px; }
    .method-index { grid-template-columns: repeat(2, 1fr); margin-top: 32px; }
    .method-index a:nth-child(3) { border-left: 0; }
    .method-index a:nth-child(n+3) { border-top: 1px solid #ded8e5; }
    .method-index a { padding-inline: 10px; font-size: 12px; }
    .method-chapter { padding-block: 40px; }
    .chapter-visual { display: block; }
    .chapter-photo { margin-top: 28px; max-width: 520px; }
    .chapter-steps { grid-column: auto; grid-row: auto; }
    .method-step h4 { font-size: 20px; }
  }
  @media (prefers-reduced-motion: reduce) { .method-index a { transition: none; } }
</style>

<script>
import { ensureGsap, prefersReducedMotion, registerMotion, splitHeadline, staggerGrid } from '@/lib/motion'

registerMotion(() => {
  const section = document.getElementById('proceso-growth')
  const title = section?.querySelector<HTMLElement>('[data-process-title]')
  if (title)
    splitHeadline(title, { by: 'lines' })
  if (!section)
    return
  section.querySelectorAll<HTMLElement>('.chapter-steps').forEach((chapter) => {
    staggerGrid(chapter.querySelectorAll<HTMLElement>('.method-step'), { variant: 'organic', itemStagger: 0.08, itemDuration: 0.7 })
  })
  if (!prefersReducedMotion()) {
    const { gsap } = ensureGsap()
    section.querySelectorAll<HTMLElement>('.chapter-photo').forEach((photo) => {
      gsap.from(photo, {
        autoAlpha: 0,
        y: 24,
        duration: 1,
        ease: 'power3.out',
        clearProps: 'opacity,visibility,transform',
        scrollTrigger: { trigger: photo, start: 'top 90%', once: true },
      })
    })
  }
})
</script>
