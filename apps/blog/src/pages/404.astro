---
import { Picture } from 'astro:assets'
import illustration from '@/assets/404/brainstorming-404-crop.png'
import Layout from '@/layouts/Layout.astro'
import { siteUrl } from '@/lib/site-urls'

export const prerender = true

const linkClass = 'rounded-sm font-semibold text-primary-600 underline decoration-primary/30 underline-offset-4 transition-colors hover:text-navy hover:decoration-navy/40 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary motion-reduce:transition-none'
---

<Layout noindex title="Página no encontrada — Brainstorming Blog">
  <section class="flex flex-col items-center bg-white px-6 pt-16 pb-24 text-center sm:px-8 lg:pt-20 lg:pb-28" data-notfound>
    <p class="font-body text-xs font-bold tracking-[0.14em] text-primary-600 uppercase" data-notfound-fade>Error 404</p>
    <h1 id="notfound-heading" class="mt-4 max-w-[760px] font-heading text-[length:clamp(28px,3.4vw,44px)] leading-[1.15] font-bold tracking-[-0.03em] text-balance text-navy">
      No pudimos encontrar la página que buscas.
    </h1>
    <!-- Lossless PNG cropped to the drawing (1486px wide); capped at 720px so 2x screens never upscale it. -->
    <div class="mt-10 w-full max-w-[720px] lg:mt-12" data-notfound-art>
      <Picture src={illustration} alt="" formats={['avif', 'webp']} quality={90} widths={[480, 720, 1080, 1440]} sizes="(min-width: 768px) 720px, calc(100vw - 48px)" loading="eager" class="h-auto w-full" />
    </div>
    <p class="mt-10 font-body text-base leading-relaxed text-dark/75 lg:mt-12 lg:text-lg" data-notfound-fade>
      Vuelve al <a href="/" class={linkClass}>inicio del blog</a> o <a href={siteUrl('web', '/contacto')} class={linkClass}>contáctanos</a>.
    </p>
  </section>
</Layout>

<script>
import { ensureGsap, registerMotion, splitHeadline } from '@/lib/motion'
import { prefersReducedMotion } from '@/lib/motion/reduced-motion'

registerMotion(() => {
  const page = document.querySelector<HTMLElement>('[data-notfound]')
  if (!page || prefersReducedMotion())
    return

  const { gsap } = ensureGsap()
  const heading = document.getElementById('notfound-heading')
  const art = page.querySelector('[data-notfound-art]')
  const fades = page.querySelectorAll('[data-notfound-fade]')
  // Hidden at load, revealed once the splash is gone so nothing plays behind it.
  gsap.set(fades, { opacity: 0, y: 12 })
  if (art)
    gsap.set(art, { opacity: 0, y: 28, scale: 0.97 })

  let started = false
  const start = () => {
    if (started)
      return
    started = true
    if (heading)
      splitHeadline(heading, { by: 'words', scrollTrigger: false })
    if (art)
      gsap.to(art, { opacity: 1, y: 0, scale: 1, duration: 1.1, delay: 0.25, ease: 'expo.out' })
    gsap.to(fades, { opacity: 1, y: 0, duration: 0.7, stagger: 0.5, delay: 0.1, ease: 'power2.out' })
  }
  const splash = document.getElementById('splash-screen')
  if (!splash || getComputedStyle(splash).display === 'none')
    start()
  else
    document.addEventListener('bs:splash-dismissed', start, { once: true })
})
</script>
