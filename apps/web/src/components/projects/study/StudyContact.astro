---
import { Icon } from 'astro-icon/components'
---

<section class="study-contact study-container" aria-labelledby="study-contact-title">
  <div class="study-contact-panel">
    <div class="study-contact-heading">
      <p class="study-contact-label" data-study-reveal>
        <Icon name="study/message-square" aria-hidden="true" />
        Hagamos equipo
      </p>
      <h2 id="study-contact-title" data-study-heading>Ahora, hablemos<br /><span>de tu marca.</span></h2>
    </div>
    <div class="study-contact-action">
      <p class="study-contact-copy" data-study-reveal>
        Cada proyecto empieza con una conversación.
        Cuéntanos qué quieres lograr y exploremos cómo llevar tu marca al siguiente paso.
      </p>
      <a href="/contacto" class="study-contact-link">
        <span>Conversemos</span>
        <span class="study-contact-arrow" aria-hidden="true"><Icon name="study/arrow-up-right" /></span>
      </a>
    </div>
  </div>
</section>

<style>
  .study-contact {
    padding-block: 72px;
  }

  .study-contact-panel {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.85fr);
    align-items: center;
    gap: clamp(32px, 5vw, 80px);
    padding: clamp(32px, 4.5vw, 64px);
    border: 1px solid var(--color-primary-100);
    border-radius: 20px;
    background: var(--color-primary-50);
    color: var(--color-dark);
  }

  .study-contact-label {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 24px;
    font-size: 13px;
    font-weight: 600;
    color: var(--color-primary-700);
  }

  .study-contact-label svg {
    width: 24px;
    height: 24px;
    flex-shrink: 0;
    stroke-width: 1.6;
  }

  .study-contact h2 {
    font-size: clamp(36px, 4vw, 58px);
    font-weight: 700;
    letter-spacing: -0.045em;
    line-height: 1.1;
    text-wrap: balance;
  }

  .study-contact h2 span {
    color: var(--color-primary-600);
  }

  .study-contact-copy {
    max-width: 38ch;
    color: var(--color-gray-body);
    font-size: 17px;
    line-height: 1.75;
  }

  .study-contact-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 64px;
    gap: 24px;
    margin-top: 24px;
    padding-block: 12px;
    border-bottom: 1px solid var(--color-primary-300);
    color: var(--color-primary-700);
    font-family: var(--font-heading);
    font-size: 20px;
    font-weight: 700;
  }

  .study-contact-arrow {
    display: grid;
    width: 48px;
    height: 48px;
    flex-shrink: 0;
    place-items: center;
    border-radius: 50%;
    color: white;
    background: var(--color-primary-600);
    transition: transform 180ms cubic-bezier(0.23, 1, 0.32, 1), background-color 180ms ease;
  }

  .study-contact-arrow svg {
    width: 24px;
    height: 24px;
    stroke-width: 1.8;
    transition: transform 180ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  .study-contact-link:active .study-contact-arrow {
    transform: scale(0.95);
  }

  @media (hover: hover) and (pointer: fine) {
    .study-contact-link:hover .study-contact-arrow {
      background: var(--color-primary-700);
    }

    .study-contact-link:hover .study-contact-arrow svg {
      transform: translate(2px, -2px);
    }
  }

  @media (max-width: 900px) {
    .study-contact-panel {
      grid-template-columns: 1fr;
      gap: 28px;
    }

    .study-contact-action {
      max-width: 520px;
    }

    .study-contact-copy {
      max-width: 48ch;
    }
  }

  @media (max-width: 767px) {
    .study-contact { padding-block: 48px; }
    .study-contact-panel { padding: 28px 24px; border-radius: 16px; }
    .study-contact-label { margin-bottom: 20px; }
    .study-contact h2 { font-size: clamp(30px, 8vw, 44px); text-wrap: pretty; }
    .study-contact-copy { font-size: 16px; line-height: 1.65; }
    .study-contact-link { margin-top: 20px; font-size: 18px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .study-contact-arrow,
    .study-contact-arrow svg { transition: none; transform: none !important; }
  }
</style>
