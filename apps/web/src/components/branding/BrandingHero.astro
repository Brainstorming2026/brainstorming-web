---
import { Icon } from 'astro-icon/components'
import { Image } from 'astro:assets'
import systemImage from '@/assets/branding/brainstorming-sistema.png'
import { contact } from '@/data/branding-content'
---

<section class="br-hero service-container" aria-labelledby="br-title">
      <div class="br-label br-hero-label"><span></span> BRANDING / IDENTIDAD DE MARCA</div>
      <div class="br-hero-heading"><h1 id="br-title">Una marca sin identidad clara <span class="br-accent">no tiene alma.</span></h1><div><p>Y se confunde<br />con la competencia.</p><a href={contact} class="br-button" target="_blank" rel="noopener noreferrer">Conversemos sobre tu marca<Icon name="automation/arrow-right" class="br-icon" /></a></div></div>
      <figure class="br-hero-image"><Image src={systemImage} alt="Visualización del sistema de identidad Brainstorming aplicado a manual, tarjetas y papelería" widths={[640, 960, 1280, 1536]} sizes="(max-width: 767px) 100vw, 90vw" loading="eager" fetchpriority="high" /><figcaption><span>UNA IDENTIDAD. EN CADA DETALLE.</span><span>Visualización de aplicaciones de marca.</span></figcaption></figure>
    </section>

<script>
  import '@/scripts/branding/page-motion'
</script>
