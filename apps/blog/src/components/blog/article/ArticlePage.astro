---
import type { Article } from '@/data/articles'
import ArticleBody from '@/components/blog/article/ArticleBody.astro'
import ArticleHero from '@/components/blog/article/ArticleHero.astro'
import ArticleLead from '@/components/blog/article/ArticleLead.astro'
import ArticleLeadMagnet from '@/components/blog/article/ArticleLeadMagnet.astro'
import ArticleProgress from '@/components/blog/article/ArticleProgress.astro'
import ArticleRelated from '@/components/blog/article/ArticleRelated.astro'
import ArticleSecondaryCta from '@/components/blog/article/ArticleSecondaryCta.astro'
import ArticleShare from '@/components/blog/article/ArticleShare.astro'
import ArticleSolutionBand from '@/components/blog/article/ArticleSolutionBand.astro'
import ArticleSummary from '@/components/blog/article/ArticleSummary.astro'
import ArticleToc from '@/components/blog/article/ArticleToc.astro'
import { ORGANIZATION_ID } from '@/data/organization'
import Layout from '@/layouts/Layout.astro'
import { outlineOf, sectionIds } from '@/lib/article-outline'
import { allPosts, categories } from '@/lib/content'
import { excerpt, publicationDate } from '@/lib/editorial-seo'
import { imageUrl } from '@/lib/image-source'
import { siteUrl } from '@/lib/site-urls'

interface Props {
  article: Article
  /** Vista previa de un borrador: no se indexa. */
  noindex?: boolean
}

const { article, noindex = false } = Astro.props
const canonical = new URL(`/${article.slug}`, Astro.site).href
const description = excerpt(article.intro.join(' '))
const publishedTime = publicationDate(article.publishedDate)
const modifiedTime = article.modifiedDate ? publicationDate(article.modifiedDate) : undefined
const category = categories.find(category => category.label === article.category)
const structuredData: Record<string, unknown>[] = [
  {
    '@type': 'BlogPosting',
'@id': `${canonical}#article`,
// Google truncates headlines over 110 characters.
    'headline': article.title.length <= 110 ? article.title : (article.seoTitle ?? article.title).replace(/ \| Brainstorming.*$/, ''),
    description,
'image': article.heroImage ? new URL(imageUrl(article.heroImage), Astro.site).href : undefined,
    'datePublished': publishedTime,
'dateModified': modifiedTime,
'inLanguage': 'es',
'articleSection': article.category,
    'author': article.author ? { '@type': 'Person', 'name': article.author.name, 'url': article.author.url } : { '@id': 'https://www.brainstorming.la/#organization' },
    'publisher': { '@id': ORGANIZATION_ID },
    'mainEntityOfPage': { '@id': `${canonical}#webpage` },
    'isPartOf': { '@id': `${Astro.site!.href}#blog` },
  },
  {
    '@type': 'BreadcrumbList',
'itemListElement': [
      { '@type': 'ListItem', 'position': 1, 'name': 'Blog', 'item': Astro.site!.href },
      ...(category ? [{ '@type': 'ListItem', 'position': 2, 'name': category.label, 'item': new URL(`/${category.slug}`, Astro.site).href }] : []),
      { '@type': 'ListItem', 'position': category ? 3 : 2, 'name': article.title, 'item': canonical },
    ],
  },
]
const solutionPaths: Record<string, { href: string, label: string }> = {
  'Inbound Marketing': { href: '/soluciones/inbound-marketing', label: 'Inbound Marketing' },
  'Desarrollo Web': { href: '/soluciones/inbound-marketing#desarrollo-web', label: 'Desarrollo web e Inbound Marketing' },
  'Branding': { href: '/soluciones/branding', label: 'Branding' },
  'Procesos': { href: '/soluciones/automatizacion-ia', label: 'Automatización de procesos con IA' },
}
const solution = solutionPaths[article.category]
const ids = sectionIds(article.sections)
const outline = outlineOf(article.sections)
const relatedPosts = allPosts
  .filter(post => post.category === article.category && post.slug !== article.slug)
  .slice(0, 3)
---
<Layout title={article.seoTitle ?? `${article.title} — Brainstorming Blog`} {description} image={article.heroImage ? imageUrl(article.heroImage) : undefined} imageAlt={article.title} type="article" {publishedTime} {modifiedTime} {structuredData} {noindex}>
  <slot name="banner" />
  <div data-accent={article.accent}>
    <ArticleProgress />
    <ArticleHero article={article} />
    <ArticleToc items={outline} />
    <ArticleLead paragraphs={article.intro} />
    <ArticleBody sections={article.sections} {ids} />
    {article.summaryTitle && <ArticleSummary article={article} />}
    {article.leadMagnet && <ArticleLeadMagnet leadMagnet={article.leadMagnet} />}
    {article.secondaryCta && <ArticleSecondaryCta cta={article.secondaryCta} />}
    {solution && <ArticleSolutionBand label={solution.label} href={siteUrl('web', solution.href)} />}
    <ArticleShare article={article} />
    <ArticleRelated posts={relatedPosts} />
  </div>
</Layout>
