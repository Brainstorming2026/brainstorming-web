---
import { Image } from 'astro:assets'
import desktopBg from '@/assets/hero/bg-us-hd.png'
import mobileBg from '@/assets/hero/bg-us-mobile.png'
import down from '@/assets/hero/down.png'
import Navbar from '@/components/common/Navbar.astro'
import { getLang, useTranslations } from '@/i18n/utils'

const lang = getLang(Astro.url)
const t = useTranslations(lang, 'hero')
---

<section class="relative min-h-[100svh] overflow-hidden bg-white sm:min-h-[600px] lg:min-h-[721px]">
  <Image
    src={mobileBg}
    alt=""
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 h-full w-full object-cover object-bottom lg:hidden"
    loading="eager"
    widths={[390, 780, 1170]}
    sizes="(min-width: 1024px) 0px, 100vw"
    data-hero-bg
  />
  <Image
    src={desktopBg}
    alt=""
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 hidden h-full w-full object-cover object-bottom lg:block"
    loading="eager"
    widths={[1024, 1512, 3024]}
    sizes="(min-width: 1024px) 100vw, 0px"
    data-hero-bg
  />

  <div class="relative z-10">
    <Navbar />

    <div class="max-w-7xl px-5 pt-8 sm:px-8 sm:pt-12 lg:px-16 lg:pt-4">
      <h1 id="hero-headline" class="max-w-[360px] font-heading text-4xl leading-[1.15] font-bold text-white sm:max-w-3xl sm:text-5xl lg:text-[56px]">
        {t.headline} <span class="text-gold">{t.headlineAccent}</span>
      </h1>
      <p id="hero-text" class="mt-6 max-w-[330px] font-body text-base leading-relaxed text-white/90 sm:max-w-2xl">
        {t.text}
      </p>

      <button
        type="button"
        aria-label="Scroll to learn more"
        class="mt-30 hidden animate-bounce lg:inline-flex"
        onclick="document.getElementById('why-oakrs')?.scrollIntoView({ behavior: 'smooth' })"
      >
        <Image src={down} alt="" class="h-auto w-70" />
      </button>
    </div>
  </div>

  <svg
    class="pointer-events-none absolute inset-x-0 bottom-0 z-[1] w-full"
    viewBox="0 0 1512 120"
    preserveAspectRatio="none"
    aria-hidden="true"
  >
    <path d="M0,120 H1512 V44 C1134,104 378,104 0,44 Z" fill="#fff"></path>
  </svg>
</section>

<script>
import { ensureGsap, registerMotion, splitHeadline } from '@/lib/motion'
import { prefersReducedMotion } from '@/lib/motion/reduced-motion'

registerMotion(() => {
  const backgrounds = document.querySelectorAll('[data-hero-bg]')
  const headline = document.getElementById('hero-headline')
  const text = document.getElementById('hero-text')
  const { gsap } = ensureGsap()

  if (text && !prefersReducedMotion()) gsap.set(text, { opacity: 0, y: 10 })

  if (headline) {
    // 'lines' preserva el <span class="text-gold"> intacto dentro del split.
    splitHeadline(headline, { by: 'lines', scrollTrigger: false, onComplete: () => {
      if (text) gsap.to(text, { opacity: 1, y: 0, duration: 0.5 })
    } })
  }
  if (backgrounds.length > 0 && !prefersReducedMotion())
    gsap.fromTo(backgrounds, { scale: 1 }, { scale: 1.06, duration: 9, ease: 'none' })
})
</script>
